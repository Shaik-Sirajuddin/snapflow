import { Theme } from "../../tokens/theme.slint";
import { Icon } from "../../base/icon.slint";
import { Button } from "../../base/buttons/button.slint";
import { ThinScrollbar } from "../../base/layout/thin_scrollbar.slint";
import { Text } from "../../base/text/base_text.slint";
import { OnboardingPreviewCard, OnboardingPill, OnboardingSectionHeader } from "./onboarding_components.slint";

export component OnboardingGuideView inherits Rectangle {
    callback start-chat-clicked();
    property <bool> narrow: root.width < 420px;
    background: Theme.bg-chat;
    clip: true;

    VerticalLayout {
        width: 100%;
        height: 100%;

        // --- Top Header ---
        Rectangle {
            height: 56px;
            background: Theme.bg-sidebar;
            border-color: Theme.border-default;
            border-width: 1px;

            HorizontalLayout {
                padding-left: root.narrow ? 12px : 20px;
                padding-right: root.narrow ? 12px : 20px;
                alignment: space-between;
                cross-axis-alignment: center;

                HorizontalLayout {
                    spacing: 10px;
                    horizontal-stretch: 1;
                    min-width: 0px;
                    cross-axis-alignment: center;

                    Icon {
                        source: @image-url("../../assets/icons/sparkles.svg");
                        width: 20px;
                        height: 20px;
                        colorize: Theme.md-link;
                    }

                    Text {
                        text: "Welcome to SnapFlow";
                        size: "lg";
                        weight: "semibold";
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        min-width: 0px;
                        overflow: elide;
                    }
                }

                if !root.narrow : Rectangle {
                    background: Theme.bg-card;
                    border-radius: 12px;
                    border-color: Theme.border-default;
                    border-width: 1px;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;

                        Text {
                            text: "Getting Started Guide";
                            size: "sm";
                            weight: "medium";
                            color: Theme.md-link;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // --- Scrollable Body ---
            Rectangle {
                vertical-stretch: 1;

                flick := Flickable {
                    width: 100%;
                    height: 100%;
                    viewport-height: content-column.preferred-height + 40px;

                    content-column := VerticalLayout {
                        width: parent.width;
                        preferred-width: 0px;
                    padding-top: 24px;
                    padding-bottom: 24px;
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 24px;
                    alignment: start;

                    // Title banner
                    VerticalLayout {
                        width: parent.width;
                        preferred-width: 0px;
                        spacing: 6px;
                        Text {
                            text: "Welcome aboard! Let's get you set up.";
                            size: "xl";
                            weight: "bold";
                        }
                        Text {
                            text: "Explore key features and configuration workflows to start pair programming with your AI agents.";
                            color: Theme.text-secondary;
                        }
                    }

                    // Section 1: Choose Your Agent
                    Rectangle {
                        width: parent.width;
                        preferred-width: 0px;
                        background: Theme.bg-sidebar;
                        border-color: Theme.border-default;
                        border-width: 1px;
                        border-radius: Theme.radius-lg;

                        VerticalLayout {
                            width: parent.width;
                            preferred-width: 0px;
                            padding: 18px;
                            spacing: 14px;

                            OnboardingSectionHeader {
                                icon-source: @image-url("../../assets/icons/sparkles.svg");
                                title: "1. Choose Your Agent";
                            }

                            Text {
                                text: "Select from built-in AI agents like **Codex**, **Claude Sonnet**, or **Custom ACP Agents**. Each agent delivers specialized capabilities for codebase exploration, refactoring, and multi-file generation.";
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                                preferred-width: 0px;
                                min-width: 0px;
                            }

                            // Image insertion placeholder / visual card
                            OnboardingPreviewCard {
                                title: "Agent Options & Catalog";

                                    HorizontalLayout {
                                        spacing: 10px;

                                        Rectangle {
                                            horizontal-stretch: 1;
                                            preferred-width: 0px;
                                            min-width: 0px;
                                            background: Theme.bg-sidebar;
                                            border-color: Theme.md-link;
                                            border-width: 1px;
                                            border-radius: Theme.radius-sm;

                                            VerticalLayout {
                                                width: parent.width;
                                                preferred-width: 0px;
                                                min-width: 0px;
                                                padding: 10px;
                                                spacing: 4px;
                                                Text {
                                                    text: "Codex Agent";
                                                    weight: "semibold";
                                                    color: Theme.md-link;
                                                }
                                                Text {
                                                    text: "Autonomous CLI & Code Base Expert";
                                                    size: "sm";
                                                    color: Theme.text-secondary;
                                                    wrap: word-wrap;
                                                    preferred-width: 0px;
                                                    min-width: 0px;
                                                }
                                            }
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;
                                            preferred-width: 0px;
                                            min-width: 0px;
                                            background: Theme.bg-sidebar;
                                            border-color: Theme.border-default;
                                            border-width: 1px;
                                            border-radius: Theme.radius-sm;

                                            VerticalLayout {
                                                width: parent.width;
                                                preferred-width: 0px;
                                                min-width: 0px;
                                                padding: 10px;
                                                spacing: 4px;
                                                Text {
                                                    text: "Claude 3.5 Sonnet";
                                                    weight: "semibold";
                                                    color: Theme.text-primary;
                                                }
                                                Text {
                                                    text: "Architectural & Context Analysis";
                                                    size: "sm";
                                                    color: Theme.text-secondary;
                                                    wrap: word-wrap;
                                                    preferred-width: 0px;
                                                    min-width: 0px;
                                                }
                                            }
                                        }
                                    }
                            }
                        }
                    }

                    // Section 2: Live Connected Project
                    Rectangle {
                        width: parent.width;
                        preferred-width: 0px;
                        background: Theme.bg-sidebar;
                        border-color: Theme.border-default;
                        border-width: 1px;
                        border-radius: Theme.radius-lg;

                        VerticalLayout {
                            width: parent.width;
                            preferred-width: 0px;
                            min-width: 0px;
                            padding: 18px;
                            spacing: 14px;

                            OnboardingSectionHeader {
                                icon-source: @image-url("../../assets/icons/plug-zap.svg");
                                title: "2. Live Connected Project";
                            }

                            Text {
                                text: "SnapFlow automatically bridges your active workspace repository via `snapshotd`. Monitor live context, file modifications, and isolated execution threads per workspace root.";
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                                preferred-width: 0px;
                                min-width: 0px;
                            }

                            // Image insertion placeholder / visual card
                            Rectangle {
                                width: parent.width;
                                preferred-width: 0px;
                                background: Theme.bg-chat;
                                border-color: Theme.border-default;
                                border-width: 1px;
                                border-radius: Theme.radius-md;

                                VerticalLayout {
                                    width: parent.width;
                                    preferred-width: 0px;
                                    min-width: 0px;
                                    padding: 14px;
                                    spacing: 10px;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: "Workspace Connection Status";
                                            weight: "semibold";
                                            color: Theme.text-primary;
                                        }
                                        Text {
                                            text: "[ Image Gap / Preview ]";
                                            font-family: Theme.font-mono;
                                            size: "sm";
                                            color: Theme.md-link;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;

                                        Rectangle {
                                            width: 8px;
                                            height: 8px;
                                            border-radius: 4px;
                                            background: #22C55E;
                                        }

                                        Text {
                                            text: "snapshotd • Live connected workspace root (/multi_media_main)";
                                            font-family: Theme.font-mono;
                                            size: "sm";
                                            color: Theme.text-primary;
                                            horizontal-stretch: 1;
                                            preferred-width: 0px;
                                            min-width: 0px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Section 3: Add MCP Servers from Settings
                    Rectangle {
                        width: parent.width;
                        preferred-width: 0px;
                        background: Theme.bg-sidebar;
                        border-color: Theme.border-default;
                        border-width: 1px;
                        border-radius: Theme.radius-lg;

                        VerticalLayout {
                            width: parent.width;
                            preferred-width: 0px;
                            min-width: 0px;
                            padding: 18px;
                            spacing: 14px;

                            OnboardingSectionHeader {
                                icon-source: @image-url("../../assets/icons/server.svg");
                                title: "3. Add MCP Servers from Settings";
                            }

                            Text {
                                text: "Expand your agent's powers with Model Context Protocol (MCP) servers. Open **Settings > MCP Servers** to enable tools, database connectors, external APIs, and custom integrations.";
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                                preferred-width: 0px;
                                min-width: 0px;
                            }

                            // Image insertion placeholder / visual card
                            Rectangle {
                                width: parent.width;
                                preferred-width: 0px;
                                background: Theme.bg-chat;
                                border-color: Theme.border-default;
                                border-width: 1px;
                                border-radius: Theme.radius-md;

                                VerticalLayout {
                                    width: parent.width;
                                    preferred-width: 0px;
                                    min-width: 0px;
                                    padding: 14px;
                                    spacing: 10px;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: "MCP Server Integration Pane";
                                            weight: "semibold";
                                            color: Theme.text-primary;
                                        }
                                        Text {
                                            text: "[ Image Gap / Preview ]";
                                            font-family: Theme.font-mono;
                                            size: "sm";
                                            color: Theme.md-link;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 10px;

                                        Rectangle {
                                            horizontal-stretch: 1;
                                            preferred-width: 0px;
                                            min-width: 0px;
                                            background: Theme.bg-sidebar;
                                            border-color: Theme.border-default;
                                            border-width: 1px;
                                            border-radius: Theme.radius-sm;

                                            HorizontalLayout {
                                                padding: 8px;
                                                alignment: space-between;

                                                Text {
                                                    text: "axolink (Task Queue)";
                                                    font-family: Theme.font-mono;
                                                    size: "sm";
                                                    color: Theme.text-primary;
                                                }
                                                Text {
                                                    text: "Active";
                                                    size: "sm";
                                                    color: #22C55E;
                                                }
                                            }
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;
                                            preferred-width: 0px;
                                            min-width: 0px;
                                            background: Theme.bg-sidebar;
                                            border-color: Theme.border-default;
                                            border-width: 1px;
                                            border-radius: Theme.radius-sm;

                                            HorizontalLayout {
                                                padding: 8px;
                                                alignment: space-between;

                                                Text {
                                                    text: "github (API Connector)";
                                                    font-family: Theme.font-mono;
                                                    size: "sm";
                                                    color: Theme.text-primary;
                                                }
                                                Text {
                                                    text: "Configured";
                                                    size: "sm";
                                                    color: Theme.md-link;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Section 4: Create Skills
                    Rectangle {
                        width: parent.width;
                        preferred-width: 0px;
                        background: Theme.bg-sidebar;
                        border-color: Theme.border-default;
                        border-width: 1px;
                        border-radius: Theme.radius-lg;

                        VerticalLayout {
                            width: parent.width;
                            preferred-width: 0px;
                            min-width: 0px;
                            padding: 18px;
                            spacing: 14px;

                            OnboardingSectionHeader {
                                icon-source: @image-url("../../assets/icons/wrench.svg");
                                title: "4. Create & Customize Skills";
                            }

                            Text {
                                text: "Teach your agents repeatable workflows. Create custom skills with structured prompt directives, audit recipes, and helper scripts under **Settings > Skills**.";
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                                preferred-width: 0px;
                                min-width: 0px;
                            }

                            // Image insertion placeholder / visual card
                            Rectangle {
                                width: parent.width;
                                preferred-width: 0px;
                                background: Theme.bg-chat;
                                border-color: Theme.border-default;
                                border-width: 1px;
                                border-radius: Theme.radius-md;

                                VerticalLayout {
                                    width: parent.width;
                                    preferred-width: 0px;
                                    min-width: 0px;
                                    padding: 14px;
                                    spacing: 10px;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: "Skills Library";
                                            weight: "semibold";
                                            color: Theme.text-primary;
                                        }
                                        Text {
                                            text: "[ Image Gap / Preview ]";
                                            font-family: Theme.font-mono;
                                            size: "sm";
                                            color: Theme.md-link;
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 8px;
                                        alignment: start;

                                        OnboardingPill { label: "rust-audit"; }
                                        OnboardingPill { label: "slint-reference"; }
                                        OnboardingPill { label: "phase-plan"; }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            ThinScrollbar {
                x: parent.width - self.width;
                y: 0px;
                viewport-height: flick.viewport-height;
                visible-height: flick.height;
                viewport-y: flick.viewport-y;
            }
        }

        // --- Bottom Action Bar ---
        Rectangle {
            height: 64px;
            background: Theme.bg-sidebar;
            border-color: Theme.border-default;
            border-width: 1px;

            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    padding-left: root.narrow ? 12px : 24px;
                    padding-right: root.narrow ? 12px : 24px;
                    Text {
                        text: "Ready to start pair programming?";
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                        min-width: 0px;
                        wrap: word-wrap;
                    }
                }

                Button {
                    label: "Start Chat >";
                    button-accessible-label: "Start Chat";
                    btn-width: 150px;
                    btn-height: 40px;
                    primary: true;
                    bg: Theme.bg-primary;
                    fg: Theme.text-on-primary;
                    border-w: 0px;
                    clicked => {
                        root.start-chat-clicked();
                    }
                }
            }
        }
    }
}
