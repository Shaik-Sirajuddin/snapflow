import { Theme } from "../../tokens/theme.slint";
import { Icon } from "../../base/icon.slint";
import { ThinScrollbar } from "../../base/thin_scrollbar.slint";

export component OnboardingGuideView inherits Rectangle {
    callback start-chat-clicked();
    background: Theme.bg-chat;
    clip: true;

    VerticalLayout {
        width: 100%;
        height: 100%;

        // --- Top Header ---
        Rectangle {
            height: 56px;
            background: Theme.bg-sidebar;
            border-color: Theme.border-default;
            border-width: 1px;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 10px;

                    Icon {
                        source: @image-url("../../assets/icons/sparkles.svg");
                        width: 20px;
                        height: 20px;
                        colorize: Theme.md-link;
                    }

                    Text {
                        text: "Welcome to SnapFlow";
                        font-family: Theme.font-sans;
                        font-size: 16px;
                        font-weight: 600;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    background: Theme.bg-card;
                    border-radius: 12px;
                    border-color: Theme.border-default;
                    border-width: 1px;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;

                        Text {
                            text: "Getting Started Guide";
                            font-family: Theme.font-sans;
                            font-size: 11px;
                            font-weight: 500;
                            color: Theme.md-link;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // --- Scrollable Body ---
        Rectangle {
            vertical-stretch: 1;

            flick := Flickable {
                width: 100%;
                height: 100%;
                viewport-height: content-column.preferred-height + 40px;

                content-column := VerticalLayout {
                    width: parent.width;
                    padding-top: 24px;
                    padding-bottom: 24px;
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 24px;
                    alignment: start;

                    // Title banner
                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "Welcome aboard! Let's get you set up.";
                            font-family: Theme.font-sans;
                            font-size: 22px;
                            font-weight: 700;
                            color: Theme.text-primary;
                        }
                        Text {
                            text: "Explore key features and configuration workflows to start pair programming with your AI agents.";
                            font-family: Theme.font-sans;
                            font-size: 13px;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }
                    }

                    // Section 1: Choose Your Agent
                    Rectangle {
                        background: Theme.bg-sidebar;
                        border-color: Theme.border-default;
                        border-width: 1px;
                        border-radius: Theme.radius-lg;

                        VerticalLayout {
                            padding: 18px;
                            spacing: 14px;

                            HorizontalLayout {
                                spacing: 10px;
                                Icon {
                                    source: @image-url("../../assets/icons/sparkles.svg");
                                    width: 18px;
                                    height: 18px;
                                    colorize: Theme.md-link;
                                }
                                Text {
                                    text: "1. Choose Your Agent";
                                    font-family: Theme.font-sans;
                                    font-size: 15px;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                }
                            }

                            Text {
                                text: "Select from built-in AI agents like **Codex**, **Claude Sonnet**, or **Custom ACP Agents**. Each agent delivers specialized capabilities for codebase exploration, refactoring, and multi-file generation.";
                                font-family: Theme.font-sans;
                                font-size: 13px;
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                            }

                            // Image insertion placeholder / visual card
                            Rectangle {
                                background: Theme.bg-chat;
                                border-color: Theme.border-default;
                                border-width: 1px;
                                border-radius: Theme.radius-md;

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 10px;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: "Agent Options & Catalog";
                                            font-family: Theme.font-sans;
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: Theme.text-primary;
                                        }
                                        Text {
                                            text: "[ Image Gap / Preview ]";
                                            font-family: Theme.font-mono;
                                            font-size: 10px;
                                            color: Theme.md-link;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 10px;

                                        Rectangle {
                                            horizontal-stretch: 1;
                                            background: Theme.bg-sidebar;
                                            border-color: Theme.md-link;
                                            border-width: 1px;
                                            border-radius: Theme.radius-sm;

                                            VerticalLayout {
                                                padding: 10px;
                                                spacing: 4px;
                                                Text {
                                                    text: "Codex Agent";
                                                    font-family: Theme.font-sans;
                                                    font-size: 12px;
                                                    font-weight: 600;
                                                    color: Theme.md-link;
                                                }
                                                Text {
                                                    text: "Autonomous CLI & Code Base Expert";
                                                    font-family: Theme.font-sans;
                                                    font-size: 11px;
                                                    color: Theme.text-secondary;
                                                }
                                            }
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;
                                            background: Theme.bg-sidebar;
                                            border-color: Theme.border-default;
                                            border-width: 1px;
                                            border-radius: Theme.radius-sm;

                                            VerticalLayout {
                                                padding: 10px;
                                                spacing: 4px;
                                                Text {
                                                    text: "Claude 3.5 Sonnet";
                                                    font-family: Theme.font-sans;
                                                    font-size: 12px;
                                                    font-weight: 600;
                                                    color: Theme.text-primary;
                                                }
                                                Text {
                                                    text: "Architectural & Context Analysis";
                                                    font-family: Theme.font-sans;
                                                    font-size: 11px;
                                                    color: Theme.text-secondary;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Section 2: Live Connected Project
                    Rectangle {
                        background: Theme.bg-sidebar;
                        border-color: Theme.border-default;
                        border-width: 1px;
                        border-radius: Theme.radius-lg;

                        VerticalLayout {
                            padding: 18px;
                            spacing: 14px;

                            HorizontalLayout {
                                spacing: 10px;
                                Icon {
                                    source: @image-url("../../assets/icons/plug-zap.svg");
                                    width: 18px;
                                    height: 18px;
                                    colorize: Theme.md-link;
                                }
                                Text {
                                    text: "2. Live Connected Project";
                                    font-family: Theme.font-sans;
                                    font-size: 15px;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                }
                            }

                            Text {
                                text: "SnapFlow automatically bridges your active workspace repository via `snapshotd`. Monitor live context, file modifications, and isolated execution threads per workspace root.";
                                font-family: Theme.font-sans;
                                font-size: 13px;
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                            }

                            // Image insertion placeholder / visual card
                            Rectangle {
                                background: Theme.bg-chat;
                                border-color: Theme.border-default;
                                border-width: 1px;
                                border-radius: Theme.radius-md;

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 10px;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: "Workspace Connection Status";
                                            font-family: Theme.font-sans;
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: Theme.text-primary;
                                        }
                                        Text {
                                            text: "[ Image Gap / Preview ]";
                                            font-family: Theme.font-mono;
                                            font-size: 10px;
                                            color: Theme.md-link;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;

                                        Rectangle {
                                            width: 8px;
                                            height: 8px;
                                            border-radius: 4px;
                                            background: #22C55E;
                                        }

                                        Text {
                                            text: "snapshotd • Live connected workspace root (/multi_media_main)";
                                            font-family: Theme.font-mono;
                                            font-size: 11px;
                                            color: Theme.text-primary;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Section 3: Add MCP Servers from Settings
                    Rectangle {
                        background: Theme.bg-sidebar;
                        border-color: Theme.border-default;
                        border-width: 1px;
                        border-radius: Theme.radius-lg;

                        VerticalLayout {
                            padding: 18px;
                            spacing: 14px;

                            HorizontalLayout {
                                spacing: 10px;
                                Icon {
                                    source: @image-url("../../assets/icons/server.svg");
                                    width: 18px;
                                    height: 18px;
                                    colorize: Theme.md-link;
                                }
                                Text {
                                    text: "3. Add MCP Servers from Settings";
                                    font-family: Theme.font-sans;
                                    font-size: 15px;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                }
                            }

                            Text {
                                text: "Expand your agent's powers with Model Context Protocol (MCP) servers. Open **Settings > MCP Servers** to enable tools, database connectors, external APIs, and custom integrations.";
                                font-family: Theme.font-sans;
                                font-size: 13px;
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                            }

                            // Image insertion placeholder / visual card
                            Rectangle {
                                background: Theme.bg-chat;
                                border-color: Theme.border-default;
                                border-width: 1px;
                                border-radius: Theme.radius-md;

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 10px;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: "MCP Server Integration Pane";
                                            font-family: Theme.font-sans;
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: Theme.text-primary;
                                        }
                                        Text {
                                            text: "[ Image Gap / Preview ]";
                                            font-family: Theme.font-mono;
                                            font-size: 10px;
                                            color: Theme.md-link;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 10px;

                                        Rectangle {
                                            horizontal-stretch: 1;
                                            background: Theme.bg-sidebar;
                                            border-color: Theme.border-default;
                                            border-width: 1px;
                                            border-radius: Theme.radius-sm;

                                            HorizontalLayout {
                                                padding: 8px;
                                                alignment: space-between;

                                                Text {
                                                    text: "axolink (Task Queue)";
                                                    font-family: Theme.font-mono;
                                                    font-size: 11px;
                                                    color: Theme.text-primary;
                                                }
                                                Text {
                                                    text: "Active";
                                                    font-family: Theme.font-sans;
                                                    font-size: 10px;
                                                    color: #22C55E;
                                                }
                                            }
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;
                                            background: Theme.bg-sidebar;
                                            border-color: Theme.border-default;
                                            border-width: 1px;
                                            border-radius: Theme.radius-sm;

                                            HorizontalLayout {
                                                padding: 8px;
                                                alignment: space-between;

                                                Text {
                                                    text: "github (API Connector)";
                                                    font-family: Theme.font-mono;
                                                    font-size: 11px;
                                                    color: Theme.text-primary;
                                                }
                                                Text {
                                                    text: "Configured";
                                                    font-family: Theme.font-sans;
                                                    font-size: 10px;
                                                    color: Theme.md-link;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Section 4: Create Skills
                    Rectangle {
                        background: Theme.bg-sidebar;
                        border-color: Theme.border-default;
                        border-width: 1px;
                        border-radius: Theme.radius-lg;

                        VerticalLayout {
                            padding: 18px;
                            spacing: 14px;

                            HorizontalLayout {
                                spacing: 10px;
                                Icon {
                                    source: @image-url("../../assets/icons/wrench.svg");
                                    width: 18px;
                                    height: 18px;
                                    colorize: Theme.md-link;
                                }
                                Text {
                                    text: "4. Create & Customize Skills";
                                    font-family: Theme.font-sans;
                                    font-size: 15px;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                }
                            }

                            Text {
                                text: "Teach your agents repeatable workflows. Create custom skills with structured prompt directives, audit recipes, and helper scripts under **Settings > Skills**.";
                                font-family: Theme.font-sans;
                                font-size: 13px;
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                            }

                            // Image insertion placeholder / visual card
                            Rectangle {
                                background: Theme.bg-chat;
                                border-color: Theme.border-default;
                                border-width: 1px;
                                border-radius: Theme.radius-md;

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 10px;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: "Skills Library";
                                            font-family: Theme.font-sans;
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: Theme.text-primary;
                                        }
                                        Text {
                                            text: "[ Image Gap / Preview ]";
                                            font-family: Theme.font-mono;
                                            font-size: 10px;
                                            color: Theme.md-link;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;

                                        Rectangle {
                                            background: Theme.bg-sidebar;
                                            border-color: Theme.border-default;
                                            border-width: 1px;
                                            border-radius: 12px;

                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                padding-top: 4px;
                                                padding-bottom: 4px;
                                                Text {
                                                    text: "rust-audit";
                                                    font-family: Theme.font-mono;
                                                    font-size: 11px;
                                                    color: Theme.text-primary;
                                                }
                                            }
                                        }

                                        Rectangle {
                                            background: Theme.bg-sidebar;
                                            border-color: Theme.border-default;
                                            border-width: 1px;
                                            border-radius: 12px;

                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                padding-top: 4px;
                                                padding-bottom: 4px;
                                                Text {
                                                    text: "slint-reference";
                                                    font-family: Theme.font-mono;
                                                    font-size: 11px;
                                                    color: Theme.text-primary;
                                                }
                                            }
                                        }

                                        Rectangle {
                                            background: Theme.bg-sidebar;
                                            border-color: Theme.border-default;
                                            border-width: 1px;
                                            border-radius: 12px;

                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                padding-top: 4px;
                                                padding-bottom: 4px;
                                                Text {
                                                    text: "phase-plan";
                                                    font-family: Theme.font-mono;
                                                    font-size: 11px;
                                                    color: Theme.text-primary;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            ThinScrollbar {
                x: parent.width - self.width;
                y: 0px;
                viewport-height: flick.viewport-height;
                visible-height: flick.height;
                viewport-y: flick.viewport-y;
            }
        }

        // --- Bottom Action Bar ---
        Rectangle {
            height: 64px;
            background: Theme.bg-sidebar;
            border-color: Theme.border-default;
            border-width: 1px;

            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Ready to start pair programming?";
                        font-family: Theme.font-sans;
                        font-size: 13px;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }

                btn-touch := TouchArea {
                    width: btn-layout.preferred-width + 32px;
                    height: 40px;
                    mouse-cursor: pointer;

                    clicked => {
                        root.start-chat-clicked();
                    }

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        background: btn-touch.pressed ? Theme.bg-primary.darker(20%) : (btn-touch.has-hover ? Theme.bg-primary.brighter(10%) : Theme.bg-primary);
                        border-radius: Theme.radius-md;

                        btn-layout := HorizontalLayout {
                            alignment: center;
                            spacing: 8px;

                            Text {
                                text: "Start Chat >";
                                font-family: Theme.font-sans;
                                font-size: 14px;
                                font-weight: 600;
                                color: Theme.text-on-primary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
