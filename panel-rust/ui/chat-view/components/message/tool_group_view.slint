import { Theme } from "../../../tokens/theme.slint";
import { Metrics } from "../../../tokens/metrics.slint";
import { Badge } from "../../../base/badge.slint";
import { Icon } from "../../../base/icon.slint";
import { IconButton } from "../../../base/icon_button.slint";
import { MessageItem } from "../../../types.slint";
import { ToolEventRow } from "./tool_event_row.slint";

// Grouped / scrollable container box for tool calls and MCP calls.
// Provides:
// 1. Top header label bar: "TOOL USE" / "MCP CALL" + call count badge.
// 2. Distinct container background (Theme.bg-tertiary) + border (Theme.border-strong).
// 3. Capped height (defaults to 230px, approx 5 tool calls height), automatically
//    becoming internally scrollable via Flickable when content exceeds the cap.
export component ToolGroupView inherits Rectangle {
    in property <[MessageItem]> messages: [];
    in property <int> group-start: 0;
    in property <int> group-length: 0;
    in property <bool> group-local: false;
    in property <length> row-cap-height: 90px;
    in property <string> label: "TOOL USE";
    in property <bool> mcp-variant: false;
    in property <int> item-count: 0;
    // Capped height for ~5 tool calls (~44px per row * 5 + padding)
    in property <length> max-visible-height: 230px;
    // Rough per-row height used only to guess whether the index rail
    // (below) is worth showing at all -- deliberately a static estimate,
    // NOT a read of body-layout's real (wrapped) preferred-height: the
    // rail sits beside `flickable` in the same HorizontalLayout, so its
    // own visibility affects flickable's width, which affects wrapped
    // text height, which affects body-layout.preferred-height -- gating
    // the rail's `if` on that value directly is a real binding loop
    // (confirmed at compile time), not just a style choice.
    in property <length> approx-row-height: 44px;
    in property <length> scrollbar-item-width: 3px;
    in property <bool> show-header: true;
    in property <bool> loading: false;
    in property <bool> default-expanded: false;
    // This is only an initial/default value. The parent derives it from the
    // live tail, so changing it during streaming must not overwrite a user's
    // explicit collapse/expand choice.
    in-out property <bool> expanded: default-expanded;
    in-out property <bool> maximized: false;
    callback open-group-full-view();
    callback toggle-expanded(int);
    callback open-full-view(string, string, string, bool, bool);

    // Active tool call index computed from viewport position
    property <int> current-index: (root.item-count <= 1 || body-layout.preferred-height <= 0px) ? 0 :
        min(root.item-count - 1, max(0, Math.floor((- flickable.viewport-y + 20px) / (body-layout.preferred-height / max(1, root.item-count)))));

    // Left-rail vertical pulse animation during active loading execution
    property <float> pulse-opacity: root.loading ? (0.35 + 0.65 * abs(sin(360deg * mod(animation-tick(), Metrics.pulse-period) / Metrics.pulse-period))) : 0.0;

    background: root.mcp-variant ? Theme.bg-tertiary : Theme.bg-agent-bubble;
    border-color: transparent;
    border-width: 0px;
    border-radius: Theme.radius-md;
    vertical-stretch: 0;

    preferred-height: !root.expanded ? 32px
        : root.maximized ? (36px + body-layout.preferred-height)
        : min(36px + body-layout.preferred-height, root.max-visible-height);

    // Left sidebar vertical pulse rail for active loading execution
    if root.loading : Rectangle {
        x: 0px;
        y: Metrics.space-1;
        width: 3px;
        height: parent.height - (Metrics.space-1 * 2);
        border-radius: 1.5px;
        background: Theme.text-primary;
        opacity: root.pulse-opacity;
    }

    VerticalLayout {
        padding: Metrics.space-2;
        spacing: Metrics.space-2;

        // Top Header Bar: label + tool count badge + Fullscreen button + Top-Right Expand/Collapse toggle button
        if root.show-header : HorizontalLayout {
            spacing: Metrics.space-2;
            cross-axis-alignment: center;

            VerticalLayout {
                alignment: center;
                Icon {
                    source: root.label == "MCP CALL" ? @image-url("../../../assets/icons/plug-zap.svg") : @image-url("../../../assets/icons/wrench.svg");
                    size: 14px;
                    color: Theme.text-primary;
                }
            }

            Text {
                text: root.label;
                font-family: Theme.font-mono;
                font-size: 10px * Theme.font-scale;
                font-weight: 600;
                letter-spacing: 0.8px;
                color: Theme.text-primary;
                vertical-alignment: center;
            }

            // Horizontal spacer
            Rectangle { horizontal-stretch: 1; height: 0px; }

            if root.item-count > 0 : Badge {
                label: root.item-count + (root.item-count == 1 ? " call" : " calls");
                bg: Theme.bg-sidebar;
                fg: Theme.text-primary;
                border-col: transparent;
                border-w: 0px;
            }

            // Top-right Fullscreen Popup Button in Header
            IconButton {
                btn-width: 22px;
                btn-height: 22px;
                active: root.maximized;
                button-accessible-label: root.maximized
                    ? "Close full view of tool group"
                    : "Open tool group in full view";
                clicked => {
                    root.maximized = !root.maximized;
                    root.expanded = true;
                    root.open-group-full-view();
                }

                Icon {
                    source: @image-url("../../../assets/icons/maximize-2.svg");
                    size: 14px;
                    color: Theme.text-primary;
                }
            }

            // Top-right Expand / Collapse Toggle Button in Header with smooth rotation animation
            IconButton {
                btn-width: 22px;
                btn-height: 22px;
                button-accessible-label: root.expanded ? "Collapse tool group" : "Expand tool group";
                clicked => { root.expanded = !root.expanded; }
                Icon {
                    source: @image-url("../../../assets/icons/arrow-down.svg");
                    size: 13px;
                    color: Theme.text-secondary;
                    transform-rotation: root.expanded ? 0deg : 180deg;
                    animate transform-rotation { duration: 180ms; easing: ease-in-out; }
                }
            }
        }

        // Separator line under header (visible when expanded)
        if root.show-header && root.expanded : Rectangle {
            height: 1px;
            background: Theme.border-default;
        }

        // Main content area with scrollable Flickable + right-side fixed index scrollbar
        HorizontalLayout {
            visible: root.expanded;
            height: root.expanded ? (root.maximized ? body-layout.preferred-height : min(body-layout.preferred-height, root.max-visible-height)) : 0px;
            spacing: Metrics.space-2;

            // `interactive: false`: this Flickable is the first *interactive*
            // Flickable ancestor between the root and every `TextInput`
            // nested arbitrarily deep inside `@children` (ToolEventRow's
            // title, ExpandablePanel's body, TerminalLogBlock's payload --
            // see each of their own `interactive: false` doc comments), so
            // it was winning every click-drag gesture before it could ever
            // reach those `TextInput`s, even after they were fixed
            // individually. Mouse-wheel scroll and the index scrollbar
            // rail (right of this Flickable) still work; only drag-to-pan
            // is traded away for click-drag text selection.
            flickable := Flickable {
                interactive: false;
                height: parent.height;
                viewport-height: body-layout.preferred-height;
                // Shrink trio: without `min-width: 0px`, this Flickable
                // couldn't be compressed below `body-layout`'s natural
                // (unbounded) content width -- a long tool argument/path
                // inside `@children` (ToolEventRow's title,
                // ExpandablePanel's body, etc.) pushed the whole group
                // box wider than its chat-row parent instead of wrapping
                // or eliding within it.
                horizontal-stretch: 1;
                preferred-width: 0px;
                min-width: 0px;

                body-layout := VerticalLayout {
                    spacing: 0px;
                    @children
                    // Retained threads provide a group-local model, so this
                    // repeater visits only the group's rows. The flat-model
                    // fallback keeps the legacy start/length gate.
                    for sub-msg[sub-idx] in root.messages : ToolEventRow {
                        visible: root.group-local || (sub-idx >= root.group-start && sub-idx < root.group-start + root.group-length);
                        height: self.visible ? self.preferred-height : 0px;
                        horizontal-stretch: self.visible ? 1 : 0;
                        vertical-stretch: 0;
                        in-group: true;
                        kind: sub-msg.kind;
                        first-use: sub-msg.first-use;
                        text: sub-msg.text;
                        cap-height: root.row-cap-height;
                        raw-input: sub-msg.raw-input;
                        raw-output: sub-msg.raw-output;
                        expanded: sub-msg.expanded;
                        index: sub-msg.index;
                        mcp-variant: root.mcp-variant;
                        toggle-expanded(idx) => { root.toggle-expanded(idx); }
                        open-full-view(title, input, output, term, mcp) => {
                            root.open-full-view(title, input, output, term, mcp);
                        }
                    }
                }
            }

            // Fixed index scrollbar rail mapping directly to each tool call item.
            // Only meaningful once the content is likely to actually
            // overflow max-visible-height -- item-count > 1 alone (e.g.
            // exactly 2 short tool calls that both fit on screen) used to
            // draw 2 tick marks for a box that was never scrollable to
            // begin with. Uses the static `approx-row-height` estimate,
            // not a live geometry read (see that property's doc comment
            // for why: reading body-layout.preferred-height here is a
            // real binding loop, since this rail's own visibility
            // affects flickable's width, which feeds back into
            // body-layout's wrapped-text preferred-height).
            if root.item-count > 1 && (root.item-count * root.approx-row-height) > root.max-visible-height : VerticalLayout {
                width: root.scrollbar-item-width;
                alignment: center;
                spacing: 3px;

                for idx in root.item-count : Rectangle {
                    height: max(6px, min(24px, (root.max-visible-height - (root.item-count * 3px)) / max(1, root.item-count)));
                    width: root.scrollbar-item-width;
                    border-radius: 2px;
                    background: (idx == root.current-index) ? Theme.text-primary : Theme.border-strong;
                    opacity: (idx == root.current-index) ? 1.0 : 0.45;
                    animate opacity { duration: 150ms; easing: ease-out; }
                    animate background { duration: 150ms; easing: ease-out; }

                    TouchArea {
                        mouse-cursor: pointer;
                        accessible-role: button;
                        accessible-label: "Scroll to tool call " + (idx + 1);
                        accessible-action-default => { self.clicked(); }
                        clicked => {
                            let step = body-layout.preferred-height / max(1, root.item-count);
                            flickable.viewport-y = - min(body-layout.preferred-height - root.max-visible-height, idx * step);
                        }
                    }
                }
            }
        }
    }
}
