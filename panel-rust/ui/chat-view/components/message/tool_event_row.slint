import { Theme } from "../../../tokens/theme.slint";
import { SelectionFocus } from "../../../tokens/selection_focus.slint";
import { Metrics } from "../../../tokens/metrics.slint";
import { Icon } from "../../../base/icon.slint";
import { ExpandablePanel } from "../../../base/expandable_panel.slint";
import { CollapseExpand } from "../../../base/collapse_expand.slint";
import { ApiCallView } from "../execution/api_call_view.slint";
import { TerminalView } from "../execution/terminal_view.slint";
import { HoverSurface } from "../../../base/hover.slint";

// One tool-taxonomy event row -- chat-items-redesign.md #5/#6. Transparent
// background (these are inline stream markers, not cards); a dot + an
// icon keyed by `kind` + the event's own text. `first-use` only means
// anything for `kind: "skill_use"` (a skill's first invocation in the
// thread renders brighter, subsequent ones fall back to the tertiary
// text tone) -- the spec gives no equivalent distinction for the other
// three kinds, so `first-use` is silently ignored for those.
export component ToolEventRow inherits Rectangle {
    in property <string> kind; // "tool_use" | "skill_load" | "skill_use" | "mcp_server_call" | "terminal"
    in property <string> text;
    in property <bool> first-use: true;
    // Adaptive height -- grows with wrapped text up to this cap, then
    // becomes internally scrollable instead of eliding to one line.
    in property <length> cap-height: 90px;

    // chat-items-remaining-wiring.md #4 (execution-view content):
    // `MessageItem::raw-input`/`raw-output`, already JSON-serialized to a
    // display string Rust-side -- "" when the backend didn't provide one.
    // Only meaningful for `kind: "tool_use"`/`"mcp_server_call"`; ignored
    // for the two skill kinds, same as `first-use` above.
    in property <string> raw-input;
    in property <string> raw-output;
    // Same shape `MessageCard` uses for its own log-body collapse state
    // (`MessageItem::expanded`/`index`, round-tripped through
    // `toggle-expanded(int)`) -- kept Rust-side so the open/closed state
    // survives a re-render (e.g. a new streamed message growing the
    // list), instead of resetting every time this row is rebuilt.
    in property <bool> expanded;
    in property <int> index;
    in property <bool> in-group: false;
    callback toggle-expanded(int);
    callback open-full-view(string, string, string, bool, bool);

    property <bool> is-skill-use: kind == "skill_use";
    property <bool> is-terminal: kind == "terminal";
    property <bool> is-tool-use: kind == "tool_use";
    property <bool> is-mcp: kind == "mcp_server_call";

    // Container surface for tool calls, MCP calls, and execution rows
    background: in-group ? transparent : ((is-mcp || is-tool-use || is-terminal) ? Theme.bg-agent-bubble : transparent);
    border-color: transparent;
    border-width: 0px;
    border-radius: Theme.radius-md;

    // Content-sized height — do not stretch and steal space from compose.
    vertical-stretch: 0;

    // kind -> icon lookup. @image-url requires a compile-time-constant
    // literal path (see base/icon.slint's own comment), so this can't be
    // resolved from a `for`/data-driven source string -- a ternary chain
    // of literal @image-url branches is the one way to make an icon
    // choice conditional on a runtime string while keeping each path a
    // compile-time literal. Fallback branch is unreachable given `kind`'s
    // documented enum, but ternary chains need one.
    property <image> kind-icon-source:
        kind == "tool_use" ? @image-url("../../../assets/icons/wrench.svg")
        : kind == "skill_load" ? @image-url("../../../assets/icons/book-open.svg")
        : kind == "skill_use" ? @image-url("../../../assets/icons/sparkles.svg")
        : kind == "mcp_server_call" ? @image-url("../../../assets/icons/plug-zap.svg")
        : @image-url("../../../assets/icons/terminal.svg");
    // Execution-view content only applies to the two non-skill kinds --
    // chat-items-redesign.md #7-#9 never describes a terminal/api-call
    // view for `skill_load`/`skill_use`. Terminal rows always show body.
    property <bool> has-execution-content:
        is-terminal
        || ((kind == "tool_use" || kind == "mcp_server_call")
            && (raw-input != "" || raw-output != ""));

    // Local open state tracks the host `expanded` prop until the user
    // clicks (assignment breaks the binding). That keeps the button
    // working in slint-viewer / fixtures where `toggle-expanded` has no
    // Rust handler, while production still gets the callback so the
    // host vec stays in sync.
    property <bool> details-open: root.expanded;
    changed expanded => { details-open = root.expanded; }

    // Dot (8px) + Gap (Metrics.space-2) + Icon (16px) + Gap (Metrics.space-2) + Padding (Metrics.space-2)
    property <length> lead-indent: Metrics.space-2 + 8px + Metrics.space-2 + 16px + Metrics.space-2;

    VerticalLayout {
        padding-top: 3px;
        padding-bottom: 3px;
        padding-left: 0px;
        padding-right: 0px;
        spacing: 2px;

        // First row: dot + kind icon + name. Exact uniform alignment across all kinds.
        HorizontalLayout {
            padding-left: Metrics.space-2;
            padding-right: Metrics.space-2;
            padding-top: 0px;
            padding-bottom: 0px;
            spacing: Metrics.space-2;
            cross-axis-alignment: center;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                width: 8px;
                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: self.width / 2;
                    background: Theme.text-primary;
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                width: 16px;
                Icon {
                    source: root.kind-icon-source;
                    size: 16px;
                    color: Theme.text-primary;
                }
            }
            // `interactive: false` trades away drag-to-pan for the rare
            // title that exceeds `cap-height` in favor of native
            // click-drag selection (see markdown_view.slint's overlay doc
            // comment) -- selection still reaches every character via
            // Ctrl+A even while visually capped/clipped.
            Flickable {
                interactive: false;
                horizontal-stretch: 1;
                preferred-width: 0px;
                min-width: 0px;
                height: min(text-content.preferred-height, root.cap-height);
                viewport-height: text-content.preferred-height;
                text-content := TextInput {
                    text: root.text;
                    font-family: Theme.font-sans;
                    font-size: 12px * Theme.font-scale;
                    font-weight: 600;
                    color: (is-mcp || is-tool-use || is-terminal) ? Theme.text-primary
                        : (is-skill-use && first-use) ? Theme.text-accent-bright
                        : Theme.text-primary;
                    read-only: true;
                    // Report focus so the host does not drop keystrokes while a
                    // selectable-text surface holds focus (see SelectionFocus).
                    changed has-focus => {
                        SelectionFocus.focused-count += self.has-focus ? 1 : -1;
                    }
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    width: parent.width;
                    selection-foreground-color: Theme.text-primary;
                    selection-background-color: Theme.selection-bg;
                }
            }

            // Maximize / Open full view button right on the call title line
            if has-execution-content : TouchArea {
                accessible-role: button;
                accessible-label: root.expanded ? "Collapse tool call details" : "Expand tool call details";
                accessible-action-default => { self.clicked(); }
                width: 22px;
                height: 22px;
                mouse-cursor: pointer;
                clicked => {
                    root.open-full-view(
                        root.is-mcp ? "MCP CALL PAYLOAD & DETAILS" : (root.is-terminal ? "TERMINAL EXECUTION FULL VIEW" : "TOOL CALL PAYLOAD & DETAILS"),
                        root.is-terminal ? root.text : root.raw-input,
                        root.raw-output,
                        root.is-terminal,
                        root.is-mcp
                    );
                }

                Rectangle {
                    background: parent.has-hover ? Theme.bg-sidebar : transparent;
                    border-radius: Theme.radius-sm;
                    animate background { duration: 120ms; }

                    Icon {
                        source: @image-url("../../../assets/icons/maximize-2.svg");
                        size: 14px;
                        color: Theme.text-primary;
                    }
                }
            }
        }

        // Click-to-open execution-view (chat-items-remaining-wiring.md #4).
        // Details body stays mounted and uses CollapseExpand (height +
        // opacity) so show/hide is smooth — same approach as sidebar
        // width animate and ExpandablePanel height animate.
        //
        // `root.visible` gate: `ToolGroupView`/the full-view popup both
        // instantiate one `ToolEventRow` per message in the *entire*
        // thread per group (toggling `visible` per row to show only that
        // group's slice -- Slint's declarative `for` has no way to bind
        // to an actual sub-slice of a model), so a long thread with many
        // tool groups mounts far more rows than are ever shown at once.
        // This can't reduce the *instance count* (would need a Rust-side
        // per-group model instead of one flat message list), but gating
        // the heavy children -- `CollapseExpand`/`ExpandablePanel`/
        // `ApiCallView`/`TerminalView` -- behind `root.visible` keeps
        // every invisible instance down to its cheap header row only.
        if root.visible && has-execution-content : VerticalLayout {
            vertical-stretch: 0;
            spacing: Metrics.gap-sm;
            HoverSurface {
                height: 22px;
                border-radius: Theme.radius-sm;
                button-accessible-label: root.details-open ? "Hide call details" : "Show call details";
                clicked => {
                    root.details-open = !root.details-open;
                    root.toggle-expanded(root.index);
                }
                HorizontalLayout {
                    padding-left: root.lead-indent;
                    Text {
                        text: root.details-open ? "[-] hide call details" : "[+] show call details";
                        font-family: Theme.font-mono;
                        font-size: 10px * Theme.font-scale;
                        font-weight: 600;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }
                }
            }
            CollapseExpand {
                open: root.details-open;
                // Vertical height + opacity; full width (no width shrink —
                // that would reflow mono payloads mid-animation).
                animate-width: false;
                HorizontalLayout {
                    padding-left: root.lead-indent;
                    if root.is-terminal : ExpandablePanel {
                        collapsed-max-height: root.cap-height * 2;
                        collapsed-by-default: false;
                        title: "TERMINAL EXECUTION FULL VIEW";
                        open-full-view => { root.open-full-view("TERMINAL EXECUTION FULL VIEW", root.text, root.raw-output, true, false); }
                        TerminalView {
                            command: root.text;
                            output: root.raw-output;
                            // raw_input holds exit code decimal when known.
                            exit-code: root.raw-input == "" ? -1 : root.raw-input.to-float();
                        }
                    }
                    if !root.is-terminal : ExpandablePanel {
                        // When the outer shell is open, start at the
                        // capped preview; user can still "Open full view".
                        collapsed-max-height: root.cap-height * 2;
                        collapsed-by-default: true;
                        title: "TOOL CALL PAYLOAD & DETAILS";
                        open-full-view => { root.open-full-view(root.is-mcp ? "MCP CALL PAYLOAD & DETAILS" : "TOOL CALL PAYLOAD & DETAILS", root.raw-input, root.raw-output, false, root.is-mcp); }
                        ApiCallView {
                            raw-input: root.raw-input;
                            raw-output: root.raw-output;
                        }
                    }
                }
            }
        }
    }
}
