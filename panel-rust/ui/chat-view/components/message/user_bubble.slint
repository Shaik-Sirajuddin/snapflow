import { Theme } from "../../../tokens/theme.slint";
import { SelectionFocus } from "../../../tokens/selection_focus.slint";
import { Metrics } from "../../../tokens/metrics.slint";
import { MessageItem } from "../../../types.slint";

// User bubble — tertiary fill, no border, larger 3-corner radius with
// LTR outgoing cut (bottom-right). Keeps the Flickable + preferred-height
// body pattern from the working baseline -- `Flickable` here is load-
// bearing for layout (a boundary that breaks a `width` binding loop
// between `bubble-text.width: parent.width` and `content`'s own computed
// width), not for scrolling (`height == viewport-height`, nothing pans).
// `interactive: false` keeps that boundary but stops `Flickable`'s own
// drag-to-pan gesture recognition from capturing the mouse-down-and-drag
// before it reaches `bubble-text`'s native click-drag selection.
export component UserBubble inherits Rectangle {
    in property <MessageItem> item;
    callback copy-message(string);

    // Expose the durable row text to the Slint MCP/accessibility tree. This
    // gives live UI tests a direct way to assert that a selected retained
    // ChatView shows its own message and not another thread's row.
    accessible-role: text;
    accessible-label: item.text;

    vertical-stretch: 0;

    // Use the dedicated user-message surface so outgoing rows have a
    // slightly clearer contrast against the chat background in both themes.
    background: Theme.bg-user-bubble;
    border-width: 0px;
    border-top-left-radius: Theme.radius-lg;
    border-top-right-radius: Theme.radius-lg;
    border-bottom-left-radius: Theme.radius-lg;
    border-bottom-right-radius: Metrics.radius-corner-cut;

    HorizontalLayout {
        spacing: 0px;
        vertical-stretch: 1;
        content := VerticalLayout {
            padding: Metrics.space-4;
            horizontal-stretch: 1;
            Flickable {
                interactive: false;
                height: bubble-text.preferred-height;
                viewport-height: bubble-text.preferred-height;
                bubble-text := TextInput {
                    text: item.text;
                    font-family: Theme.font-sans;
                    font-size: 12px * Theme.font-scale;
                    color: Theme.text-primary;
                    read-only: true;
                    // Report focus so the host does not drop keystrokes while a
                    // selectable-text surface holds focus (see SelectionFocus).
                    changed has-focus => {
                        SelectionFocus.focused-count += self.has-focus ? 1 : -1;
                    }
                    wrap: word-wrap;
                    horizontal-alignment: left;
                    vertical-alignment: top;
                    width: parent.width;
                    selection-foreground-color: Theme.text-primary;
                    selection-background-color: Theme.selection-bg;
                }
            }
        }
    }
}
