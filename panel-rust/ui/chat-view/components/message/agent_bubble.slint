import { Theme } from "../../../tokens/theme.slint";
import { Metrics } from "../../../tokens/metrics.slint";
import { MessageItem } from "../../../types.slint";
import { MarkdownView } from "../../../base/markdown_view.slint";
import { CollapseExpand } from "../../../base/collapse_expand.slint";
import { HoverSurface } from "../../../base/hover.slint";
import { TextPillButton } from "../../../base/text_pill_button.slint";

// Agent / thinking bubble — chat-items-redesign.md #3 / #10.
// Agent: elevated fill, no label, 3-corner radius (bottom-left cut).
// Thinking: collapsible block (collapsed by default), muted header + body.
// Body: streaming MarkdownView (visual lines from `markdown.rs`).
export component AgentBubble inherits Rectangle {
    // Phase 17: markdown link Ctrl+Click, bubbled to the host opener.
    callback link-activated(string);
    in property <MessageItem> item;
    callback link-clicked(string);
    // Shared with tool-call expand state (MessageItem.expanded / index
    // round-trip through ChromeMsg::ToggleExpanded). Only meaningful for
    // thinking rows; agent rows ignore it.
    callback toggle-expanded(int);
    callback copy-message(string);
    // Edge-triggered commands fan out to the selectable message surfaces.
    property <int> focus-selection-command: 0;
    property <int> select-all-command: 0;
    // Copy/Select/Select all row is not ready for general use yet -- hidden
    // behind the same BETA_MODE gate used elsewhere this session (see
    // `beta_mode_enabled()` in src/lib.rs). Additive: doesn't replace the
    // pre-existing `is-agent` condition below, just ANDs onto it.
    in property <bool> beta-mode-enabled: false;

    // Keep the rendered row discoverable in the live Slint MCP tree so
    // thread-switch tests can distinguish A's and B's visible messages.
    accessible-role: text;
    accessible-label: item.text;

    property <bool> is-thinking: item.kind == "thinking";
    property <bool> is-agent: item.kind == "agent";
    property <bool> is-pending: item.kind == "pending";

    vertical-stretch: 0;
    clip: true;

    // Contrasting agent fill (Theme.bg-tertiary)
    background: (is-thinking || is-pending) ? transparent : Theme.bg-tertiary;
    border-width: 0px;
    border-top-left-radius: (is-thinking || is-pending) ? 0px : Theme.radius-lg;
    border-top-right-radius: (is-thinking || is-pending) ? 0px : Theme.radius-lg;
    border-bottom-left-radius: (is-thinking || is-pending) ? 0px : Metrics.radius-corner-cut;
    border-bottom-right-radius: (is-thinking || is-pending) ? 0px : Theme.radius-lg;

    HorizontalLayout {
        spacing: 0px;
        vertical-stretch: 1;
        if is-agent : Rectangle {
            width: 3px;
            height: 14px;
            background: Theme.md-link;
            border-radius: 1px;
            horizontal-stretch: 0;
            vertical-stretch: 0;
            y: Metrics.space-4;
        }
        content := VerticalLayout {
        // Stretch the body across the full bubble width. MarkdownView
        // left-packs its runs *inside* that full width (see its module
        // comment). Using `alignment: start` here was wrong for the
        // default case: VerticalLayout's cross-axis start shrink-wraps
        // children to preferred-width, so a short agent reply becomes a
        // narrow column that a parent stretch layout then re-centers —
        // the classic "md looks centered" regression.
        alignment: stretch;
        padding: (is-thinking || is-pending) ? Metrics.space-2 : Metrics.space-4;
        spacing: (is-thinking || is-pending) ? Metrics.space-2 : 0px;

                // "Agent is working..." text hidden by request -- the
        // pending row itself (and its transparent/borderless styling
        // above) stays, so layout/spacing during the pending state is
        // unchanged; it now just renders no visible label.
        if is-pending : HorizontalLayout {
            padding: Metrics.space-2;
            spacing: Metrics.space-2;
        }

        // Thinking header — always visible; click toggles the body.
        if is-thinking : HoverSurface {
            height: 22px;
            border-radius: Theme.radius-sm;
            button-accessible-label: item.expanded
                ? "Collapse thinking"
                : "Expand thinking";
            clicked => { root.toggle-expanded(item.index); }
            HorizontalLayout {
                padding-left: Metrics.space-2;
                padding-right: Metrics.space-2;
                spacing: Metrics.space-2;
                Text {
                    // Chevron: ▶ collapsed, ▼ expanded.
                    text: item.expanded ? "\u{25BC}" : "\u{25B6}";
                    color: Theme.text-muted;
                    font-size: 9px * Theme.font-scale;
                    font-family: Theme.font-mono;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                Text {
                    text: "Thinking";
                    color: Theme.text-muted;
                    font-size: 11px * Theme.font-scale;
                    font-family: Theme.font-sans;
                    font-weight: 600;
                    font-italic: true;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                // One-line preview while collapsed so the block isn't a
                // mystery empty chevron row.
                if !item.expanded && item.text != "" : Text {
                    text: item.text;
                    color: Theme.text-tertiary;
                    font-size: 10px * Theme.font-scale;
                    font-family: Theme.font-sans;
                    font-italic: true;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    preferred-width: 0px;
                    min-width: 0px;
                    overflow: elide;
                }
            }
        }

        // Agent body always open; thinking body animates open/closed via
        // CollapseExpand (real `animate height`, not a Timer). The
        // `Flickable` wrapper is load-bearing for layout, not scrolling
        // (`height == viewport-height` -- there's never anything to pan):
        // removing it entirely reintroduces a `width` binding loop,
        // because a bare `MarkdownView` here folds its own width demand
        // back into `content`'s (the parent `VerticalLayout`'s) computed
        // width, which this instance's `width: parent.width` also reads
        // from -- `Flickable` is a layout boundary that breaks that cycle.
        // `interactive: false` instead keeps the boundary but stops
        // `Flickable`'s own drag-to-pan gesture from capturing the
        // mouse-down-and-drag before it reaches the per-line `TextInput`
        // selection overlays in `MarkdownView` underneath.
        if is-agent : Flickable {
            interactive: false;
            height: md.preferred-height;
            viewport-height: md.preferred-height;
            horizontal-stretch: 1;
            preferred-width: 0px;
            min-width: 0px;
            md := MarkdownView {
                link-activated(target) => { root.link-activated(target); }
                width: parent.width;
                row-width: parent.width;
                horizontal-stretch: 1;
                preferred-width: 0px;
                min-width: 0px;
                blocks: item.markdown-blocks;
                lines: item.markdown-lines;
                fallback-text: item.text;
                focus-selection-command: root.focus-selection-command;
                select-all-command: root.select-all-command;
            }
        }

        if is-thinking : CollapseExpand {
            open: item.expanded;
            Flickable {
                interactive: false;
                height: think-md.preferred-height;
                viewport-height: think-md.preferred-height;
                horizontal-stretch: 1;
                preferred-width: 0px;
                min-width: 0px;
                think-md := MarkdownView {
                    link-activated(target) => { root.link-activated(target); }
                    width: parent.width;
                    row-width: parent.width;
                    horizontal-stretch: 1;
                    preferred-width: 0px;
                    min-width: 0px;
                    blocks: item.markdown-blocks;
                    lines: item.markdown-lines;
                    fallback-text: item.text;
                    focus-selection-command: root.focus-selection-command;
                    select-all-command: root.select-all-command;
                }
            }
        }
        }
        if is-agent && root.beta-mode-enabled : VerticalLayout {
            padding-right: Metrics.space-3;
            alignment: end;
            padding-top: Metrics.space-2;
            vertical-stretch: 0;
            spacing: Metrics.space-1;
            TextPillButton {
                label: "Copy";
                clicked => { root.copy-message(item.text); }
            }
            TextPillButton {
                label: "Select";
                clicked => { root.focus-selection-command += 1; }
            }
            TextPillButton {
                label: "Select all";
                clicked => {
                    root.select-all-command += 1;
                    // The block StyledText path has no native selection
                    // widget yet; copying here still makes Select all useful
                    // for those messages while the line path highlights.
                    root.copy-message(item.text);
                }
            }
        }
    }
}
