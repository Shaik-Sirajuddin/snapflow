import { Theme } from "../tokens/theme.slint";
import { Metrics } from "../tokens/metrics.slint";
import { Button } from "../base/button.slint";
import { TerminalItem } from "../types.slint";
import { TerminalHeader } from "../base/terminal_header.slint";
import { HoverSurface } from "../base/hover.slint";

// Real embedded terminal view -- Phase 4 terminal-view addition. Two
// components:
//
// - `TerminalCard`: the bounded max-height read-only card docked above
//   the compose bar (mirrors `PermissionCard`'s docking spot in
//   `chat_area.slint`), one per live/finished agent-created terminal on
//   the active thread (`AgentBridge::active_terminals` +
//   `terminal_buffer`, see `agent_bridge.rs`). Click the header (or the
//   expand glyph) to request the floating overlay via `expand()`.
// - `TerminalOverlay`: the click-to-expand floating box (full-window,
//   same overlay convention `app.slint`'s settings sheet already uses),
//   showing the same buffer full-height/scrollable with a close action.
//
// This is the agent-created terminal path (`terminal/create` relayed
// from the backend, output streamed live via `acpx/terminal_output` --
// see `permission_card.slint`'s doc comment for the request/approval
// half of this flow). A distinct client-PTY terminal component (real
// interactive input/resize) is separate, tracked work -- this is
// read-only, matching the plan's "close to a real terminal ui" framing
// for the *client*-created case while the *agent*-created case stays a
// bounded streaming log.
export component TerminalCard inherits Rectangle {
    in property <TerminalItem> item;
    in property <bool> compact: true;
    callback expand();

    background: Theme.bg-terminal;
    border-color: Theme.border-terminal;
    border-width: 1px;
    border-radius: Theme.radius-md;
    height: compact ? 96px : 140px;

    VerticalLayout {
        padding: Metrics.space-4;
        spacing: Metrics.space-2;
        TerminalHeader {
            title: "terminal " + item.terminal-id;
            status-text: item.has-exited ? "exit " + item.exit-code : "running";
            status-color: item.has-exited ? Theme.text-muted : Theme.text-secondary;
            button-accessible-label: "Expand terminal " + item.terminal-id;
            clicked => { expand(); }
            Text {
                text: "\u{2922}"; // expand glyph
                color: Theme.text-muted;
                font-size: 11px * Theme.font-scale;
                vertical-alignment: center;
            }
        }
        Flickable {
            viewport-height: log.preferred-height;
            log := Text {
                text: item.output + (item.truncated ? "\n... (truncated)" : "");
                color: Theme.text-terminal;
                font-family: Theme.font-mono;
                font-size: 10px * Theme.font-scale;
                wrap: word-wrap;
                overflow: clip;
                horizontal-stretch: 1;
                preferred-width: 0px;
                min-width: 0px;
            }
        }
    }
}

// Full-window floating overlay for one-or-more expanded terminals -- same
// docking convention as `app.slint`'s settings sheet (8px inset Rectangle
// over the whole window), reused rather than duplicated visually since
// both are "modal card over the panel" treatments.
//
// Terminal-tabs phase: this used to render exactly one terminal (`item`)
// with no way to switch without closing the overlay and reopening the
// popup. `open-tabs` now carries every terminal pinned open as a tab;
// `item` stays the single *active* one (unchanged prop, still what the
// header/content read for "which tab is current"). See the tab-strip and
// content-`for`-loop below for how each tab keeps its own scroll position.
export component TerminalOverlay inherits Rectangle {
    in property <TerminalItem> item;
    in property <[TerminalItem]> open-tabs: [];
    // A standalone exported component has no compile-time-resolvable
    // `parent` (unlike `app.slint`'s inline settings sheet, which is
    // lexically nested directly inside the `Window` component and so
    // can reference `parent.width`/`parent.height` directly) -- the
    // caller passes the window's own size in explicitly instead.
    in property <length> container-width;
    in property <length> container-height;
    callback close();
    // Switch the active tab (fired by clicking a tab pill below).
    callback tab-selected(string);
    // Dismiss one tab from the open set (its own close [x], not the
    // overlay-wide Close button) -- does not kill the underlying process.
    callback tab-closed(string);

    x: 8px;
    y: 8px;
    width: container-width - 16px;
    height: container-height - 16px;
    background: Theme.bg-terminal;
    border-color: Theme.border-strong;
    border-width: 1px;
    border-radius: Theme.radius-md;

    VerticalLayout {
        padding: Metrics.space-5;
        spacing: Metrics.space-4;

        // Tab strip: one pill per open terminal (title elided, running/
        // exited dot, own close [x]) plus the overlay-wide exit-code
        // readout and Close button for whichever tab is active.
        HorizontalLayout {
            spacing: Metrics.space-3;
            tab-scroller := Flickable {
                horizontal-stretch: 1;
                preferred-width: 0px;
                min-width: 0px;
                height: 26px;
                viewport-width: tab-strip.preferred-width;
                tab-strip := HorizontalLayout {
                    spacing: Metrics.gap-sm;
                    for tab-item in root.open-tabs : HoverSurface {
                        selected: tab-item.terminal-id == root.item.terminal-id;
                        idle-bg: Theme.bg-sidebar;
                        hover-bg: Theme.bg-sidebar;
                        selected-bg: Theme.bg-primary;
                        border-color: Theme.border-default;
                        border-width: 1px;
                        border-radius: Theme.radius-sm;
                        height: 26px;
                        width: tab-label.preferred-width + 40px;
                        accessible-role: tab;
                        accessible-label: "Terminal tab " + (tab-item.title != "" ? tab-item.title : tab-item.terminal-id)
                            + (tab-item.active ? ", running" : ", exited");
                        accessible-action-default => { self.clicked(); }
                        clicked => { root.tab-selected(tab-item.terminal-id); }

                        HorizontalLayout {
                            padding-left: Metrics.space-2;
                            padding-right: Metrics.space-1;
                            spacing: Metrics.space-1;

                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: self.width / 2;
                                y: (parent.height - self.height) / 2;
                                background: tab-item.active ? Theme.status-success : (tab-item.exit-code == 0 ? Theme.text-muted : Theme.status-error);
                            }
                            tab-label := Text {
                                text: tab-item.title != "" ? tab-item.title : tab-item.terminal-id;
                                color: (tab-item.terminal-id == root.item.terminal-id) ? Theme.text-on-primary : Theme.text-primary;
                                font-family: Theme.font-mono;
                                font-size: 10px * Theme.font-scale;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                preferred-width: 0px;
                                min-width: 0px;
                                overflow: elide;
                            }
                            close-tab-touch := TouchArea {
                                width: 14px;
                                height: 14px;
                                mouse-cursor: pointer;
                                accessible-role: button;
                                accessible-label: "Close terminal tab " + (tab-item.title != "" ? tab-item.title : tab-item.terminal-id);
                                accessible-action-default => { self.clicked(); }
                                clicked => { root.tab-closed(tab-item.terminal-id); }
                                Text {
                                    text: "×";
                                    color: (tab-item.terminal-id == root.item.terminal-id) ? Theme.text-on-primary : Theme.text-muted;
                                    font-size: 12px * Theme.font-scale;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                            }
                        }
                    }
                }
            }
            if item.has-exited : Text {
                text: "exit " + item.exit-code;
                color: Theme.text-muted;
                font-family: Theme.font-mono;
                font-size: 10px * Theme.font-scale;
                vertical-alignment: center;
            }
            Button {
                label: "Close";
                button-accessible-label: "Close terminal overlay";
                btn-width: 60px;
                btn-height: 24px;
                font-weight: 400;
                clicked => { close(); }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.border-default;
        }
        // One persistent Flickable+Text per open tab, same `wrap:word-
        // wrap` + `horizontal-stretch:1` + `preferred-width:0px` +
        // `min-width:0px` trio the pre-existing single-terminal `full-
        // log`/`output-text` Texts already used inside their own bare
        // `Flickable` (unchanged from before this tabs phase -- see
        // `TerminalCard`'s `log` above and the content Flickable below).
        //
        // The wrapping `VerticalLayout` (not a plain `Rectangle`) is
        // required, though: a plain non-Layout container was the first
        // attempt here, with each repeated child sized against `parent.
        // width`/`.height` (or a named sibling reference) -- confirmed
        // live (headless render) that BOTH silently produce zero-area
        // children in this Slint version's `for`-repeated-element
        // handling outside of a real `Layout`, nothing crashes or errors,
        // the row is just invisible. Real `Layout`s don't have that gap
        // (they always assign each child, repeated or not, concrete
        // geometry through their own constraint solver), but naively
        // wrapping the `for` in one *is* the binding loop this component
        // hit while building it ("layoutinfo-v -> layout-cache -> height
        // -> height"): the wrapper's own height would be auto-computed
        // from its children's layoutinfo, and each child's height would
        // in turn depend on the wrapper's already-resolved height.
        // Breaking that cycle: pin the wrapper's OWN contribution to the
        // outer `VerticalLayout` to a fixed `0` (`preferred-height`/
        // `min-height` below, so its outward layoutinfo never asks its
        // children anything) while `vertical-stretch: 1` still lets the
        // outer layout hand it whatever real space is left over; then,
        // for each repeated child, `vertical-stretch: 1` only on the
        // *active* tab (others pinned to `0` the same way) lets this
        // wrapper's OWN constraint solver hand that one child all of the
        // wrapper's resolved height directly -- no `parent`/named-height
        // property reference anywhere in the loop. Every tab stays
        // mounted via `for` (never `if`, which would tear down and
        // recreate the element, resetting `Flickable.viewport-y` back to
        // the top) -- only `visible`/`vertical-stretch` toggle per tab,
        // so switching tabs and back lands exactly where each tab's own
        // scroll was.
        content-host := VerticalLayout {
            vertical-stretch: 1;
            preferred-height: 0px;
            min-height: 0px;
            spacing: 0px;
            for tab-item in root.open-tabs : Flickable {
                property <bool> is-active-tab: tab-item.terminal-id == root.item.terminal-id;
                vertical-stretch: self.is-active-tab ? 1 : 0;
                preferred-height: 0px;
                min-height: 0px;
                visible: self.is-active-tab;
                viewport-height: tab-log.preferred-height;
                tab-log := Text {
                    text: tab-item.output + (tab-item.truncated ? "\n... (truncated)" : "");
                    color: Theme.text-terminal;
                    font-family: Theme.font-mono;
                    font-size: 11px * Theme.font-scale;
                    wrap: word-wrap;
                    overflow: clip;
                    horizontal-stretch: 1;
                    preferred-width: 0px;
                    min-width: 0px;
                }
            }
        }
    }
}
