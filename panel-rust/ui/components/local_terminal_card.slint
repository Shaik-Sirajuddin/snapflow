import { Theme } from "../tokens/theme.slint";
import { Metrics } from "../tokens/metrics.slint";
import { Strings } from "../tokens/strings.slint";
import { Button } from "../base/buttons/button.slint";
import { IconButton } from "../base/buttons/icon_button.slint";
import { LocalTerminalItem } from "../types.slint";
import { TerminalHeader } from "../base/terminal/terminal_header.slint";
import { Text } from "../base/text/base_text.slint";
import { Card } from "../base/layout/card.slint";
import { Divider } from "../base/layout/divider.slint";

// Client-local PTY terminal view -- companion to `terminal_card.slint`'s
// agent-created (read-only) `TerminalCard`/`TerminalOverlay`. This one
// is a real interactive terminal the *client itself* spawned
// (`AgentBridge::open_local_terminal`, see `local_terminal.rs`'s doc
// comment): the card/overlay both capture keyboard input via a
// `FocusScope` and forward every keystroke to Rust through
// `local-terminal-key(text)`, which writes it straight to the real
// PTY's input side. `screen-text` is the VT100 parser's real rendered
// screen (cursor-tracked, control sequences interpreted), monochrome
// per this project's design language (see `local_terminal.rs`'s doc
// comment on why colors are intentionally not reproduced).
export component LocalTerminalCard inherits Card {
    in property <LocalTerminalItem> item;
    in property <bool> compact: true;
    callback expand();
    callback key-input(string);
    callback close-requested();
    out property <bool> has-focus: focus-scope.has-focus;

    bordered: true;
    border: "default";
    border-col: Theme.border-terminal;
    pad: Metrics.space-4;
    background: Theme.bg-terminal;
    height: compact ? 120px : 180px;

    focus-scope := FocusScope {
        key-pressed(event) => {
            key-input(event.text);
            accept
        }
        VerticalLayout {
            padding: 0px;
            spacing: Metrics.space-2;
            TerminalHeader {
                title: Strings.local-terminal;
                status-text: item.has-exited ? Strings.exited : (focus-scope.has-focus ? Strings.focused : Strings.click-to-focus);
                status-color: item.has-exited ? Theme.text-muted : Theme.text-secondary;
                button-accessible-label: Strings.focus-local-terminal;
                clicked => {
                    focus-scope.focus();
                }
                Button {
                    label: Strings.kill;
                    button-accessible-label: Strings.close-local-terminal;
                    size: "sm";
                    font-size: 8px;
                    font-weight: 400;
                    bg: Theme.bg-card;
                    fg: Theme.text-secondary;
                    clicked => { close-requested(); }
                }
                local-terminal-expand := IconButton {
                    btn-width: 16px;
                    btn-height: 16px;
                    button-accessible-label: Strings.expand-local-terminal;
                    clicked => { expand(); }
                    Text {
                        text: "\u{2922}"; // expand glyph, same as TerminalCard
                        color: Theme.text-muted;
                        size: "sm";
                        vertical-alignment: center;
                    }
                }
            }
            Flickable {
                viewport-height: log.preferred-height;
                log := Text {
                    text: item.screen-text;
                    color: Theme.text-terminal;
                    font-family: Theme.font-mono;
                    size: "sm";
                    wrap: no-wrap;
                    overflow: clip;
                    horizontal-stretch: 1;
                    preferred-width: 0px;
                    min-width: 0px;
                }
            }
        }
    }
}

// Full-window floating overlay -- same docking convention as
// `TerminalOverlay`/the settings sheet.
export component LocalTerminalOverlay inherits Card {
    in property <LocalTerminalItem> item;
    in property <length> container-width;
    in property <length> container-height;
    callback close();
    callback key-input(string);
    callback close-requested();
    out property <bool> has-focus: focus-scope.has-focus;

    x: 8px;
    y: 8px;
    width: container-width - 16px;
    height: container-height - 16px;
    bordered: true;
    border: "strong";
    border-col: Theme.border-strong;
    // Keep the overlay's existing larger content inset.
    pad: Metrics.space-5;
    background: Theme.bg-terminal;

    focus-scope := FocusScope {
        key-pressed(event) => {
            key-input(event.text);
            accept
        }
        VerticalLayout {
            padding: 0px;
            spacing: Metrics.space-4;
            HorizontalLayout {
                spacing: Metrics.space-3;
                Text {
                    text: Strings.local-terminal + (item.has-exited ? " (" + Strings.exited + ")" : "");
                    color: Theme.text-primary;
                    font-family: Theme.font-mono;
                    weight: "bold";
                    horizontal-stretch: 1;
                    preferred-width: 0px;
                    min-width: 0px;
                    overflow: elide;
                    vertical-alignment: center;
                }
                Button {
                    label: Strings.kill;
                    button-accessible-label: Strings.close-local-terminal;
                    btn-width: 60px;
                    btn-height: 24px;
                    font-weight: 400;
                    clicked => { close-requested(); }
                }
                Button {
                    label: Strings.close-local-terminal-overlay;
                    button-accessible-label: Strings.close-local-terminal-overlay;
                    btn-width: 60px;
                    btn-height: 24px;
                    font-weight: 400;
                    clicked => { close(); }
                }
            }
            Divider { }
            Flickable {
                viewport-height: full-log.preferred-height;
                full-log := Text {
                    text: item.screen-text;
                    color: Theme.text-terminal;
                    font-family: Theme.font-mono;
                    size: "sm";
                    wrap: no-wrap;
                    overflow: clip;
                    horizontal-stretch: 1;
                    preferred-width: 0px;
                    min-width: 0px;
                }
            }
        }
    }

    init => { focus-scope.focus(); }
}
