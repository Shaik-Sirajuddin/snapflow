import { Theme } from "../tokens/theme.slint";
import { Metrics } from "../tokens/metrics.slint";
import { PendingRequestItem } from "../types.slint";
import { Badge } from "../base/feedback/badge.slint";
import { Text } from "../base/text/base_text.slint";
import { Button } from "../base/buttons/button.slint";
import { Card } from "../base/layout/card.slint";

// Approval card docked above the compose bar.
//
// Model: Zed-style one-of select (`PermissionOptions::Flat`).
// Surface uses Theme.bg-approval (+ accent rail) so it reads apart from
// ordinary cards, chat, and the compose bar — still monochrome.
export component PermissionCard inherits Card {
    in property <PendingRequestItem> item;
    callback option-selected(string /* option-id */);
    callback approve();
    callback reject();

    vertical-stretch: 0;
    horizontal-stretch: 1;
    bg: "primary";
    bordered: true;
    border: "default";
    border-col: Theme.border-approval;
    shadow: "sm";
    pad: 0px;
    // Distinct approval fill — not bg-card.
    background: Theme.bg-approval;
    clip: true;
    // Root-cause fix (docked-band full-height bug): this card is placed
    // inside a `HorizontalLayout` in chat_area.slint (the approval band
    // row). A `HorizontalLayout`'s cross axis (height, since its main
    // axis is horizontal) stretches children to fill the row's resolved
    // height by default -- unlike `vertical-stretch`, which only opts a
    // child out of *its own* leftover-space share along a VerticalLayout's
    // main axis, there's no equivalent per-child opt-out for cross-axis
    // fill on a plain `Rectangle` (confirmed: `vertical-alignment` isn't a
    // property Rectangle exposes -- that's Text/Image content alignment,
    // not layout cross-axis control). So whenever the row ends up
    // resolving to a height taller than this card's own content actually
    // needs, the card silently stretched to fill the leftover space
    // instead of hugging its content -- the "sometimes full height" bug.
    // Explicitly binding `height` to `self.preferred-height` (itself
    // auto-computed bottom-up from the VerticalLayout below, which is the
    // one true source of this card's content height) makes the layout
    // solver treat this as an explicit height rather than a
    // stretch-to-fill target, so the card always hugs its real content
    // height regardless of what the enclosing row computes.
    height: self.preferred-height;

    pure function kind-glyph(kind: string) -> string {
        if (kind == "allow_always") {
            return "\u{2714}\u{2714}";
        }
        if (kind == "allow_once" || kind == "approve") {
            return "\u{2713}";
        }
        if (kind == "reject_always") {
            return "\u{2717}\u{2717}";
        }
        return "\u{2717}";
    }

    Rectangle {
        width: 100%;
        height: content.preferred-height;

        // Leading primary accent rail — “needs decision” marker.
        Rectangle {
            x: 0px;
            y: 0px;
            width: 3px;
            height: parent.height;
            background: Theme.bg-primary;
            border-radius: Theme.radius-md;
            // Only round the left corners so the rail meets the card edge.
            // (Full radius on a 3px strip is fine — reads as a solid bar.)
        }

        content := VerticalLayout {
            width: 100%;
            // Clear the 3px rail.
            padding-left: Metrics.pad-md + 3px;
            padding-right: Metrics.pad-md;
            padding-top: Metrics.pad-sm;
            padding-bottom: Metrics.pad-sm;
            spacing: Metrics.gap-sm;
            alignment: start;

            HorizontalLayout {
                width: 100%;
                height: 18px;
                preferred-height: 18px;
                vertical-stretch: 0;
                spacing: Metrics.gap-sm;
                alignment: stretch;
                cross-axis-alignment: center;
                Text {
                    text: "\u{26A0}";
                    color: Theme.bg-primary;
                    size: "sm";
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                Text {
                    text: item.title;
                    color: Theme.text-primary;
                    size: "sm";
                    weight: "bold";
                    horizontal-stretch: 1;
                    preferred-width: 0px;
                    min-width: 0px;
                    overflow: elide;
                    vertical-alignment: center;
                }
                // Small pill so “approval” is labeled even at a glance.
                Badge {
                    horizontal-stretch: 0;
                    height: 16px;
                    label: "Approval";
                    bg: Theme.bg-primary-container;
                    font-size: 8px;
                    badge-font-weight: 700;
                    pad-h: Metrics.space-2;
                    pad-v: 0px;
                }
                Text {
                    text: item.method;
                    color: Theme.text-muted;
                    font-family: Theme.font-mono;
                    size: "xs";
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
            }

            Text {
                text: item.summary;
                color: Theme.text-secondary;
                size: "sm";
                wrap: word-wrap;
                overflow: elide;
                max-height: 32px;
                vertical-stretch: 0;
            }

            if item.supported && item.options.length > 0 : VerticalLayout {
                width: 100%;
                spacing: Metrics.space-1;
                vertical-stretch: 0;
                alignment: start;
                for opt in item.options : Button {
                    label: root.kind-glyph(opt.kind) + "  " + opt.name;
                    button-accessible-label: opt.name == "Approve" ? "Approve request"
                        : (opt.name == "Reject" ? "Reject request"
                            : ("Permission option: " + opt.name));
                    primary: opt.is-allow;
                    width: 100%;
                    btn-height: 24px;
                    font-size: 10px;
                    font-weight: opt.is-allow ? 700 : 600;
                    bg: opt.is-allow ? Theme.bg-primary : Theme.bg-primary-container.with-alpha(0.55);
                    fg: opt.is-allow ? Theme.text-on-primary : Theme.text-primary;
                    border-col: Theme.border-default;
                    border-w: opt.is-allow ? 0px : 1px;
                    clicked => { root.option-selected(opt.option-id); }
                }
            }

            if item.supported && item.options.length == 0 : Text {
                text: "No options offered for this request.";
                color: Theme.text-muted;
                size: "sm";
                font-italic: true;
                wrap: word-wrap;
                vertical-stretch: 0;
            }

            if !item.supported : Text {
                text: "This request kind isn't supported yet.";
                color: Theme.text-muted;
                size: "sm";
                font-italic: true;
                wrap: word-wrap;
                vertical-stretch: 0;
            }
        }
    }
}
