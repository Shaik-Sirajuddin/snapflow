import { Theme } from "../tokens/theme.slint";
import { Strings } from "../tokens/strings.slint";
import { Metrics } from "../tokens/metrics.slint";
import { Badge } from "../base/feedback/badge.slint";
import { TerminalLogBlock } from "../base/terminal/terminal_log_block.slint";
import { MessageItem } from "../types.slint";
import { HoverSurface } from "../base/hover.slint";
import { Text } from "../base/text/base_text.slint";
import { Card } from "../base/layout/card.slint";

// Agent / thinking / legacy tool-call card.
// Styling on top of the working baseline:
// - Agent: no "AGENT" label, no border, elevated fill, 3-corner radius
// - Thinking: transparent, small pad
// - Body keeps Flickable + preferred-height (baseline-stable)
// - Empty layout spacers must not fill parent height (Slint skill)
export component MessageCard inherits Card {
    in property <MessageItem> item;
    callback toggle-expanded(int);

    property <bool> is-user: item.kind == "user";
    property <bool> is-agent: item.kind == "agent";
    property <bool> is-tool-call: item.kind == "tool-call";
    property <bool> is-thinking: item.kind == "thinking";
    property <string> header-label: is-user ? Strings.user : is-agent ? Strings.agent : is-thinking ? Strings.thinking-label : Strings.tool-label;

    vertical-stretch: 0;
    clip: true;

    // Agent: subtle Theme.bg-agent-bubble (not primary-container).
    bg: is-thinking ? "secondary" : is-user ? "secondary" : is-tool-call ? "secondary" : is-agent ? "secondary" : "primary";
    radius: "lg";
    bordered: is-tool-call;
    border: "strong";
    border-col: is-tool-call ? Theme.border-strong : Theme.border-default;
    pad: is-thinking ? Metrics.space-2 : is-agent ? Metrics.space-4 : Metrics.space-5;

    // Preserve message-specific bubble roles; Card's enum intentionally does
    // not replace these domain colors.
    background: is-thinking ? transparent
        : is-user ? Theme.bg-user-bubble
        : is-tool-call ? Theme.bg-agent-bubble
        : is-agent ? Theme.bg-tertiary
        : Theme.bg-primary-container;

    border-top-left-radius: is-thinking ? 0px : Theme.radius-lg;
    border-top-right-radius: is-thinking ? 0px : Theme.radius-lg;
    border-bottom-left-radius: is-thinking ? 0px
        : is-agent ? Metrics.radius-corner-cut
        : Theme.radius-lg;
    border-bottom-right-radius: is-thinking ? 0px
        : is-user ? Metrics.radius-corner-cut
        : Theme.radius-lg;

    VerticalLayout {
        padding: 0px;
        spacing: Metrics.space-3;

        // No header for agent messages. Tool-call rows are status-only --
        // no separate "TOOL" label box next to the status: a boxed kicker
        // label paired with a status badge read as two competing pieces
        // of chrome for what is really one status.
        if !is-agent : HorizontalLayout {
            spacing: Metrics.space-3;
            if !is-tool-call : Text {
                text: header-label;
                font-family: Theme.font-mono;
                size: "xs";
                weight: "bold";
                letter-spacing: 0.5px;
                color: Theme.text-muted;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
            if is-tool-call && item.status != "" : Badge {
                label: item.status;
            }
            // Horizontal-only spacer (empty rect fills parent by default).
            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 0;
                height: 0px;
                preferred-height: 0px;
            }
        }

        // `interactive: false`: this Flickable is a layout boundary
        // (height == viewport-height, nothing pans), not a scroller --
        // see markdown_view.slint's overlay doc comment. Releasing its
        // drag capture lets `body-text`'s native click-drag selection
        // through.
        if !is-tool-call : Flickable {
            interactive: false;
            height: body-text.preferred-height;
            viewport-height: body-text.preferred-height;
            horizontal-stretch: 1;
            preferred-width: 0px;
            min-width: 0px;
            body-text := TextInput {
                text: item.text;
                font-italic: is-thinking;
                font-family: Theme.font-sans;
                font-size: (is-thinking ? 11px : 12px) * Theme.font-scale;
                color: is-user ? Theme.text-user-bubble
                    : is-thinking ? Theme.text-muted
                    : Theme.text-primary;
                read-only: true;
                wrap: word-wrap;
                horizontal-alignment: left;
                vertical-alignment: top;
                width: parent.width;
                selection-foreground-color: Theme.text-primary;
                selection-background-color: Theme.selection-bg;
            }
        }

        if is-tool-call : HoverSurface {
            button-accessible-label: item.expanded ? "Hide logs" : "Show logs";
            clicked => { toggle-expanded(item.index); }
            VerticalLayout {
                spacing: Metrics.space-3;
                HorizontalLayout {
                    spacing: Metrics.space-3;
                    Text {
                        text: item.text;
                        weight: "semibold";
                        color: Theme.text-primary;
                        wrap: word-wrap;
                        overflow: elide;
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                        min-width: 0px;
                    }
                    Text {
                        text: item.expanded ? "[-] hide logs" : "[+] show logs";
                        font-family: Theme.font-mono;
                        size: "xs";
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        vertical-stretch: 0;
                        height: 0px;
                        preferred-height: 0px;
                    }
                }
                if item.expanded : TerminalLogBlock {
                    text: item.text;
                    content-padding: Metrics.space-4;
                    scrollable: false;
                    text-overflow: elide;
                }
            }
        }
    }
}
