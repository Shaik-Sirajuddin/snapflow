// Rough visual mockup for settings-pane-redesign.md -- NOT wired to real
// data, NOT the final component split (see that plan's "Component layout"
// section for the real ui/components/settings/*.slint breakdown). Just
// enough structure (top tabs, left tabs, search bar, two sample rows per
// tab) to eyeball the layout live via slint-viewer --auto-reload before
// committing to the real component split.
import { Theme } from "tokens/theme.slint";
import { Metrics } from "tokens/metrics.slint";
import { Strings } from "tokens/strings.slint";
import { Button } from "base/buttons/button.slint";
import { SettingsSearchBar } from "pages/settings/components/search_bar.slint";
import { Text } from "base/text/base_text.slint";
import { Divider } from "base/layout/divider.slint";

export component SettingsPanePreview inherits Window {
    preferred-width: 720px;
    preferred-height: 480px;
    title: "Settings Pane -- rough preview";
    default-font-family: Theme.font-sans;
    background: Theme.bg-canvas;

    property <string> active-scope: "project"; // "project" | "global"
    property <string> active-section: "mcp"; // "mcp" | "agents"
    property <string> search-query: "";

    VerticalLayout {
        padding: Metrics.space-7;
        spacing: Metrics.space-6;

        // Top tabs -- [Project | Global]
        HorizontalLayout {
            spacing: Metrics.space-4;
            height: 32px;
            for tab[i] in [{ id: "project", label: Strings.project }, { id: "global", label: Strings.global }] : Button {
                label: tab.label;
                btn-width: 100px;
                btn-height: 32px;
                bg: active-scope == tab.id ? Theme.bg-primary-container : transparent;
                fg: active-scope == tab.id ? Theme.text-on-primary-container : Theme.text-secondary;
                border-w: active-scope == tab.id ? 0px : 1px;
                border-col: Theme.border-default;
                font-size: 12px;
                font-weight: 600;
                clicked => { active-scope = tab.id; }
            }
        }

        Divider { }

        HorizontalLayout {
            spacing: Metrics.space-6;

            // Left tabs -- section rail
            VerticalLayout {
                width: 160px;
                spacing: Metrics.space-2;
                for section[i] in [{ id: "mcp", label: Strings.mcp-servers }, { id: "agents", label: Strings.agents }] : Button {
                    label: section.label;
                    btn-width: 160px;
                    btn-height: 32px;
                    bg: active-section == section.id ? Theme.bg-sidebar : transparent;
                    fg: active-section == section.id ? Theme.text-primary : Theme.text-secondary;
                    border-w: 0px;
                    font-size: 12px;
                    font-weight: active-section == section.id ? 600 : 400;
                    clicked => { active-section = section.id; }
                }
            }

            Rectangle { width: 1px; background: Theme.border-default; }

            // Content area: search bar + two sample rows for the active section
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Metrics.space-6;

                SettingsSearchBar {
                    width: 100%;
                    query <=> search-query;
                }

                if active-section == "mcp" : VerticalLayout {
                    spacing: Metrics.space-5;

                    // Sample row 1: text-value row
                    HorizontalLayout {
                        height: 40px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text { text: Strings.default-command-timeout; color: Theme.text-primary; weight: "semibold"; }
                            Text { text: Strings.seconds-before-mcp-stalled; color: Theme.text-muted; size: "sm"; }
                        }
                        Rectangle {
                            width: 60px;
                            height: 26px;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-default;
                            Text { text: "30s"; color: Theme.text-primary; size: "sm"; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }

                    // Sample row 2: toggle row
                    HorizontalLayout {
                        height: 40px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text { text: Strings.auto-restart-on-failure; color: Theme.text-primary; weight: "semibold"; }
                            Text { text: Strings.relaunch-crashed-mcp; color: Theme.text-muted; size: "sm"; }
                        }
                        property <bool> checked: true;
                        Rectangle {
                            width: 36px;
                            height: 20px;
                            border-radius: 10px;
                            background: checked ? Theme.bg-primary : Theme.bg-sidebar;
                            border-width: 1px;
                            border-color: Theme.border-default;
                            Rectangle {
                                width: 14px;
                                height: 14px;
                                border-radius: 7px;
                                background: checked ? Theme.text-on-primary : Theme.text-muted;
                                x: checked ? parent.width - self.width - 3px : 3px;
                                y: 3px;
                                animate x { duration: 100ms; }
                            }
                            TouchArea { mouse-cursor: pointer; clicked => { checked = !checked; } }
                        }
                    }
                }

                if active-section == "agents" : VerticalLayout {
                    spacing: Metrics.space-5;

                    // Sample row 1: default agent picker (text stand-in)
                    HorizontalLayout {
                        height: 40px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text { text: Strings.default-agent; color: Theme.text-primary; weight: "semibold"; }
                            Text { text: Strings.used-when-no-agent-specified; color: Theme.text-muted; size: "sm"; }
                        }
                        Rectangle {
                            width: 100px;
                            height: 26px;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-default;
                            Text { text: "codex"; color: Theme.text-primary; size: "sm"; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }

                    // Sample row 2: installable agent row with install button
                    HorizontalLayout {
                        height: 40px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text { text: "claude-code (installable)"; color: Theme.text-primary; weight: "semibold"; }
                            Text { text: Strings.not-yet-installed; color: Theme.text-muted; size: "sm"; }
                        }
                        Button { label: Strings.install; btn-width: 64px; }
                    }
                }
            }
        }
    }
}
