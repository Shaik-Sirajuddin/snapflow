import { Theme } from "../tokens/theme.slint";
import { Metrics } from "../tokens/metrics.slint";

// Common reusable auto-hiding thin scrollbar component for chat-view and scrollable blocks.
// - Width minimized (default 4px)
// - Fades out smoothly when not actively scrolling or hovered
// - Drag & click position tracking supported
//
// Vertical by default (original chat-view usage: viewport-height/
// visible-height/viewport-y). Set `horizontal: true` to lay the same
// thumb out along the x-axis instead (viewport-width/visible-width/
// viewport-x) -- e.g. the compose bar's row2 selector strip
// (chat_input_layout.slint) on a narrow dock, so a horizontally-scrollable
// row gets the same visible/consistent scrollbar affordance as the
// message list rather than a bespoke one-off.
export component ThinScrollbar inherits Rectangle {
    in property <bool> horizontal: false;
    // Vertical-axis extents (used when `horizontal` is false).
    in property <length> viewport-height: 1px;
    in property <length> visible-height: 1px;
    in-out property <length> viewport-y: 0px;
    // Horizontal-axis extents (used when `horizontal` is true).
    in property <length> viewport-width: 1px;
    in property <length> visible-width: 1px;
    in-out property <length> viewport-x: 0px;
    in property <length> thumb-width: 4px;
    in property <bool> active: false;

    property <length> extent: root.horizontal ? root.viewport-width : root.viewport-height;
    property <length> visible-extent: root.horizontal ? root.visible-width : root.visible-height;
    property <length> offset: root.horizontal ? root.viewport-x : root.viewport-y;

    property <bool> is-overflowing: root.extent > root.visible-extent;
    property <length> thumb-len: max(24px, root.visible-extent * (root.visible-extent / max(1px, root.extent)));
    property <length> max-travel: max(1px, root.visible-extent - root.thumb-len);
    property <length> scroll-range: max(1px, root.extent - root.visible-extent);
    property <length> thumb-pos: (- root.offset) * (root.max-travel / root.scroll-range);

    // Cross-axis extent = the caller-supplied visible-* dimension (the
    // same value already driving the thumb-position math below), so the
    // box's real geometry always matches what the ratio math assumes.
    // Main-axis (scroll direction) is fixed to thumb-width.
    width: root.horizontal ? root.visible-width : root.thumb-width;
    height: root.horizontal ? root.thumb-width : root.visible-height;
    visible: root.is-overflowing;

    // Fades out completely during non-scroll idle
    opacity: (root.active || touch.has-hover) ? 1.0 : 0.0;
    animate opacity { duration: 300ms; easing: ease-out; }

    Rectangle {
        x: root.horizontal ? min(root.max-travel, max(0px, root.thumb-pos)) : 0px;
        y: root.horizontal ? 0px : min(root.max-travel, max(0px, root.thumb-pos));
        width: root.horizontal ? root.thumb-len : root.thumb-width;
        height: root.horizontal ? root.thumb-width : root.thumb-len;
        border-radius: root.thumb-width / 2;
        background: touch.has-hover ? Theme.text-primary : Theme.text-muted.with-alpha(0.5);
        animate background { duration: 150ms; }
    }

    touch := TouchArea {
        width: root.horizontal ? parent.width : root.thumb-width + 6px;
        height: root.horizontal ? root.thumb-width + 6px : parent.height;
        x: root.horizontal ? 0px : - 3px;
        y: root.horizontal ? - 3px : 0px;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down || event.kind == PointerEventKind.move) {
                if (root.horizontal) {
                    let target-x = self.mouse-x - (root.thumb-len / 2);
                    let ratio = max(0.0, min(1.0, target-x / root.max-travel));
                    root.viewport-x = - (ratio * root.scroll-range);
                } else {
                    let target-y = self.mouse-y - (root.thumb-len / 2);
                    let ratio = max(0.0, min(1.0, target-y / root.max-travel));
                    root.viewport-y = - (ratio * root.scroll-range);
                }
            }
        }
    }
}
