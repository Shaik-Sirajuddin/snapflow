import { Theme } from "../../tokens/theme.slint";
import { Strings } from "../../tokens/strings.slint";
import { CursorHost } from "../../tokens/cursor_host.slint";

// Session context usage indicator -- circular ring + percentage.
// Hover reveals a small card with used/full token counts.
// Ratio is 0.0..1.0; token counts are display-only (Rust/host may leave
// them at 0 until real session accounting is wired).
//
// The hover card itself is rendered by the host (chat_input_layout.slint),
// NOT here. It used to live inline as a child of this component, painted
// UPWARD out of the 24px band the same way SearchableDropdown's popup does
// -- which required the row-2 pan host to flip its `clip` off entirely
// whenever `has-hover` was true (context_ring_hover_left_overflow). That
// host also horizontally pans an overflowing control strip to keep the
// trailing ring reachable; disabling clip for the card also unclipped
// whatever OTHER controls (Provider/Mode/etc.) were currently panned out
// of view to the left, so they rendered past the panel's own left edge,
// overlapping the sidebar's Settings footer underneath. Exposing `pct` /
// `ring-color` (`out`, not private) lets the host render the card as its
// own top-level, absolute-positioned sibling instead -- same pattern as
// this composer's `/`/`@`/`#` mention popup -- so it never needs the pan
// host's clip disabled at all.
export component ContextRing inherits Rectangle {
    in property <float> ratio: 0.0;
    in property <int> used-tokens: 0;
    in property <int> limit-tokens: 0;
    // Default size matches SearchableDropdown (24px) so both compose-row
    // controls share the same geometric center when the parent uses
    // cross-axis-alignment: center.
    in property <length> size: 24px;
    // Opens the future context-breakdown surface (host may no-op).
    callback context-view-requested();
    // Read by the host to know when to show its own hover card overlay.
    out property <bool> has-hover: hit.has-hover;

    out property <int> pct: Math.round(Math.min(1.0, Math.max(0.0, ratio)) * 100);
    out property <color> ring-color:
        pct >= 90 ? Theme.text-secondary
        : pct >= 70 ? Theme.bg-primary
        : Theme.text-muted;

    width: size;
    height: size;
    preferred-width: size;
    preferred-height: size;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    // Inset for the percentage so it doesn't touch the ring stroke.
    property <length> num-pad: size * 0.18;

    // Track (full circle).
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: Theme.border-default;
        background: transparent;
    }
    // Soft fill disc that grows with usage (readable stand-in for a true
    // arc until Path arc math is worth the complexity).
    Rectangle {
        width: parent.width * Math.min(1.0, Math.max(0.05, ratio));
        height: parent.height * Math.min(1.0, Math.max(0.05, ratio));
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: root.ring-color.with-alpha(0.18);
    }
    // Outer accent ring.
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: root.ring-color.with-alpha(0.35 + 0.55 * Math.min(1.0, ratio));
        background: transparent;
    }
    // Percentage — smaller type + padded inset so it clears the ring.
    Text {
        text: root.pct + "%";
        color: Theme.text-primary;
        font-size: 6px * Theme.font-scale;
        font-weight: 600;
        font-family: Theme.font-mono;
        horizontal-alignment: center;
        vertical-alignment: center;
        x: root.num-pad;
        y: root.num-pad;
        width: parent.width - 2 * root.num-pad;
        height: parent.height - 2 * root.num-pad;
    }

    // Fill the 24×24 ring — without explicit size the hit target can collapse
    // to zero and has-hover never fires (compose-row hover broken).
    hit := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: Strings.session-context + " " + root.pct + " percent";
        accessible-action-default => { root.context-view-requested(); }
        clicked => { root.context-view-requested(); }
        changed has-hover => {
            CursorHost.kind = self.has-hover ? "pointer" : "default";
        }
    }
}
