// Layer 3 (base) -- a full-bleed backdrop that catches clicks outside
// caller-supplied modal content. Children are layered above the backdrop;
// modal content can include its own TouchArea to intercept those clicks.
export component ModalScrim inherits Rectangle {
    in property <string> shade: "md";
    callback clicked();

    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: shade == "sm" ? #00000040
        : shade == "lg" ? #00000088
        : #00000080;

    TouchArea {
        clicked => { root.clicked(); }
    }

    @children
}
