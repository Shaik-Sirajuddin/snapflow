import { Theme } from "../../tokens/theme.slint";
import { Metrics } from "../../tokens/metrics.slint";

// Layer 3 (base) -- real indeterminate circular loading spinner. No
// equivalent existed anywhere in this codebase before it (grepped for
// "rotation-angle"/"Spinner"/"loading" across every base/ and page/
// component -- the closest thing, `AgentCatalogEntry.loading`, turns out
// to be dead: `models.rs`'s `to_agent_catalog_entry_rows(agents, &[])`
// always passes an empty `loading_ids` slice, so nothing ever populates
// it).
//
// Technique mirrors Slint's own shipped `widgets/common/spinner-base.
// slint` (real vendored source, confirmed by reading it directly, not
// guessed): a `Path` with a `MoveTo`/`ArcTo` sequence tracing a partial
// ring, whose start angle and sweep length are both driven by
// `animation-tick()` -- a builtin that returns elapsed animation time,
// usable directly in a property binding with no `animate` block and no
// `Timer` needed. This is what makes it a real, continuously-animating
// spinner rather than a static icon: `animation-tick()` keeps advancing
// on its own as long as something on screen reads it, so the `mod(...)`
// expression below cycles smoothly and indefinitely.
//
// Deliberately not built on Slint's std-widgets `Spinner`/
// `ProgressIndicator` -- this app's `base/` layer hand-rolls every
// control itself (Button, Toggle, TextField, ...), no std-widgets
// dependency exists anywhere else to introduce one just for this.
//
// Deliberately draws in plain pixel coordinates with NO `viewbox-width`/
// `viewbox-height` on the `Path` -- a first version used a 100x100
// viewbox plus a `stroke-width: root.stroke-width / root.size * 100 *
// 1px` ratio to convert a physical stroke width into viewbox units. That
// rendered fine as a direct child of a `*Layout`, but silently painted
// *nothing* the moment the Spinner was nested inside a plain (non-layout)
// `Rectangle` -- exactly `Button`'s own shape (`Button inherits
// Rectangle`), found empirically while wiring this into `Button.busy`:
// a static Path with a literal `stroke-width` rendered fine in that same
// non-layout nesting, but re-introducing the ratio formula reproduced the
// blank render every time, isolated with a from-scratch repro file (not
// guessed) via `slint-viewer --screenshot`. Root cause not fully
// diagnosed (looks like a real Slint quirk resolving a `Path` geometry
// binding that reaches two scopes up to `root.size` while both the Path's
// own parent and grandparent are non-layout elements), but computing
// `radius`/`center` directly in pixels against the Path's own
// `width`/`height` (`root` here means the Path itself, not the outer
// Spinner) and never allocating a `viewbox-*`/ratio at all sidesteps it
// entirely -- confirmed by re-running the exact same nested-under-
// Rectangle repro with this version.
export component Spinner inherits Rectangle {
    in property <length> size: 14px;
    in property <brush> stroke: Theme.text-muted;
    in property <length> stroke-width: 2px;

    width: root.size;
    height: root.size;

    Path {
        width: root.width;
        height: root.height;
        stroke: root.stroke;
        stroke-width: root.stroke-width;

        property <float> radius-px: (root.width / 1px - root.stroke-width / 1px) / 2;
        property <float> center-px: root.width / 1px / 2;
        // One full revolution every 1.2s. `mod(animation-tick(), 1.2s) /
        // 1.2s` is a real Slint idiom (same shape Slint's own
        // spinner-base.slint uses for its `start`/`progress` properties)
        // -- it re-evaluates on every frame as `animation-tick()`
        // advances, producing a smooth 0.0..1.0 sawtooth with no Timer
        // and no explicit `animate` block.
        property <float> start: mod(animation-tick(), Metrics.pulse-period) / Metrics.pulse-period;
        // A fixed ~0.75 revolution arc (not a full circle) so the
        // rotation is actually visible as motion rather than reading as
        // a static ring -- same "partial arc chasing itself" silhouette
        // as most real spinners (browser `<progress>` indeterminate
        // state, OS-native spinners, Slint's own indeterminate
        // `ProgressIndicator`).
        property <float> sweep: 0.75;

        MoveTo {
            x: center-px - radius-px * sin(-(start - 0.001) * 360deg);
            y: center-px - radius-px * cos(-(start - 0.001) * 360deg);
        }
        ArcTo {
            radius-x: radius-px;
            radius-y: radius-px;
            x: center-px - radius-px * sin(-(start + sweep) * 360deg);
            y: center-px - radius-px * cos(-(start + sweep) * 360deg);
            sweep: true;
            large-arc: sweep > 0.5;
        }
    }
}
