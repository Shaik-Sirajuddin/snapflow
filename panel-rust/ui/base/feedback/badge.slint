import { Theme } from "../../tokens/theme.slint";

// Layer 3 (base) -- the repeated "status badge/chip" pattern: a small
// bordered rounded box with small text, no click behavior (see
// `message_card.slint`'s tool-call status badge). Deliberately
// non-interactive -- unlike `Button`, it never wraps a `TouchArea`.
export component Badge inherits Rectangle {
    in property <string> label;
    in property <string> size: "md";
    in property <string> variant: "neutral";
    in property <color> bg: variant == "primary" ? Theme.bg-primary
        : variant == "secondary" ? Theme.bg-primary-container
        : variant == "danger" ? Theme.status-error.with-alpha(0.18)
        : variant == "success" ? Theme.status-success.with-alpha(0.18)
        : variant == "warning" ? Theme.status-warning.with-alpha(0.18)
        : Theme.bg-sidebar;
    in property <color> fg: variant == "primary" ? Theme.text-on-primary
        : variant == "danger" ? Theme.text-danger
        : variant == "success" ? Theme.text-success
        : variant == "warning" ? Theme.text-warning
        : Theme.text-secondary;
    in property <color> border-col: variant == "primary" ? Theme.bg-primary
        : variant == "danger" ? Theme.status-error
        : variant == "success" ? Theme.status-success
        : variant == "warning" ? Theme.status-warning
        : Theme.border-default;
    in property <length> border-w: 1px;
    in property <length> font-size: size == "sm" ? 8px : size == "lg" ? 10px : 9px;
    in property <string> badge-font-family: Theme.font-mono;
    in property <int> badge-font-weight: 400;
    in property <length> pad-h: size == "sm" ? 4px : size == "lg" ? 8px : 6px;
    in property <length> pad-v: size == "lg" ? 3px : 2px;

    background: bg;
    border-color: border-col;
    border-width: border-w;
    border-radius: Theme.radius-sm;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    HorizontalLayout {
        alignment: start;
        padding-left: pad-h;
        padding-right: pad-h;
        padding-top: pad-v;
        padding-bottom: pad-v;
        Text {
            text: root.label;
            color: root.fg;
            font-family: root.badge-font-family;
            font-size: root.font-size * Theme.font-scale;
            font-weight: root.badge-font-weight;
            vertical-alignment: center;
        }
    }
}
