import { Theme } from "../../tokens/theme.slint";
import { Metrics } from "../../tokens/metrics.slint";
import { CursorHost } from "../../tokens/cursor_host.slint";

// Layer 3 (base) -- the repeated hand-rolled "icon-only hover button"
// pattern found across `sidebar.slint` (collapse toggle, new-thread,
// settings-bar): a square/rect `Rectangle` whose background tints on
// hover, a sibling `TouchArea` (accessible-role/label/action/clicked),
// pointer cursor, and caller-supplied icon content via `@children`.
// Distinct from `Button` (fixed-size pill with a text label) -- this one
// has no label of its own and sizes to whatever's passed in.
export component IconButton inherits Rectangle {
    in property <string> button-accessible-label;
    // Size is the primary API. md intentionally remains the existing 24px
    // hit target for compatibility; Metrics.icon-md is 16px and is used by
    // the other icon-sized tiers. Raw dimensions remain escape hatches for
    // existing non-square or otherwise bespoke callers.
    in property <string> size: "md";
    in property <length> btn-width: size == "sm" ? Metrics.icon-sm : size == "lg" ? Metrics.icon-lg : 24px;
    in property <length> btn-height: size == "sm" ? Metrics.icon-sm : size == "lg" ? Metrics.icon-lg : 24px;
    // Sticky "on" state (e.g. a toggle whose panel is currently open) --
    // renders the same tint as `has-hover` even while the pointer isn't
    // over the button, so a caller can show both states with the one
    // primitive instead of re-deriving the hover tint itself.
    in property <bool> active: false;
    in property <bool> enabled: true;
    out property <bool> has-hover: touch.has-hover;
    callback clicked();

    width: btn-width;
    height: btn-height;
    // Fixed hit target: never let stretch layouts (sidebar title rows,
    // header bars) steal space from these and squeeze the icon away.
    // (Slint forbids min-width alongside an explicit width, so stretch
    // zero is the lever that keeps preferred size.)
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.radius-sm;
    opacity: enabled ? 1.0 : 0.45;
    background: (enabled && (active || touch.has-hover)) ? Theme.bg-primary-container : transparent;
    animate background { duration: 100ms; }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: root.button-accessible-label;
        accessible-action-default => { root.clicked(); }
        clicked => { root.clicked(); }
        changed has-hover => { CursorHost.kind = self.has-hover ? "pointer" : "default"; }
    }
    // Center icon/glyph on both axes so header rows share one baseline
    // with adjacent Text (e.g. sidebar "Chats" + collapse/new buttons).
    VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            @children
        }
    }
}
