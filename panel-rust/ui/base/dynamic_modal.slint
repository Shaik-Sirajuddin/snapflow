import { Theme } from "../tokens/theme.slint";
import { Metrics } from "../tokens/metrics.slint";
import { Icon } from "./icon.slint";

// Dynamic modal/popup component that accepts arbitrary child content via @children.
// Provides: backdrop overlay, modal container, header with title + close button, scrollable content area.
// Any component can render itself in this modal by passing content as children.
export component DynamicModal inherits Rectangle {
    in property <string> title: "";
    in property <bool> is-mcp: false;
    in property <bool> show-icon: true;
    in property <length> modal-width: 720px;
    in property <length> modal-height: 520px;
    in property <bool> open: true;
    callback closed();

    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    visible: open;
    background: #00000040;

    TouchArea {
        clicked => { closed(); }
    }

    Rectangle {
        x: max(10px, (parent.width - modal-width) / 2);
        y: max(10px, (parent.height - modal-height) / 2);
        width: min(parent.width - 20px, modal-width);
        height: min(parent.height - 20px, modal-height);
        background: transparent;
        border-color: transparent;
        border-width: 0px;
        border-radius: 0px;

        TouchArea {
            // Intercept clicks on dialog card body so backdrop touch doesn't close
        }

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // Header Bar
            HorizontalLayout {
                spacing: Metrics.space-2;
                padding: Metrics.space-3;
                if show-icon : Icon {
                    source: is-mcp ? @image-url("../assets/icons/plug-zap.svg") : @image-url("../assets/icons/wrench.svg");
                    size: 16px;
                    color: Theme.text-primary;
                }
                Text {
                    text: title != "" ? title : "FULL VIEW";
                    font-family: Theme.font-mono;
                    font-size: 11px * Theme.font-scale;
                    font-weight: 700;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; height: 0px; }
                TouchArea {
                    width: 20px;
                    height: 20px;
                    mouse-cursor: pointer;
                    clicked => { closed(); }
                    Text {
                        text: "\u{2715}";
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Flickable {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                viewport-height: modal-content.preferred-height;

                modal-content := VerticalLayout {
                    padding: Metrics.space-3;
                    spacing: Metrics.space-2;
                    @children
                }
            }
        }
    }
}
