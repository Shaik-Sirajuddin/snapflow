import { Theme } from "../tokens/theme.slint";

// Layer 3 (base) -- reusable status dot indicator for connection and state markers.
// Encapsulates status color mapping ("connected" -> green, "error"/"disconnected" -> red,
// other -> yellow) and circular radius scaling.
export component StatusDot inherits Rectangle {
    in property <string> status: "connected";
    in property <length> size: 8px;

    width: size;
    height: size;
    border-radius: size / 2;
    background: status == "connected" ? Theme.status-success
        : (status == "error" || status == "disconnected") ? Theme.status-error
        : Theme.status-warning;
}
