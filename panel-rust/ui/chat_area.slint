import { Theme } from "./tokens/theme.slint";
import { Metrics } from "./tokens/metrics.slint";
import { Icon } from "./base/icon.slint";
import { CursorHost } from "./tokens/cursor_host.slint";
import { SelectionFocus } from "./tokens/selection_focus.slint";
import { IconButton } from "./base/icon_button.slint";
import { MessageItem, ToolGroupItem, PendingRequestItem, TerminalItem, DropdownEntry, LocalTerminalItem, SkillOption, McpServerOption, PlanEntryItem } from "./types.slint";
import { MessageCard } from "./components/message_card.slint";
import { ChatInputLayout } from "./components/chat_input_layout.slint";
import { UserBubble } from "./chat-view/components/message/user_bubble.slint";
import { AgentBubble } from "./chat-view/components/message/agent_bubble.slint";
import { QueuedMessageBar } from "./chat-view/components/message/queued_message_bar.slint";
import { PendingStatusRow } from "./chat-view/components/message/pending_status_row.slint";
import { ToolEventRow } from "./chat-view/components/message/tool_event_row.slint";
import { ToolGroupView } from "./chat-view/components/message/tool_group_view.slint";
import { Spinner } from "./base/spinner.slint";
import { PermissionCard } from "./components/permission_card.slint";
import { LocalTerminalCard } from "./components/local_terminal_card.slint";
// PUI-002b: reuse the same boxed-row primitive the @/#/skill mention
// popups already use (`chat_input_layout.slint`) instead of hand-rolling
// a new list-row component for the terminals popup.
import { MentionPickRow } from "./base/mention_pick_row.slint";
import { ThinScrollbar } from "./base/thin_scrollbar.slint";
import { ApiCallView } from "./chat-view/components/execution/api_call_view.slint";
import { TerminalView } from "./chat-view/components/execution/terminal_view.slint";
import { OnboardingGuideView } from "./chat-view/components/onboarding_guide_view.slint";

// Header + message stream + compose bar -- Phase 3 of
// chat-panel-ui-theme-parity.md. Visual source: ui_html/index.html's
// "Thread Header" section (icon/title/desc/agent chip/layout label) and
// "Input Area" section (textarea look, state dot, hint text, Send
// Command button). v1 fixes on the HTML's "ltr" bubble alignment (user
// right, everything else left) -- see `message_card.slint`'s doc comment
// for why tool-call gets the richer timeline-style card instead of the
// bubble layout's flat text dump.
export component ChatArea inherits Rectangle {
    in-out property <bool> onboarding-completed: false;
    callback complete-onboarding();
    // Retained-view command generations. A stack host can address the
    // selected ChatArea without invoking methods on hidden delegates.
    in property <int> focus-command: 0;
    in property <int> approve-command: 0;
    in property <int> reject-command: 0;
    in property <string> active-thread-name: "";
    in property <string> active-thread-description: "";
    // The active thread's effective background-session mode -- drives the
    // header toggle's active state; flipping it re-runs the same per-thread
    // override the settings sheet writes.
    in property <bool> active-thread-background: false;
    callback toggle-background();
    in property <[MessageItem]> messages: [];
    in property <[ToolGroupItem]> tool-groups: [];
    // Phase 3 step 2: an upward user scroll which reaches the actual top
    // boundary asks Rust to prepend the next local JSONL page. The visible
    // button remains as an accessible fallback for keyboard/screen-reader
    // users and for a very short transcript with no scroll range.
    in property <bool> has-older-messages: false;
    in-out property <bool> loading-older-messages: false;
    callback load-older-requested();
    in property <string> agent-badge: "agent . ask";
    // Phase 16 (topbar_project_indicator): the session's connected
    // project (the snapshotd MCP bound via the agent). Name shown,
    // full path in the accessible label; the dot is green while the
    // MCP connection is live, red when disconnected. Live state is the
    // source of truth; hosts fall back to the session jsonl record only
    // during load (answered open question 5). Empty name hides it.
    in property <string> project-name: "";
    in property <string> project-path: "";
    in property <bool> project-mcp-live: false;
    in property <bool> no-project: false;
    in property <string> connection-status: "Connecting...";
    in property <string> last-error: "";
    callback error-banner-dismissed();
    // PROF-8: persistent (not dismissible) yellow strip -- the displayed
    // thread's agent is reachable but not authenticated. Clears itself
    // once a turn completes (update.rs's TurnEnded handling), unlike
    // last-error which the user dismisses by hand.
    in property <bool> agent-unauthenticated: false;
    // PROF-11: the agent's most recently pushed execution plan/todo list
    // (`AgentBridge::plan`, a live ACP `plan` session/update). Empty
    // hides the panel entirely -- most agents never send one.
    in property <[PlanEntryItem]> plan-entries: [];
    // PROF-11: the most recently pushed live session title (`session_
    // info_update`), deliberately kept separate from the durable,
    // user-editable `active-thread-name` above -- shown as a small
    // suffix on the header only when present and different, never
    // replacing what the user named the thread.
    in property <string> live-session-title: "";
    // Computed once so the header `Text` below doesn't reference
    // `active-thread-name` twice in one expression (generated Rust
    // codegen moved the first `SharedString` use out from under the
    // second in that shape).
    property <string> header-title: active-thread-name != "" ? active-thread-name : "No thread";
    in property <bool> sending: false;
    in property <PendingRequestItem> pending-request;
    in property <[TerminalItem]> terminals: [];
    // Client-local PTY terminal addition -- see `local_terminal_card.
    // slint`'s doc comment. `local-terminal.open == false` (the
    // all-empty default) hides both the header toggle's active state
    // and the card entirely, same "no Option<T>, use an all-default
    // struct" convention `PendingRequestItem` already established.
    in property <LocalTerminalItem> local-terminal;
    in-out property <string> compose-text: "";
    // Composer state is owned by this retained ChatArea. The stack forwards
    // only the selected delegate's changes to Rust; hidden delegates keep
    // their own text and never overwrite the active draft.
    callback compose-text-changed(string);
    in-out property <bool> full-view-open: false;
    in-out property <int> full-view-group-idx: -1;
    in-out property <string> full-view-title: "";
    in-out property <string> full-view-raw-input: "";
    in-out property <string> full-view-raw-output: "";
    in-out property <bool> full-view-is-terminal: false;
    in-out property <bool> full-view-is-mcp: false;
    // One saved level, not an arbitrary-depth stack -- Slint has no
    // array push/pop/slice/concat to build a real one from `.slint` code
    // (confirmed: `arr + [x]` and `arr.slice(...)` both fail to compile).
    // This is enough because the popup structure below only ever reaches
    // two levels: the group popup (`full-view-group-idx >= 0`, opened
    // from `ToolGroupView`'s maximize button) can nest one single-call
    // popup (`full-view-group-idx == -1`, opened via a `ToolEventRow`'s
    // own `open-full-view`); once there, the modal renders a leaf
    // `TerminalView`/`ApiCallView` with no further `open-full-view`
    // trigger of its own, so a third level is structurally unreachable.
    // If a future popup variant *does* need to nest from within a leaf
    // view, this would need to become real Rust-backed state instead of
    // widening this to more scalar fields.
    property <int> prev-full-view-group-idx: -1;
    property <string> prev-full-view-title: "";
    property <string> prev-full-view-raw-input: "";
    property <string> prev-full-view-raw-output: "";
    property <bool> prev-full-view-is-terminal: false;
    property <bool> prev-full-view-is-mcp: false;
    // Phase 14: forwarded to ChatInputLayout.inputs-enabled (false for
    // archived threads -- inputs render disabled, not just inert).
    in property <bool> inputs-enabled: true;
    callback mcp-connect-requested(string);
    callback mcp-enabled-changed(string, bool);
    callback mention-filter-changed(string, string);
    // Phase 17: markdown Ctrl+Click link target, host opens it.
    callback md-link-activated(string);
    // Mode/model selector addition: the *currently displayed* thread's
    // live capability advertisement (`AgentBridge::session_modes`/
    // `config_options`, flattened into domain-neutral `DropdownEntry` rows
    // via `models::to_mode_dropdown_entries`/`to_config_dropdown_entries`).
    // Each defaults to empty, which hides its own selector in the compose
    // bar's second row -- capability-gating contract per [`DropdownEntry`].
    in property <[DropdownEntry]> mode-dropdown-entries: [];
    in property <[DropdownEntry]> config-dropdown-entries: [];
    // The active mode's display name for the mode-selector trigger (empty
    // until a mode is advertised; the trigger falls back to "Mode").
    in property <string> mode-trigger-label: "";
    // Active model/config option display name for the model trigger
    // (empty until advertised; trigger falls back to "Model").
    in property <string> config-trigger-label: "";
    // Reasoning effort (dedicated dropdown; empty hides it).
    in property <[DropdownEntry]> reasoning-dropdown-entries: [];
    in property <string> reasoning-trigger-label: "";
    // Permission mode (dedicated dropdown; empty hides it).
    in property <[DropdownEntry]> permission-mode-dropdown-entries: [];
    in property <string> permission-mode-trigger-label: "";
    // setup-followups plan, provider_fastmode_profile_persistence.
    in property <[DropdownEntry]> profile-dropdown-entries: [];
    in property <string> profile-trigger-label: "";
    in property <bool> active-thread-has-session: false;
    // Dedicated Fast toggle (binary config option; not in model dropdown).
    in property <bool> fast-mode-available: false;
    in property <bool> fast-mode-enabled: false;
    in property <string> fast-mode-option-id: "fastMode";
    in property <string> fast-mode-on-value: "on";
    in property <string> fast-mode-off-value: "off";
    // Session context usage for the compose-bar context ring (ui.yaml).
    in property <float> context-ratio: 0.0;
    in property <int> context-used-tokens: 0;
    in property <int> context-limit-tokens: 0;
    // Catalogs for compose `/` `@` `#` popups.
    in property <[SkillOption]> skill-options: [];
    // PUI-003: ACP agent slash-commands forwarded to the compose `/` menu.
    in property <[SkillOption]> command-options: [];
    in property <[McpServerOption]> mcp-options: [];
    in property <[string]> file-options: [];
    callback mode-selected(string);
    callback config-option-selected(string, string);
    callback profile-selected(string, string);
    callback configure-provider-requested();
    callback context-view-requested();
    callback send-requested(string);
    callback queue-fast-track-requested();
    callback stop-requested();
    // PUI-002a/b: forwarded from ChatInputLayout's terminals chip (see
    // chat-input := ChatInputLayout below); toggles the terminals popup
    // owned locally by this component (terminals-popup-open below) since
    // ChatArea already has the `terminals` list and `expand-terminal`
    // callback the popup needs -- no reason to thread the list back down
    // into ChatInputLayout just to render the popup there.
    callback terminals-clicked();
    property <bool> terminals-popup-open: false;
    // PUI-002b: popup's `[x]` kill button -- see app.slint's forwarding
    // wire and `dispatch_terminal_kill_requested`.
    callback terminal-kill-requested(string);
    // QueuedMessageBar actions: message-list index of the queued row.
    callback queue-cancel-requested(int);
    callback queue-edit-requested(int);
    callback queue-send-now-requested(int);
    callback queue-stop-requested();
    callback settings-requested();
    callback new-thread-requested();
    callback thread-rename-started();
    callback thread-rename-cancelled();
    callback thread-rename-confirmed(string);
    callback toggle-expanded(int);
    callback copy-message(string);
    callback approve-request();
    callback reject-request();
    // One-of permission option pick (optionId from ACP / synthetic id).
    callback permission-option-selected(string);
    callback expand-terminal(string);
    callback local-terminal-toggle-requested();
    callback local-terminal-key-input(string);
    callback local-terminal-expand-requested();
    callback local-terminal-close-requested();
    // Modal overlays call this through ChatPanel after closing so keyboard
    // focus returns to the composer instead of remaining on stale terminal
    // content or falling back to the host dock.
    callback restore-compose-focus();
    // Panel-level keybindings (app.slint) re-dispatched while compose owns
    // focus — returns accept when a shortcut was handled.
    callback panel-shortcut(KeyEvent) -> EventResult;
    out property <bool> compose-has-focus: chat-input.compose-has-focus;

    changed compose-text => { root.compose-text-changed(root.compose-text); }
    out property <bool> local-terminal-has-focus:
        local-terminal.open && local-terminal-card.has-focus;
    // Mode/model dropdown search + mention popup filter -- see
    // FilterSearchBar.input-has-focus's doc comment.
    // rename-input (the chat header's inline thread-rename field) was
    // missing from this OR-chain entirely -- same silently-dropped-
    // keystrokes failure class TextField.has-focus's doc comment names.
    out property <bool> secondary-text-input-has-focus:
        chat-input.secondary-text-input-has-focus
        || rename-input.has-focus
        // Selectable message text (read-only TextInputs in markdown_view /
        // user_bubble / tool_event_row) is focusable: clicking to select
        // grabs focus. Those live inside `for` repeaters, so they report
        // through the SelectionFocus global rather than an id reference --
        // without this, clicking any message text silently dropped every
        // subsequent keystroke (Ctrl+C on the selection, global shortcuts,
        // and typing into the composer) until the user clicked back into
        // the composer. See selection_focus.slint.
        || SelectionFocus.any-focused;

    // --- Demo approval (local one-of card, no ACP round-trip) ------------
    // Type one of these in the compose box and press Send / Enter:
    //   /demo-permission
    //   /demo-approve
    //   demo permission
    // Opens the same PermissionCard UI the host fills from real
    // session/request_permission events. Pick an option (or Esc /
    // Ctrl+Enter) to dismiss. Host pending-request always wins when active.
    property <bool> demo-approval-active: false;
    property <string> demo-approval-summary:
        "The agent wants to run: cargo test -p panel-rust --lib permission";

    pure function is-demo-permission-trigger(t: string) -> bool {
        // Exact matches (optional trailing space). Keep the set small so
        // real chat about "permission" is never hijacked.
        return t == "/demo-permission"
            || t == "/demo-permission "
            || t == "/demo-approve"
            || t == "/demo-approve "
            || t == "demo permission"
            || t == "demo permission ";
    }

    pure function is-tool-kind(k: string) -> bool {
        return k == "tool_use" || k == "mcp_server_call" || k == "skill_use" || k == "skill_load" || k == "terminal";
    }

    // Group length/membership come straight from `MessageItem.tool-group-
    // len` (`models::assign_tool_group_lengths`, Rust-computed once per
    // transcript build) instead of scanning here: Slint `pure function`s
    // support neither loops nor recursion (a `pure function` calling
    // itself compiles to a "binding loop" error), so a Slint-side scan
    // would need a hand-unrolled, arbitrarily-capped `if` ladder that
    // silently undercounts any run longer than the cap. Plain arithmetic
    // on the precomputed length has no such limit.
    pure function in-same-tool-group(msgs: [MessageItem], s: int, c: int) -> bool {
        return c >= s && c < s + msgs[s].tool-group-len;
    }

    // Shared by the popup backdrop `TouchArea` and the header `×` button
    // (previously duplicated inline in both places): a nested full-view
    // (opened from a tool event inside an already-open group popup) pops
    // back to that group's popup state; a non-nested one closes outright.
    function close-full-view() {
        if (root.prev-full-view-group-idx >= 0) {
            root.full-view-group-idx = root.prev-full-view-group-idx;
            root.full-view-title = root.prev-full-view-title;
            root.full-view-raw-input = root.prev-full-view-raw-input;
            root.full-view-raw-output = root.prev-full-view-raw-output;
            root.full-view-is-terminal = root.prev-full-view-is-terminal;
            root.full-view-is-mcp = root.prev-full-view-is-mcp;
            root.prev-full-view-group-idx = -1;
        } else {
            root.full-view-open = false;
            root.full-view-title = "";
            root.full-view-raw-input = "";
            root.full-view-raw-output = "";
        }
    }

    property <PendingRequestItem> demo-pending: {
        active: demo-approval-active,
        relay-id: "demo-local",
        method: "session/request_permission",
        title: "Permission requested",
        summary: demo-approval-summary,
        supported: true,
        options: [
            { option-id: "allow-once", name: "Allow once", kind: "allow_once", is-allow: true },
            { option-id: "allow-always", name: "Allow always", kind: "allow_always", is-allow: true },
            { option-id: "reject-once", name: "Reject", kind: "reject_once", is-allow: false },
        ],
    };

    // Host relay wins; otherwise show the local demo card.
    property <PendingRequestItem> shown-pending:
        pending-request.active ? pending-request : demo-pending;

    // Exposed so ChatPanel Escape / Ctrl+Enter treat demo like a real
    // pending request (app.slint checks pending-request.active — also
    // mirror via out for host shortcuts if needed).
    out property <bool> has-pending-approval: shown-pending.active;

    // Scratch so we never pass compose-text twice into helpers (SharedString
    // move quirk in generated Rust — same pattern as mention-filter).
    property <string> demo-trigger-scratch: "";

    function close-demo-approval() {
        demo-approval-active = false;
    }

    function handle-send() {
        root.demo-trigger-scratch = root.compose-text;
        if (root.is-demo-permission-trigger(root.demo-trigger-scratch)) {
            root.demo-approval-summary =
                "Demo approval triggered by: \"" + root.demo-trigger-scratch + "\"";
            root.demo-approval-active = true;
            root.compose-text = "";
            root.demo-trigger-scratch = "";
            return;
        }
        root.demo-trigger-scratch = "";
        // Normal sends clear this retained ChatArea's own composer before
        // notifying Rust. The per-thread draft callback then mirrors the
        // empty value, without relying on a shared stack-level setter.
        root.send-requested(root.compose-text);
        root.compose-text = "";
    }

    function handle-permission-option(option-id: string) {
        if (root.demo-approval-active && !root.pending-request.active) {
            // Local demo only — dismiss and keep option id in summary
            // so the click is visible without a host.
            root.demo-approval-summary = "Demo selected: " + option-id + " (dismissed)";
            root.close-demo-approval();
            return;
        }
        root.permission-option-selected(option-id);
    }

    function handle-approve() {
        if (root.demo-approval-active && !root.pending-request.active) {
            root.demo-approval-summary = "Demo selected: allow-once (Ctrl+Enter)";
            root.close-demo-approval();
            return;
        }
        root.approve-request();
    }

    function handle-reject() {
        if (root.demo-approval-active && !root.pending-request.active) {
            root.demo-approval-summary = "Demo selected: reject-once (Esc)";
            root.close-demo-approval();
            return;
        }
        root.reject-request();
    }

    // Called from ChatPanel keyboard shortcuts (Esc / Ctrl+Enter).
    public function approve-pending() {
        root.handle-approve();
    }
    public function reject-pending() {
        root.handle-reject();
    }

    // The native v1 dock launches at 20% width. Keep the chat surface in
    // its compact side-panel treatment even after a user widens it; this
    // avoids a width-to-implicit-size binding loop in Slint layouts.
    in property <bool> compact: true;
    in property <bool> narrow: false;
    // When the thread rail is collapsed (or narrow forces the rail), match
    // the sidebar toggle header height.
    in property <bool> sidebar-expanded: true;
    property <bool> match-title-bar: !sidebar-expanded || narrow;
    in property <bool> rename-editing: false;
    in property <string> rename-focus-target: "";
    property <bool> rename-focus-pending: false;
    in-out property <string> rename-draft: "";
    // Filled hand is reserved for a pending decision/input that needs the
    // user's attention. Never use it for ordinary connection states.
    property <bool> status-needs-attention: root.shown-pending.active;
    // Shared with the collapsed sidebar toggle header.
    property <length> title-bar-h: 36px;
    // Allow compose `/` `@` `#` popup to paint above the message stream.
    clip: false;
    background: Theme.bg-chat;

    public function begin-thread-rename() {
        if (root.active-thread-name == "") {
            return;
        }
        root.thread-rename-started();
    }

    function cancel-thread-rename() {
        root.rename-focus-pending = false;
        root.thread-rename-cancelled();
    }

    function confirm-thread-rename() {
        if (root.rename-draft != "") {
            root.thread-rename-confirmed(root.rename-draft);
        }
    }

    changed rename-editing => {
        if (root.rename-editing && root.rename-focus-target == "chat") {
            root.rename-focus-pending = true;
        }
    }

    // Phase 6 (scroll-position preservation + jump-to-latest): whether the
    // user is following the newest message. Live updates only snap the
    // message Flickable back to the bottom while this holds; a user scroll
    // away flips it off (and reveals the floating jump button), a scroll
    // back to the bottom flips it on again. Pure UI state, no Rust.
    property <bool> stick-to-bottom: true;
    // How far the message Flickable can scroll -- viewport-y ranges from
    // `-msg-max-scroll` (bottom) to 0 (top).
    property <length> msg-max-scroll: Math.max(0px, message-scroll.viewport-height - message-scroll.height);
    // Independent scroll position for the popup view (not synced with main message scroll)
    property <length> popup-scroll-y: 0px;
    // PROF-11: keep the live plan visible below the chat header without
    // allowing a large agent plan to consume the transcript viewport.
    // The plan gets its own Flickable below, so its wheel/drag scrolling
    // never changes message-scroll's position.
    property <length> plan-max-height: 180px;

    changed full-view-open => {
        if (root.full-view-open) {
            root.popup-scroll-y = 0px;
        }
    }

    main-layout := VerticalLayout {
        width: parent.width;
        height: parent.height;
        min-height: parent.height;
        preferred-height: parent.height;
        vertical-stretch: 1;
        // Thread header — ui.yaml `chat-view-top`.
        // When the left rail is collapsed (`match-title-bar`), its height
        // matches the collapsed sidebar toggle header.
        Rectangle {
            height: root.match-title-bar ? root.title-bar-h
                : (compact ? 48px : 56px);
            // Match sidebar title strip surface when collapsed.
            background: root.match-title-bar ? Theme.bg-card : Theme.bg-chat;
            // A real Slint animation (not a plain `Timer` stepping this
            // property by hand, the way this element itself used to) so
            // the engine's own animation driver runs it --
            // `has_active_animations()` (panel_rust_poll's host-side
            // repaint trigger) only ever detects *this* kind of
            // animation, never a bare `Timer`, so the old hand-rolled
            // version silently stopped repainting itself except when
            // some unrelated interaction happened to force a repaint
            // anyway. Same fix already applied to sidebar.slint's own
            // load-spin and chat_input_layout.slint's composer spinner
            // (commit 800bd65) -- this header spinner was the one
            // instance of the same bug class left unmigrated.
            // audit-fixes animation_tick_loaders: continuous spin via tick.
            property <bool> header-spinning:
                root.sending || connection-status == "Connecting...";
            property <angle> header-spin: header-spinning
                ? 360deg * mod(animation-tick(), Metrics.pulse-period) / Metrics.pulse-period
                : 0deg;
            // PUI-011: loading shimmer along the header's bottom border while
            // the selected ACP's details are being fetched. Deliberately
            // scoped to `pool-connecting` alone, NOT `header-spinning` --
            // header-spinning also goes true on every `root.sending`
            // (a normal in-flight generation, once the session is already
            // live), which made this "still connecting" shimmer reappear
            // on every single send after the thread had already acquired
            // a real session from the underlying ACP pool. It should show
            // once, for the actual pool-acquisition wait, then stay gone.
            property <bool> pool-connecting: connection-status == "Connecting...";
            Rectangle {
                x: 0;
                y: parent.height - self.height;
                width: 100%;
                height: 2px;
                visible: pool-connecting;
                clip: true;
                Rectangle {
                    height: 100%;
                    width: parent.width * 0.35;
                    x: (parent.width + self.width) * (mod(animation-tick(), Metrics.pulse-period) / Metrics.pulse-period) - self.width;
                    background: @linear-gradient(90deg,
                        transparent 0%, Theme.bg-primary 50%, transparent 100%);
                }
            }
            HorizontalLayout {
                width: 100%;
                height: 100%;
                // Sidebar title uses space-2/4 padding + icon-md (16px).
                padding-left: root.match-title-bar
                    ? (compact ? Metrics.space-2 : Metrics.space-4)
                    : (compact ? Metrics.space-3 : Metrics.space-6);
                padding-right: root.match-title-bar
                    ? (compact ? Metrics.space-2 : Metrics.space-4)
                    : (compact ? Metrics.space-3 : Metrics.space-6);
                spacing: root.match-title-bar
                    ? (compact ? Metrics.space-1 : Metrics.space-3)
                    : (compact ? Metrics.space-3 : Metrics.space-5);
                alignment: stretch;
                cross-axis-alignment: center;

                // --- LEFT (ui.yaml): status icon + thread title ---
                left-cluster := HorizontalLayout {
                    spacing: root.match-title-bar ? Metrics.space-2 : Metrics.space-3;
                    horizontal-stretch: 1;
                    preferred-width: 0px;
                    min-width: 0px;
                    alignment: stretch;
                    cross-axis-alignment: center;
                    rename-focus-delay := Timer {
                        interval: 1ms;
                        running: root.rename-focus-pending;
                        triggered => {
                            root.rename-focus-pending = false;
                            rename-input.focus();
                        }
                    }
                    // Status icon — Metrics.icon-md (16px), same as sidebar title icons.
                    // No height: parent.height (binding loop with layoutinfo-v).
                    //
                    // Wrapped in one persistent accessible-role: text element
                    // so connection-status is exposed to accessibility
                    // regardless of which of the 3 visual variants below is
                    // showing -- accessible-role: text doesn't support
                    // accessible-value, so the status is folded into
                    // accessible-label itself, matching the convention this
                    // codebase already uses elsewhere for non-interactive
                    // status indicators.
                    connection-status-indicator := Rectangle {
                        horizontal-stretch: 0;
                        vertical-stretch: 0;
                        width: Metrics.icon-md;
                        height: Metrics.icon-md;
                        accessible-role: text;
                        accessible-label: "Connection status: " + connection-status;
                        if root.sending || connection-status == "Connecting..." : Spinner {
                            size: Metrics.icon-md;
                            stroke: Theme.bg-primary;
                            stroke-width: 2px;
                        }
                        if !(root.sending || connection-status == "Connecting...")
                            && root.status-needs-attention : Icon {
                            source: @image-url("./assets/icons/hand-filled.svg");
                            size: Metrics.icon-md;
                            color: Theme.bg-primary;
                        }
                        // gateway-fail-state: `connection-status` reads
                        // "Unavailable" whenever `AgentBridge::transport_
                        // status` finds no gateway URL recorded for this
                        // thread's provider -- exactly the state left behind
                        // by a failed `provision_gateway`/`spawn_gateway_
                        // process` call (see that function's real production
                        // failure log, `system_launch.yaml`, "Permission
                        // denied (os error 13)"). Before this branch existed
                        // that state fell straight through to the plain
                        // neutral dot below, indistinguishable from "idle,
                        // nothing to report" -- a real, silent failure looked
                        // identical to nothing happening. A plain dash, not a
                        // colored icon: matches this project's established
                        // monochrome-only status language (see
                        // `agent_card.slint`'s doc comment) rather than
                        // introducing a red/error-colored treatment here.
                        if !(root.sending || connection-status == "Connecting...")
                            && !root.status-needs-attention
                            && connection-status == "Unavailable" : Text {
                            text: "-";
                            color: Theme.text-secondary;
                            font-size: Metrics.icon-md * 0.9;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                        if !(root.sending || connection-status == "Connecting...")
                            && !root.status-needs-attention
                            && connection-status != "Unavailable" : Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: Theme.text-muted;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                    if !root.rename-editing : Text {
                        // PROF-11: an agent-pushed live title is appended
                        // as a small suffix, not swapped in for the
                        // durable name -- see `live-session-title`'s doc
                        // comment for why the two must never merge.
                        text: root.header-title
                            + (root.live-session-title != "" && root.live-session-title != root.header-title
                                ? "  ·  " + root.live-session-title
                                : "");
                        color: Theme.text-primary;
                        // Match sidebar "Chats" title when rail collapsed.
                        font-size: (root.match-title-bar ? 14px
                            : (compact ? 13px : 15px)) * Theme.font-scale;
                        font-weight: 600;
                        font-family: Theme.font-sans;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                        min-width: 0px;
                        overflow: elide;
                    }
                    rename-editor := Rectangle {
                        visible: root.rename-editing;
                        // `visible:` (not `if:`) so rename-input stays a
                        // valid id reference outside rename mode -- but
                        // that means this element never leaves the
                        // layout tree, so an unconditional fixed height
                        // was silently forcing left-cluster's
                        // HorizontalLayout to be at least 26/30px tall
                        // (cross-axis size = max of ALL children's
                        // heights, visible or not) even while not
                        // renaming, pushing/squeezing the connection-
                        // status-indicator spinner off true center --
                        // worst in collapsed/match-title-bar mode, where
                        // the header itself is shortest. Same bug class
                        // (and same fix) already applied once in
                        // sidebar_thread_row.slint's own rename-editor.
                        height: root.rename-editing ? (root.match-title-bar ? 26px : 30px) : 0px;
                        background: Theme.bg-sidebar;
                        border-width: 1px;
                        border-color: Theme.border-default;
                        border-radius: Theme.radius-sm;
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                        min-width: 72px;
                        rename-input := TextInput {
                            x: Metrics.space-3;
                            y: 0px;
                            width: parent.width - 2 * Metrics.space-3;
                            height: parent.height;
                            accessible-label: "Thread name";
                            text <=> root.rename-draft;
                            color: Theme.text-primary;
                            font-family: Theme.font-sans;
                            font-size: (root.match-title-bar ? 13px
                                : (compact ? 12px : 14px)) * Theme.font-scale;
                            vertical-alignment: center;
                            single-line: true;
                            key-pressed(event) => {
                                if (event.text == Key.Return) {
                                    root.confirm-thread-rename();
                                    return EventResult.accept;
                                }
                                if (event.text == Key.Escape) {
                                    root.cancel-thread-rename();
                                    return EventResult.accept;
                                }
                                return EventResult.reject;
                            }
                        }
                    }
                    if !root.rename-editing && active-thread-name != "" : IconButton {
                        btn-width: 20px;
                        btn-height: 20px;
                        button-accessible-label: "Rename thread";
                        clicked => { root.begin-thread-rename(); }
                        Icon {
                            source: @image-url("./assets/icons/pencil.svg");
                            size: 13px;
                            color: Theme.text-muted;
                        }
                    }
                    if root.rename-editing : IconButton {
                        btn-width: 20px;
                        btn-height: 20px;
                        button-accessible-label: "Save thread name";
                        clicked => { root.confirm-thread-rename(); }
                        Icon {
                            source: @image-url("./assets/icons/check.svg");
                            size: 14px;
                            color: Theme.bg-primary;
                        }
                    }
                    if root.rename-editing : IconButton {
                        btn-width: 20px;
                        btn-height: 20px;
                        button-accessible-label: "Cancel thread rename";
                        clicked => { root.cancel-thread-rename(); }
                        Icon {
                            source: @image-url("./assets/icons/x.svg");
                            size: 14px;
                            color: Theme.text-muted;
                        }
                    }
                }

                // --- RIGHT (ui.yaml): agent name [top right] + tools ---
                right-cluster := HorizontalLayout {
                    spacing: root.match-title-bar ? Metrics.space-2
                        : (compact ? Metrics.space-2 : Metrics.space-3);
                    horizontal-stretch: 0;
                    alignment: end;
                    cross-axis-alignment: center;

                    Text {
                        text: agent-badge;
                        color: Theme.text-primary;
                        font-size: (root.match-title-bar ? 10px : 11px) * Theme.font-scale;
                        font-family: Theme.font-mono;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        horizontal-stretch: 0;
                        vertical-stretch: 0;
                        overflow: elide;
                        max-width: compact ? 120px : 200px;
                    }

                    if narrow : IconButton {
                        button-accessible-label: "New thread";
                        clicked => { new-thread-requested(); }
                        Icon {
                            source: @image-url("./assets/icons/plus.svg");
                            size: Metrics.icon-md;
                            color: Theme.bg-primary;
                        }
                    }
                }
            }
        }
        Rectangle {
            // Separator under the header -- Slint has no per-edge
            // border, so a thin standalone Rectangle stands in for the
            // HTML's `border-b border-sys-border`.
            height: 1px;
            background: Theme.border-default;
        }
        // PROF-8: yellow "reachable but not authenticated" strip,
        // directly below the top bar (ahead of the red error banner
        // below, which is dismissible -- this one isn't, it clears
        // itself once a turn actually completes).
        if root.agent-unauthenticated : Rectangle {
            height: auth-banner-text.preferred-height + 2 * Metrics.space-3;
            background: #422006;
            border-color: #eab308;
            border-width: 1px;
            HorizontalLayout {
                padding-left: Metrics.space-6;
                padding-right: Metrics.space-6;
                padding-top: Metrics.space-3;
                padding-bottom: Metrics.space-3;
                spacing: Metrics.space-3;
                auth-banner-text := Text {
                    text: "⚠ Agent is reachable but not authenticated. Configure an auth method for this profile.";
                    color: #eab308;
                    font-size: 10px * Theme.font-scale;
                    font-family: Theme.font-mono;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                    preferred-width: 0px;
                    min-width: 0px;
                    accessible-role: text;
                    accessible-label: self.text;
                }
            }
        }
        // PROF-11: the agent's self-reported execution plan/todo list.
        // Hidden entirely when empty (`plan-entries.length == 0`) --
        // most agents never send one, so this must never look like a
        // dead/always-present control.
        if root.plan-entries.length > 0 : Rectangle {
            // This chrome band stays outside message-area/message-scroll;
            // only plan-scroll can move its overflowing entries.
            height: min(plan-list.preferred-height, root.plan-max-height);
            background: Theme.bg-card;
            border-color: Theme.border-default;
            border-width: 1px;
            clip: true;
            plan-scroll := Flickable {
                width: parent.width;
                height: parent.height;
                viewport-height: plan-list.preferred-height;
                plan-list := VerticalLayout {
                    width: parent.width;
                    padding-left: Metrics.space-6;
                    padding-right: Metrics.space-6;
                    padding-top: Metrics.space-3;
                    padding-bottom: Metrics.space-3;
                    spacing: Metrics.space-1;
                    for entry[i] in root.plan-entries : HorizontalLayout {
                        spacing: Metrics.space-2;
                        Text {
                            text: entry.status == "completed" ? "✓"
                                : entry.status == "in_progress" ? "▶" : "○";
                            color: entry.status == "completed" ? Theme.text-muted
                                : Theme.text-primary;
                            font-size: 10px * Theme.font-scale;
                            font-family: Theme.font-mono;
                            vertical-alignment: center;
                        }
                        Text {
                            text: entry.content;
                            color: entry.status == "completed" ? Theme.text-muted : Theme.text-primary;
                            font-size: 10px * Theme.font-scale;
                            font-family: Theme.font-mono;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                            preferred-width: 0px;
                            min-width: 0px;
                            accessible-role: text;
                            accessible-label: "Plan entry, " + entry.priority + " priority, " + entry.status + ": " + entry.content;
                        }
                    }
                }
            }
        }
        // Send/session-attach failure banner. Previously this only ever
        // surfaced as a small "Error: ..." sidebar subtitle under the
        // thread's name (models::describe_thread's error branch) --
        // easy to miss entirely while looking at the transcript itself,
        // which is exactly the "sent a message, got no visible response
        // or explanation at all" symptom this closes. Dismissing just
        // clears the Rust-side per-thread error string; a later real
        // error re-shows it.
        if root.last-error != "" : Rectangle {
            height: error-banner-text.preferred-height + 2 * Metrics.space-3;
            background: Theme.bg-card;
            border-color: #b91c1c;
            border-width: 1px;
            HorizontalLayout {
                padding-left: Metrics.space-6;
                padding-right: Metrics.space-6;
                padding-top: Metrics.space-3;
                padding-bottom: Metrics.space-3;
                spacing: Metrics.space-3;
                error-banner-text := Text {
                    text: "⚠ " + root.last-error;
                    color: #ef4444;
                    font-size: 10px * Theme.font-scale;
                    font-family: Theme.font-mono;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                    preferred-width: 0px;
                    min-width: 0px;
                }
                dismiss-touch := TouchArea {
                    mouse-cursor: pointer;
                    width: 16px;
                    accessible-role: button;
                    accessible-label: "Dismiss error";
                    accessible-action-default => { root.error-banner-dismissed(); }
                    clicked => { root.error-banner-dismissed(); }
                    changed has-hover => { CursorHost.kind = self.has-hover ? "pointer" : "default"; }
                    Text {
                        text: "\u{2715}";
                        color: Theme.text-muted;
                        font-size: 10px * Theme.font-scale;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
        message-area := Rectangle {
            // The one elastic region in the chat column: the Flickable fills
            // it and the floating jump-to-latest button overlays its
            // bottom-right corner.
            vertical-stretch: 1;
            preferred-height: 0px;
            min-height: 0px;
            message-scroll := Flickable {
                width: 100%;
                height: 100%;
                // Mouse-wheel scroll ticks previously set `viewport-y`
                // straight to the target step, no interpolation -- felt
                // jittery/stepped rather than a smooth scroll. Eased here
                // explicitly (not just relying on the two-way-bound
                // `ThinScrollbar.viewport-y` below to propagate its own
                // animate across the binding -- not a guarantee worth
                // depending on silently), gated on the SAME
                // `chat-scrollbar.dragging` state that scrollbar uses for
                // its own side: instant while the thumb is being actively
                // dragged (1:1 tracking, no lag-behind-cursor), eased for
                // everything else (wheel ticks, click-to-jump, and the
                // streaming auto-follow-to-bottom snap below).
                //
                // Duration bumped 90ms -> 180ms and easing switched
                // ease-out -> ease-in-out: 90ms is this codebase's
                // "instant feedback" tuning (hover/background fades all
                // sit at 100ms elsewhere), not its "real movement" tuning
                // (expandable_panel/collapse_expand/sidebar all animate
                // height/width/x at 150-180ms with ease-in-out). At 90ms
                // an eased jump across any real scroll distance reads as
                // a snap, not a glide -- which is exactly the "sticks
                // block-wise" complaint despite an animate block already
                // being present. This also stops being visibly mismatched
                // against raw mouse-wheel/touch flicking, which Slint's
                // own Flickable animates natively via a separate built-in
                // physics curve (i-slint-core's Flickable::process_wheel_event,
                // WHEEL_SCROLL_DURATION = 180ms) that this .slint-level
                // `animate` block cannot see or influence at all -- native
                // wheel input calls the underlying Property's `set()`/
                // `set_physic_animation_value()` directly, bypassing
                // whatever PropertyAnimation a .slint file declares.
                // Matching 180ms here means every OTHER viewport-y mover
                // this file actually controls (click-to-jump on the
                // track, the jump-to-latest button, and new-message
                // auto-follow) now moves at the same speed the engine
                // already uses for wheel scrolling, instead of visibly
                // snapping twice as fast.
                animate viewport-y {
                    duration: chat-scrollbar.dragging ? 0ms : 180ms;
                    easing: ease-in-out;
                }
                // Was relying on Flickable's own auto-inference of
                // viewport-height from its child, which -- per base/
                // expandable_panel.slint's own documented fix for the
                // identical symptom -- "doesn't reliably report its own
                // preferred-height from arbitrary child content (it's a
                // scroll viewport, not a layout)". Binding this explicitly
                // is purely additive (computes the same value auto-
                // inference should already produce when it works) and
                // matches every other Flickable in this codebase, all of
                // which already bind viewport-height/-width explicitly
                // except this one and settings_page.slint's (fixed
                // alongside this for the same reported "scroll issues").
                viewport-height: message-col.preferred-height;
                // Live updates grow `viewport-height`; snap back to the bottom
                // only while the user is following the latest message, so a
                // read-back-in-history scroll position is never stolen.
                changed viewport-height => {
                    if (root.stick-to-bottom) {
                        self.viewport-y = -root.msg-max-scroll;
                    }
                }
                // A user scroll updates whether they're following the bottom
                // and -- only a user-originated movement at the real top
                // boundary -- may page in older history.
                flicked => {
                    root.stick-to-bottom = (self.viewport-y + root.msg-max-scroll) < 8px;
                    if has-older-messages
                        && !loading-older-messages
                        && self.viewport-y >= -1px {
                        loading-older-messages = true;
                        load-older-requested();
                    }
                }
                message-col := VerticalLayout {
                // Match ChatInputLayout shell (pad-2xl H / pad-xl V) so the
                // message column lines up with the compose bar.
                padding-left: Metrics.pad-2xl;
                padding-right: Metrics.pad-2xl;
                padding-top: Metrics.pad-xl;
                padding-bottom: Metrics.pad-xl;
                // Per-row trailing spacer (below), not layout `spacing` --
                // see the `for msg[i] in messages` loop's own doc comment
                // for why: a tool group with multiple internal tool uses
                // put several *extra*, content-less rows into this flat
                // `messages`-indexed list (one per sub-call, only the
                // group's first index actually renders a ToolGroupView),
                // and a VerticalLayout's `spacing` applies between EVERY
                // adjacent child including empty ones -- same PUI-009
                // class as the full-view popup's tool list below and the
                // sidebar lists, just not fixed here yet until now.
                spacing: 0px;
                if has-older-messages : VerticalLayout {
                    spacing: 0px;
                    Rectangle {
                        height: 22px;
                        border-radius: Theme.radius-sm;
                        background: load-older-button.has-hover ? Theme.bg-primary-container : Theme.bg-sidebar;
                        animate background { duration: 100ms; }
                        load-older-button := TouchArea {
                            mouse-cursor: loading-older-messages ? default : pointer;
                            accessible-role: button;
                            accessible-label: "Load older messages";
                            enabled: !loading-older-messages;
                            accessible-action-default => {
                                if !loading-older-messages {
                                    loading-older-messages = true;
                                    load-older-requested();
                                }
                            }
                            clicked => {
                                if !loading-older-messages {
                                    loading-older-messages = true;
                                    load-older-requested();
                                }
                            }
                            changed has-hover => {
                                CursorHost.kind = (self.has-hover && !loading-older-messages) ? "pointer" : "default";
                            }
                        }
                        Text {
                            text: loading-older-messages ? "Loading older messages..." : "Load older messages";
                            color: Theme.text-secondary;
                            font-size: 10px * Theme.font-scale;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    // This block is only ever visible alongside real message
                    // rows below it, so it always needs its own trailing gap.
                    Rectangle { height: compact ? Metrics.gap-md : Metrics.gap-lg; }
                }
                // Phase 18 empty/loading states: never leave the chat
                // view blank. While (re)connecting, a blinking loading
                // line; once live with no messages, a centered starter.
                if root.no-project : VerticalLayout {
                    height: 160px;
                    alignment: center;
                    Text {
                        text: "No project open";
                        color: Theme.text-muted;
                        opacity: 0.8;
                        font-size: 11px * Theme.font-scale;
                        font-italic: true;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                if root.messages.length == 0 && !root.no-project : VerticalLayout {
                    height: 160px;
                    alignment: center;
                    property <bool> reloading: connection-status == "Connecting...";
                    property <float> blink: 0.3 + 0.7 * abs(sin(360deg * mod(animation-tick(), Metrics.pulse-period) / Metrics.pulse-period));
                    Text {
                        text: reloading ? "loading conversation..."
                            : "Send a message to start the conversation";
                        color: Theme.text-muted;
                        opacity: reloading ? blink : 0.8;
                        font-size: 11px * Theme.font-scale;
                        font-italic: true;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                // chat-items-redesign.md #11: kind switch — user /
                // agent|thinking / tool-event / legacy MessageCard.
                // Wrapped in a VerticalLayout (spacing 0) with its own
                // trailing spacer below, rather than a bare HorizontalLayout
                // relying on `message-col`'s own layout `spacing` above --
                // see that `spacing: 0px` change's doc comment for why: a
                // tool group with N internal tool uses puts N-1 *extra*,
                // content-less entries into this flat, `messages`-indexed
                // list (every index but the group's first renders nothing
                // here -- see `is-first-tool-event` below -- because
                // ToolGroupView already renders every sub-call itself from
                // `group-start`/`group-length`), and layout `spacing`
                // applies between EVERY adjacent child including empty
                // ones, so those N-1 invisible rows used to each add a full
                // row gap before the next real row, compounding into a gap
                // N-1x too wide.
                for msg[i] in messages : VerticalLayout {
                    spacing: 0px;
                    property <bool> is-queued: msg.queued;
                    // Phase 18: synthetic awaiting-response row (models.rs
                    // appends kind "pending" while a just-sent user message
                    // is the transcript tail). Subtle dots, distinct from
                    // real thinking rows.
                    property <bool> is-pending: msg.kind == "pending";
                    property <bool> is-user: msg.kind == "user" && !msg.queued;
                    property <bool> is-agent-side: msg.kind == "agent"
                        || msg.kind == "thinking"
                        || msg.kind == "pending";
                    property <bool> is-tool-event: root.is-tool-kind(msg.kind);
                    property <bool> is-first-tool-event: is-tool-event && (i == 0 ? true : !root.is-tool-kind(root.messages[i - 1].kind));
                    // Active-session rail on the *latest* row while the
                    // thread is loading (same `sending` state as the
                    // header/sidebar spinner). Pulse *flows* top → bottom.
                    property <bool> is-live-tail:
                        root.sending && i == root.messages.length - 1;
                    property <int> tool-group-size: msg.tool-group-len;
                    // Fixed gutter widths — never toggle 0↔N when the live
                    // rail appears, or the bubble column jumps horizontally.
                    property <length> rail-w: 3px;
                    property <length> rail-gap: Metrics.space-3;
                    property <length> user-indent: 8px;
                    // 0..1 progress of the traveling highlight. A real
                    // Slint animation (not a plain `Timer` stepping this
                    // property by hand) so the engine's own animation
                    // driver drives it -- `has_active_animations()`
                    // (panel_rust_poll's host-side repaint trigger) only
                    // ever detected *this* kind of animation, never a bare
                    // `Timer`, so the old hand-rolled version silently
                    // never repainted on its own and looked frozen except
                    // when some unrelated interaction (e.g. a mouse move)
                    // happened to trigger a repaint anyway.
                    // audit-fixes animation_tick_loaders: live-tail pulse
                    // must not mount already at 1.0 (animate never runs).
                    // Drive travel with animation-tick while live.
                    property <float> flow-t: is-live-tail
                        ? mod(animation-tick(), Metrics.pulse-period) / Metrics.pulse-period
                        : 0.0;
                    property <length> flow-blob: 36px;

                    HorizontalLayout {
                        padding-right: compact ? Metrics.space-2 : Metrics.space-4;

                        // Left rail track — always reserved for non-user rows
                        // so agent/tool width is stable when is-live-tail flips.
                        // User rows keep a fixed indent instead (no rail).
                        live-rail := Rectangle {
                            // Always claim rail-w for non-user rows (placeholder
                            // when idle) so live pulse never changes row width.
                            width: is-user ? 0px : rail-w;
                            horizontal-stretch: 0;
                            min-height: 12px;
                            clip: true;
                            border-radius: 1.5px;
                            // Dim track only while live; transparent placeholder
                            // otherwise (same width, no layout shift). Tool-event
                            // rows are excluded here -- ToolGroupView already
                            // draws its own left-edge pulse rail (see its
                            // `pulse-opacity`/loading rail) while a tool call is
                            // active, so this traveling highlight would just be
                            // a second, redundant left-border animation on the
                            // same row.
                            background: (is-live-tail && !is-tool-event)
                                ? Theme.bg-primary.with-alpha(0.18)
                                : transparent;

                            // Bright segment that travels down the rail.
                            if is-live-tail && !is-tool-event : Rectangle {
                                width: parent.width;
                                height: min(flow-blob, parent.height);
                                y: (parent.height + flow-blob) * flow-t - flow-blob;
                                border-radius: 1.5px;
                                background: Theme.bg-primary.with-alpha(0.95);
                            }
                            if is-live-tail && !is-tool-event : Rectangle {
                                width: parent.width;
                                height: min(flow-blob * 0.55, parent.height);
                                y: (parent.height + flow-blob) * flow-t - flow-blob * 1.45;
                                border-radius: 1.5px;
                                background: Theme.bg-primary.with-alpha(0.35);
                            }
                        }
                        // Gap after rail / user indent — fixed per kind.
                        Rectangle {
                            width: is-user ? 36px : rail-gap;
                            horizontal-stretch: 0;
                        }
                        if is-pending : PendingStatusRow {
                            // No padding-left here -- unlike every other row
                            // kind below (UserBubble/AgentBubble/
                            // ToolGroupView/QueuedMessageBar), this used to add
                            // its own rail-w + gap offset on top of the one
                            // already reserved by the preceding live-rail +
                            // gap Rectangle siblings, pushing the status text
                            // further right than every other row's content
                            // actually starts.
                            label: root.last-error != "" ? root.last-error : "waiting for response";
                        }
                        if is-queued : QueuedMessageBar {
                            horizontal-stretch: 1;
                            preferred-width: 0px;
                            min-width: 0px;
                            text: msg.text;
                            can-edit: msg.can-edit;
                            can-send-now: msg.can-send-now;
                            sending: msg.sending;
                            cancel-requested => { root.queue-cancel-requested(msg.index); }
                            edit-requested => { root.queue-edit-requested(msg.index); }
                            send-now-requested => { root.queue-send-now-requested(msg.index); }
                            stop-requested => { root.queue-stop-requested(); }
                        }
                        if is-user : UserBubble {
                            // Stretch within the available chat column instead
                            // of binding width back to the Flickable viewport.
                            // A fixed width clips at the 20%-dock target, while
                            // a parent.width binding creates a Slint layout loop.
                            horizontal-stretch: 1;
                            preferred-width: 0px;
                            min-width: 0px;
                            item: msg;
                            copy-message(text) => { root.copy-message(text); }
                        }
                        if is-agent-side : AgentBubble {
                            link-activated(target) => { root.md-link-activated(target); }
                            horizontal-stretch: 1;
                            preferred-width: 0px;
                            min-width: 0px;
                            vertical-stretch: 0;
                            item: msg;
                            // Thinking rows reuse MessageItem.expanded + the
                            // shared toggle-expanded round-trip (same as
                            // ToolEventRow / MessageCard log bodies).
                            toggle-expanded(idx) => { toggle-expanded(idx); }
                            copy-message(text) => { root.copy-message(text); }
                        }
                        if is-first-tool-event : ToolGroupView {
                            horizontal-stretch: 1;
                            preferred-width: 0px;
                            min-width: 0px;
                            label: root.tool-groups.length > 0 ? root.tool-groups[msg.index].label : (msg.kind == "mcp_server_call" ? "MCP CALL" : "TOOL USE");
                            item-count: root.tool-groups.length > 0 ? root.tool-groups[msg.index].item-count : tool-group-size;
                            messages: root.tool-groups.length > 0 ? root.tool-groups[msg.index].messages : root.messages;
                            group-start: i;
                            group-length: tool-group-size;
                            group-local: root.tool-groups.length > 0;
                            row-cap-height: root.height * 0.3;
                            loading: is-live-tail;
                            // Tool/MCP execution groups are opt-in surfaces:
                            // even the newest live group stays collapsed until
                            // the user explicitly expands it.
                            default-expanded: false;
                            mcp-variant: root.tool-groups.length > 0 ? root.tool-groups[msg.index].label == "MCP CALL" : msg.kind == "mcp_server_call";
                            max-visible-height: min(230px, root.height * 0.35);
                            open-group-full-view => {
                                root.full-view-title = (root.tool-groups.length > 0 ? root.tool-groups[msg.index].label : (msg.kind == "mcp_server_call" ? "MCP CALL" : "TOOL USE")) + " EXECUTION (" + (root.tool-groups.length > 0 ? root.tool-groups[msg.index].item-count : tool-group-size) + " TOTAL CALLS)";
                                root.full-view-is-mcp = root.tool-groups.length > 0 ? root.tool-groups[msg.index].label == "MCP CALL" : msg.kind == "mcp_server_call";
                                root.full-view-group-idx = i;
                                root.full-view-open = true;
                            }
                            toggle-expanded(idx) => { toggle-expanded(idx); }
                            open-full-view(title, input, output, term, mcp) => {
                                root.full-view-title = title;
                                root.full-view-raw-input = input;
                                root.full-view-raw-output = output;
                                root.full-view-is-terminal = term;
                                root.full-view-is-mcp = mcp;
                                root.full-view-group-idx = -1;
                                root.full-view-open = true;
                            }
                        }
                        if !is-queued && !is-user && !is-agent-side && !is-tool-event : card := MessageCard {
                            horizontal-stretch: 1;
                            preferred-width: 0px;
                            min-width: 0px;
                            item: msg;
                            toggle-expanded(idx) => { toggle-expanded(idx); }
                        }
                        Rectangle {
                            width: (is-agent-side || is-first-tool-event) ? 36px : 0px;
                            horizontal-stretch: 0;
                        }
                    }
                    // This row's own trailing gap -- 0px for a tool-group
                    // continuation row (renders nothing of its own above,
                    // already covered by the group's first-index
                    // ToolGroupView) and for the very last row (no
                    // `spacing`-equivalent gap after the last child,
                    // matching the previous layout-`spacing` behavior).
                    Rectangle {
                        height: (!(is-tool-event && !is-first-tool-event) && i < root.messages.length - 1)
                            ? (compact ? Metrics.gap-md : Metrics.gap-lg) : 0px;
                    }
                }
            }
            }
            // Floating jump-to-latest button -- shown only while the user has
            // scrolled away from the bottom. It swaps its down-arrow for the
            // approval "hand" glyph when a permission request is pending, so a
            // scrolled-up user still gets a single affordance pointing at the
            // decision waiting below (the docked PermissionCard).
            if !root.stick-to-bottom : Rectangle {
                width: 32px;
                height: 32px;
                x: parent.width - self.width - Metrics.space-6;
                y: parent.height - self.height - Metrics.space-6;
                border-radius: self.height / 2;
                background: jump-touch.has-hover ? Theme.bg-primary.with-alpha(0.85) : Theme.bg-primary;
                animate background { duration: 100ms; }
                border-color: Theme.border-strong;
                border-width: 1px;
                jump-touch := TouchArea {
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: root.shown-pending.active ? "Jump to pending request" : "Jump to latest message";
                    accessible-action-default => {
                        root.stick-to-bottom = true;
                        message-scroll.viewport-y = -root.msg-max-scroll;
                    }
                    clicked => {
                        root.stick-to-bottom = true;
                        message-scroll.viewport-y = -root.msg-max-scroll;
                    }
                    changed has-hover => { CursorHost.kind = self.has-hover ? "pointer" : "default"; }
                }
                Icon {
                    source: root.shown-pending.active
                        ? @image-url("./assets/icons/hand.svg")
                        : @image-url("./assets/icons/arrow-down.svg");
                    size: Metrics.icon-sm;
                    color: Theme.text-on-primary;
                }
            }

            // Right-side auto-hiding thin scrollbar for chat view
            chat-scrollbar := ThinScrollbar {
                x: parent.width - self.width - 2px;
                y: 4px;
                visible-height: parent.height - 8px;
                viewport-height: message-col.preferred-height;
                viewport-y <=> message-scroll.viewport-y;
                thumb-width: 4px;
                active: !root.stick-to-bottom;
            }

            // Centered full view overlay popup inside message-area (between top bar & chat input)
            // Only show full-view backdrop if full-view is explicitly open (not just inherited from popup)
            if root.full-view-open : Rectangle {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                background: #00000080;

                TouchArea {
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: "Close full view";
                    accessible-action-default => { self.clicked(); }
                    // Only close full-view, restoring previous state if nested
                    clicked => { root.close-full-view(); }
                }

                Rectangle {
                    x: max(10px, (parent.width - 720px) / 2);
                    y: max(10px, (parent.height - 520px) / 2);
                    width: min(parent.width - 20px, 720px);
                    height: min(parent.height - 20px, 520px);
                    background: Theme.bg-sidebar;
                    border-width: 0px;
                    border-radius: Theme.radius-lg;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: #00000080;

                    TouchArea {
                        accessible-role: button;
                        accessible-label: "Close full view";
                        accessible-action-default => { self.clicked(); }
                        // Intercept clicks on dialog card body so backdrop touch doesn't close
                    }

                    VerticalLayout {
                        padding: Metrics.space-6;
                        spacing: Metrics.space-3;

                        // Header Bar
                        HorizontalLayout {
                            spacing: Metrics.space-2;
                            Icon {
                                source: root.full-view-is-mcp ? @image-url("./assets/icons/plug-zap.svg") : @image-url("./assets/icons/wrench.svg");
                                size: 16px;
                                color: Theme.text-primary;
                            }
                            Text {
                                text: root.full-view-title != "" ? root.full-view-title : "FULL CALL DETAILS & PAYLOAD";
                                font-family: Theme.font-mono;
                                font-size: 11px * Theme.font-scale;
                                font-weight: 700;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; height: 0px; }
                            IconButton {
                                btn-width: 20px;
                                btn-height: 20px;
                                button-accessible-label: "Close full view";
                                clicked => { root.close-full-view(); }
                                Text {
                                    text: "\u{2715}";
                                    color: Theme.text-muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.border-default; }

                        Flickable {
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                            viewport-height: popup-content.preferred-height;
                            viewport-y <=> root.popup-scroll-y;

                            popup-content := VerticalLayout {
                                spacing: Metrics.space-2;
                                if root.full-view-group-idx >= 0 : VerticalLayout {
                                    // PUI-009 class: this repeater walks the WHOLE
                                    // thread and collapses non-group rows to 0px,
                                    // but a VerticalLayout applies `spacing`
                                    // between EVERY adjacent child including
                                    // zero-height ones -- with `spacing:
                                    // Metrics.space-2` a group deep in a long
                                    // thread accumulated one gap per message
                                    // outside it (large empty scroll regions).
                                    // Same fix as the sidebar lists: no layout
                                    // spacing, and each visible row carries its
                                    // own trailing spacer (0px when hidden).
                                    // ToolGroupView's own body-layout already does
                                    // this (spacing: 0px).
                                    spacing: 0px;
                                    for sub-msg[sub-idx] in (root.tool-groups.length > 0 ? root.tool-groups[root.full-view-group-idx].messages : root.messages) : VerticalLayout {
                                        property <bool> row-visible: root.tool-groups.length > 0
                                            ? true
                                            : sub-idx >= root.full-view-group-idx
                                                && root.in-same-tool-group(root.messages, root.full-view-group-idx, sub-idx);
                                        spacing: 0px;
                                        ToolEventRow {
                                        visible: parent.row-visible;
                                        height: self.visible ? self.preferred-height : 0px;
                                        horizontal-stretch: self.visible ? 1 : 0;
                                        vertical-stretch: 0;
                                        in-group: true;
                                        kind: sub-msg.kind;
                                        first-use: sub-msg.first-use;
                                        text: sub-msg.text;
                                        cap-height: 260px;
                                        raw-input: sub-msg.raw-input;
                                        raw-output: sub-msg.raw-output;
                                        // Full-view rows follow the same
                                        // collapsed-by-default policy as the
                                        // inline group. Users opt into each
                                        // payload explicitly.
                                        expanded: false;
                                        index: sub-msg.index;
                                        mcp-variant: root.full-view-is-mcp;
                                        toggle-expanded(idx) => { toggle-expanded(idx); }
                                        open-full-view(title, input, output, term, mcp) => {
                                            // Save current state for nested popup (stack style)
                                            root.prev-full-view-group-idx = root.full-view-group-idx;
                                            root.prev-full-view-title = root.full-view-title;
                                            root.prev-full-view-raw-input = root.full-view-raw-input;
                                            root.prev-full-view-raw-output = root.full-view-raw-output;
                                            root.prev-full-view-is-terminal = root.full-view-is-terminal;
                                            root.prev-full-view-is-mcp = root.full-view-is-mcp;
                                            // Switch to nested full view
                                            root.full-view-title = title;
                                            root.full-view-raw-input = input;
                                            root.full-view-raw-output = output;
                                            root.full-view-is-terminal = term;
                                            root.full-view-is-mcp = mcp;
                                            root.full-view-group-idx = -1;
                                            root.full-view-open = true;
                                        }
                                        }
                                        // Per-row trailing gap, 0px when the row
                                        // is hidden -- replaces layout `spacing`
                                        // so collapsed rows contribute nothing.
                                        Rectangle {
                                            height: parent.row-visible ? Metrics.space-2 : 0px;
                                        }
                                    }
                                }
                                if root.full-view-group-idx < 0 && root.full-view-is-terminal : TerminalView {
                                    command: root.full-view-raw-input;
                                    output: root.full-view-raw-output;
                                }
                                if root.full-view-group-idx < 0 && !root.full-view-is-terminal : ApiCallView {
                                    raw-input: root.full-view-raw-input;
                                    raw-output: root.full-view-raw-output;
                                }
                            }
                        }
                    }
                }
            }
        }
        // PUI-002c (background-terminals-ui plan): agent-created terminal
        // cards are no longer always-docked here -- they're opened via
        // the terminals popup above (chip -> popup -> click item ->
        // expand-terminal -> TerminalOverlay in app.slint, unchanged).
        // The docked-by-default `for term in terminals : TerminalCard`
        // block that used to render every live terminal directly in the
        // chat view is removed; `TerminalCard` itself is unused now (the
        // popup's rows are `MentionPickRow`, the full view is
        // `TerminalOverlay`) but stays imported/defined for that overlay
        // path's own internals -- see `terminal_card.slint`'s module doc.
        // Client-local PTY terminal card -- same docking spot as the
        // agent-created terminal cards above (outside the scrollable
        // message Flickable), shown whenever the user has toggled it
        // open via the header button.
        Rectangle {
            height: local-terminal.open ? local-terminal-card.height : 0px;
            visible: local-terminal.open;
            background: Theme.bg-chat;
            HorizontalLayout {
                padding: compact ? 6px : 10px;
                local-terminal-card := LocalTerminalCard {
                    item: local-terminal;
                    compact: compact;
                    horizontal-stretch: 1;
                    preferred-width: 0px;
                    min-width: 0px;
                    expand => { local-terminal-expand-requested(); }
                    key-input(text) => { local-terminal-key-input(text); }
                    close-requested => { local-terminal-close-requested(); }
                }
            }
        }
        // Approval band — full-width bg-approval-band so the strip reads
        // as a decision zone vs chat (bg-chat) and compose (bg-sidebar).
        if root.shown-pending.active : VerticalLayout {
            vertical-stretch: 0;
            // Top hairline only (full border on the band looked heavy).
            Rectangle {
                height: 1px;
                background: Theme.border-strong;
            }
            Rectangle {
                vertical-stretch: 0;
                background: Theme.bg-approval-band;
                HorizontalLayout {
                    width: 100%;
                    padding-left: Metrics.pad-2xl;
                    padding-right: Metrics.pad-2xl;
                    padding-top: Metrics.pad-xs;
                    padding-bottom: Metrics.pad-xs;
                    alignment: stretch;
                    PermissionCard {
                        item: root.shown-pending;
                        horizontal-stretch: 1;
                        vertical-stretch: 0;
                        preferred-width: 0px;
                        min-width: 0px;
                        option-selected(option-id) => { root.handle-permission-option(option-id); }
                        approve() => { root.handle-approve(); }
                        reject() => { root.handle-reject(); }
                    }
                }
            }
        }
        // Separator above the compose bar.
        Rectangle {
            height: 1px;
            background: Theme.border-default;
        }
        // User input + mode/model selectors (extracted ChatInputLayout).
        // vertical-stretch:0 keeps the composer a chrome band so the
        // message Flickable remains the only elastic region (bottom-box
        // cutoff regressions when this band stretched).
        chat-input := ChatInputLayout {
            inputs-enabled: root.inputs-enabled;
            mcp-connect-requested(name) => { root.mcp-connect-requested(name); }
            mcp-enabled-changed(name, enabled) => { root.mcp-enabled-changed(name, enabled); }
            mention-filter-changed(prefix, query) => { root.mention-filter-changed(prefix, query); }
            width: 100%;
            horizontal-stretch: 1;
            vertical-stretch: 0;
            compose-text <=> compose-text;
            sending: sending;
            mode-dropdown-entries: mode-dropdown-entries;
            config-dropdown-entries: config-dropdown-entries;
            mode-trigger-label: mode-trigger-label;
            config-trigger-label: config-trigger-label;
            reasoning-dropdown-entries: reasoning-dropdown-entries;
            reasoning-trigger-label: reasoning-trigger-label;
            permission-mode-dropdown-entries: permission-mode-dropdown-entries;
            permission-mode-trigger-label: permission-mode-trigger-label;
            profile-dropdown-entries: profile-dropdown-entries;
            profile-trigger-label: profile-trigger-label;
            active-thread-has-session: active-thread-has-session;
            fast-mode-available: fast-mode-available;
            fast-mode-enabled: fast-mode-enabled;
            fast-mode-option-id: fast-mode-option-id;
            fast-mode-on-value: fast-mode-on-value;
            fast-mode-off-value: fast-mode-off-value;
            context-ratio: context-ratio;
            context-used-tokens: context-used-tokens;
            context-limit-tokens: context-limit-tokens;
            skill-options: skill-options;
            command-options: command-options;
            mcp-options: mcp-options;
            file-options: file-options;
            terminal-count: root.terminals.length;
            send-requested => { root.handle-send(); }
            queue-fast-track-requested => { root.queue-fast-track-requested(); }
            stop-requested => { stop-requested(); }
            mode-selected(id) => { mode-selected(id); }
            config-option-selected(option-id, value) => { config-option-selected(option-id, value); }
            profile-selected(id, agent) => { profile-selected(id, agent); }
            configure-provider-requested => { configure-provider-requested(); }
            context-view-requested => { context-view-requested(); }
            terminals-clicked => {
                root.terminals-clicked();
                root.terminals-popup-open = !root.terminals-popup-open;
            }
            panel-shortcut(event) => { return panel-shortcut(event); }
        }
    }
    // PUI-002b: boxed-item list popup, anchored above the chip
    // (chat-input's own bottom-of-composer chip row). A sibling of
    // `main-layout` (not inside it) -- same "positioned via explicit x/y,
    // painted outside the managed layout" convention
    // chat_input_layout.slint's own `/`/`@`/`#` mention popup already
    // uses, and for the same reason: a managed layout forbids setting
    // `y` directly on its children. Mirrors that popup's shell (bg-card,
    // border, radius-md, drop-shadow, high z) rather than inventing new
    // popup chrome. Each row reuses MentionPickRow (see its own doc
    // comment on being the shared boxed-list-row primitive) -- status-dot
    // carries `active`, action-label carries the kill action (same
    // pattern as the MCP row's inline "Connect" action).
    if root.terminals-popup-open : Rectangle {
        x: parent.width - self.width - Metrics.pad-2xl;
        // Anchored a fixed margin above the bottom edge (the composer
        // bar's own total height varies with compose-box autosize/
        // row2-compact, so an exact anchor to the chip's own screen
        // position needs that position forwarded up from
        // ChatInputLayout -- left for live-visual-iteration polish per
        // this plan's own stated approach, not a blind first pass).
        y: parent.height - self.height - 140px;
        width: 260px;
        height: terminals-popup-col.preferred-height;
        z: 8000;
        background: Theme.bg-card;
        border-width: 1px;
        border-color: Theme.border-strong;
        border-radius: Theme.radius-md;
        drop-shadow-blur: 14px;
        drop-shadow-color: #000000.with-alpha(0.45);
        drop-shadow-offset-y: 2px;
        clip: true;
        terminals-popup-col := VerticalLayout {
            padding: Metrics.pad-sm;
            spacing: Metrics.space-1;
            for term in root.terminals : MentionPickRow {
                title: term.title != "" ? term.title : term.terminal-id;
                subtitle: term.started-at != "" ? term.last-command + " · " + term.started-at : term.last-command;
                status-dot: term.active ? "connected" : (term.exit-code == 0 ? "" : "error");
                action-label: term.active ? "Kill" : "";
                action-clicked => { root.terminal-kill-requested(term.terminal-id); }
                clicked => {
                    root.terminals-popup-open = false;
                    root.expand-terminal(term.terminal-id);
                }
            }
            if root.terminals.length == 0 : Text {
                text: "No active terminals";
                color: Theme.text-muted;
                font-size: 10px * Theme.font-scale;
                horizontal-alignment: center;
                height: 28px;
                vertical-alignment: center;
            }
        }
    }
    restore-compose-focus => { chat-input.focus-compose(); }

    if !root.onboarding-completed : OnboardingGuideView {
        width: 100%;
        height: 100%;
        z: 9000;
        start-chat-clicked => {
            root.complete-onboarding();
        }
    }
}
