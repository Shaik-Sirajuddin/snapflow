// Shared data-model structs, split out of app.slint so sidebar.slint /
// chat-area.slint / message-card.slint can each `import` just the types
// they need without a circular dependency on the root window component.
export struct ThreadItem {
    name: string,
    relative-time: string,
    status: string, // "idle" | "loading" | "error"
    busy: bool,
    open: bool,
    // Panel-local presentation policy resolved from the durable default
    // and optional per-thread override. This is not an ACPX capability.
    background: bool,
    // Phase 3 (chat-panel-ui-theme-parity.md): one-line preview
    // synthesized from the thread's latest message (Rust-side --
    // `models::describe_thread`), matching index.html's `t.desc` field.
    // Empty string for a thread with no messages yet.
    description: string,
    // Coverage Matrix `session/close`/`session/delete` row: true once
    // an explicit `session/close` (or `session/delete`) has been sent
    // for this thread -- overrides `status`'s display value to
    // `"closed"` and swaps the sidebar row's close control for a
    // delete control. Never set implicitly by window/process teardown.
    closed: bool,
    // setup-followups plan, archive_thread_backend_verify: true once the
    // sidebar's Archive control has been used on this thread. Durable
    // (survives restart, see AgentBridge::archive_thread /
    // ThreadRuntimeSnapshot::archived) and purely a local presentation
    // flag -- archiving does not send any ACP request, it just hides the
    // Archive control and swaps the row's status label to "archived".
    archived: bool,
    // layout-redesign.md Phase 8: the thread's real provider (persisted
    // `AgentBridge::thread_provider`) and active model (the `"model"`
    // config option's current value, the same `configOptions[]` feed the
    // compose bar's model selector reads). Either is "" when unknown --
    // the sidebar row shows the model label only when non-empty.
    provider: string,
    model: string,
    // active_project_binding/thread_item_project_context phase: the
    // project directory this thread's session was opened against (see
    // AgentBridge::thread_project_path). Empty string when unknown/no
    // project was active at creation time -- the sidebar row shows a
    // project-context badge only when this differs from the panel's
    // current active-project-path AND is non-empty.
    project-path: string,
    // Display-only basename of project-path (Slint has no string-split
    // primitive to derive this itself), e.g. "/a/b/foo.mlt" -> "foo.mlt".
    // Empty exactly when project-path is empty.
    project-name: string,
    // setup-followups plan, provider_fastmode_profile_persistence: the
    // profile (agent/provider + terminal/fs policy) this thread will use
    // (or already uses). Empty means "no profile chosen, backend
    // default". Free to change while `has-session` is false; once a real
    // ACP session has attached (open_session_maybe_profiled already only
    // ever reads this once, at session creation -- ACP itself has no
    // primitive for moving a live session to a different backend), the
    // choice is locked, matching Zed's own AgentSessionConfigOptions
    // precedent (free agent choice on an empty draft thread, a new
    // thread once real content exists).
    profile-name: string,
    // True once this thread has a real attached ACP session (a session
    // id is known) -- the profile picker is only interactive while this
    // is false.
    has-session: bool,
}


// Streaming markdown (from streaming-markdown-slint): visual lines/runs.
export struct MarkdownRun {
    text: string,
    bold: bool,
    italic: bool,
    code: bool,
    strike: bool,
    // Phase 17: link target ("" = not a link). Styled Theme.md-link and
    // Ctrl+Click opens it (files locally, URLs in the system browser).
    link: string,
}

export struct MarkdownLine {
    kind: string,
    runs: [MarkdownRun],
    indent: int,
    ordinal: int,
    code-block-id: int,
    // Concatenation of every run's `text` in order -- lets `MarkdownView`
    // overlay one real (invisible) `TextInput` per line for native
    // click-drag selection/copy without re-deriving the joined string
    // from `[MarkdownRun]` in Slint (no reduce/fold over dynamic arrays).
    plain-text: string,
}

export struct MessageItem {
    // chat-items-redesign.md #5/#11: "tool-call" is being retired in
    // favor of the finer taxonomy `models::classify_tool_call_kind`
    // produces ("tool_use" / "mcp_server_call", "skill_load"/"skill_use"
    // reserved but not yet emitted) -- both old and new strings are
    // listed here during the migration since `message_card.slint` still
    // matches the old one until `chat_area.slint`'s routing change lands.
    kind: string, // "user" | "agent" | "thinking" | "tool-call" | "tool_use" | "mcp_server_call" | "skill_load" | "skill_use"
    text: string,
    // Default agent bodies: pre-parsed streaming markdown visual lines.
    // Empty => MarkdownView falls back to plain `text`.
    markdown-lines: [MarkdownLine],
    // Phase 3: tool-call execution status, already-uppercased display
    // text (e.g. "COMPLETED") or "" for non-tool-call kinds / messages
    // cached before this field existed -- monochrome text badge only,
    // see message_card.slint's doc comment.
    status: string,
    // Phase 3: UI-only collapse state for the tool-call log body --
    // Rust-side `Vec<bool>` parallel to the message list (see
    // `PanelSingleton::expanded` in lib.rs), not part of
    // `rui_acp_client::ChatMessage` at all. Ignored for non-tool-call
    // kinds.
    expanded: bool,
    // Phase 3: this message's position in the currently-displayed
    // thread's message list -- round-tripped back through
    // `toggle-expanded(index)` so Rust knows which entry in its
    // `expanded: Vec<bool>` to flip.
    index: int,
    // chat-items-redesign.md #9 (execution-view "api-call" variant):
    // `ChatMessage::raw_input`/`raw_output`, pre-serialized to a display
    // string on the Rust side (Slint has no dynamic-JSON-value type) --
    // "" when the backend didn't provide one, same convention `status`
    // already uses for its own optional field.
    raw-input: string,
    raw-output: string,
    // chat-items-remaining-wiring.md #5 (queued-message send-state): a
    // user message still in the per-thread send queue rather than
    // dispatched -- routed to `QueuedMessageBar` instead of `UserBubble`.
    // `can-edit` is true only for the most-recent queued entry (the spec's
    // edit rule, resolved caller-side against queue order); `sending` is
    // true while its dispatch is actually in flight. All three default
    // false, i.e. an ordinary already-sent transcript message. The Rust
    // send-queue that drives these true is a separate, still-undecided
    // behavioral pass (the plan flags the queue/cancel/edit/stop semantics
    // as a design decision) -- this struct addition is the schema only.
    queued: bool,
    can-edit: bool,
    // true for any queued (non-sending) row -- lets the user jump a
    // message ahead of FIFO order and send it immediately, interrupting
    // whatever's in flight (send_queue.rs's `send_now`/steer subsystem).
    can-send-now: bool,
    sending: bool,
    // chat-items-remaining-wiring.md #6: true on a skill_use row the first
    // time its skill name appears in the thread (drives ToolEventRow's
    // bright accent). False for repeats and every non-skill kind.
    first-use: bool,
    // Only meaningful on the *first* row of a contiguous tool-kind run
    // (chat_area.slint's `is-first-tool-event`): the run's total length,
    // computed once in Rust (`models::assign_tool_group_lengths`). Lets
    // `ToolGroupView`'s "N calls" badge/default-expand and the group's
    // member-visibility check do plain arithmetic (`sub-idx < i +
    // tool-group-len`) instead of an unrolled/capped Slint scan -- Slint
    // `pure function`s support neither loops nor recursion (confirmed by
    // a `pure function` calling itself compiling to a "binding loop"
    // error), so any such scan needs a hand-unrolled, arbitrarily-capped
    // ladder of `if`s. 0 for every other row, including non-start members
    // of the same run.
    tool-group-len: int,
}

// One choice in a pending approval — ACP `PermissionOption` shape
// (`optionId` / `name` / `kind`) projected for Slint. Kinds match the
// protocol: allow_once, allow_always, reject_once, reject_always.
// For non-permission methods (fs/*, terminal/create) the host synthesizes
// Approve/Reject rows with the same shape so the card is always a one-of
// select (Zed's PermissionOptions::Flat model).
export struct PermissionOptionItem {
    option-id: string,
    name: string,
    kind: string,
    // True for allow_* (and synthetic Approve) — drives primary styling.
    is-allow: bool,
}

// Interactive-relay addition: one pending agent-initiated request
// awaiting a user decision (`session/request_permission`, `fs/*`,
// `terminal/create`) -- see `panel-rust/src/permission.rs`'s
// `PendingRequestView`, which this mirrors field-for-field. `active`
// distinguishes "no pending request" (an all-empty/default struct,
// since Slint has no `Option<T>`) from a real one with an empty
// `relay-id` -- callers must check `active` first.
//
// `options` is the one-of select list rendered above the compose bar
// (Zed flat permission buttons). Empty when unsupported; selection
// fires `permission-option-selected(option-id)`.
export struct PendingRequestItem {
    active: bool,
    relay-id: string,
    method: string,
    title: string,
    summary: string,
    supported: bool,
    options: [PermissionOptionItem],
}

// Terminal-view addition: one live agent-created terminal known to the
// currently-displayed thread (`AgentBridge::active_terminal_ids` +
// `terminal_buffer`, see `agent_bridge.rs`). PUI-002b (background-
// terminals-ui plan): opened from the terminals popup rather than always
// docked -- see `terminal_card.slint`/`chat_area.slint`. `title`/`last-
// command` both come from the one real `command` string a `terminal/
// create` request carried (`TerminalBuffer::command`, populated by
// `AgentEvent::TerminalCreated` -- see `agent_bridge.rs`); kept as two
// fields (not one) because the popup list row shows a short `title` while
// a detail view can show the fuller `last-command` (command + args)
// without the popup needing to reformat one shared string differently
// per call site. `active` mirrors `PendingRequestItem.active`'s own
// naming (this struct's own `TerminalBuffer::active()` is the ground
// source, never re-derived here).
export struct TerminalItem {
    terminal-id: string,
    output: string,
    truncated: bool,
    has-exited: bool,
    exit-code: int,
    // Display title for the terminal (the real `command` string from
    // `TerminalBuffer::command`, populated by `AgentEvent::TerminalCreated`).
    title: string,
    // The command that spawned this terminal (command + args), when known.
    last-command: string,
    // Start time (RFC 3339), or "" for a terminal restored from a snapshot
    // persisted before this field existed.
    started-at: string,
    // Whether the terminal's command is still running (not exited).
    active: bool,
}

// Profile-picker addition: one profile row as returned by
// `AgentBridge::list_profiles` (`rui_acpx_client::ProfileSummary`, see
// `models::to_profile_options`). `terminal-enabled`/`fs-enabled` are
// shown as small inline badges so picking a profile makes clear whether
// it will actually unlock terminal/fs approval cards for a new thread,
// rather than the user discovering that only after a request silently
// auto-rejects.
export struct ProfileOption {
    name: string,
    agent-id: string,
    terminal-enabled: bool,
    fs-enabled: bool,
}

// Mode/config selector addition: one entry of the *currently selected
// thread's* live session mode advertisement (`AgentBridge::
// session_modes`, see `rui_acp_client::SessionModesEvent`). Only ever
// non-empty once `session/new`/`session/load` has actually resolved and
// the backend advertised at least one mode -- an empty `available-modes`
// list (Coverage Matrix's "capability-gated selection") means the
// selector renders nothing at all, not a disabled/greyed control.
export struct ModeOption {
    id: string,
    name: string,
    description: string,
}

// Mode/config selector addition: one *row* of the currently selected
// thread's live `configOptions[]` advertisement (`AgentBridge::
// config_options`, see `rui_acp_client::ConfigOptionInfo`). Slint has no
// nested-array-in-struct-in-array construct convenient for a `for`
// loop, so Rust flattens each `ConfigOptionInfo` into one `is-header`
// row (the option's own name/description, not clickable) followed by
// one row per `ConfigOptionInfo::options` entry (`is-header: false`,
// clickable, `is-current` highlighted) -- `chat_area.slint`/`app.slint`
// render this as a single flat `for` loop, switching row visuals on
// `is-header`.
export struct ConfigOptionRow {
    option-id: string,
    is-header: bool,
    // Header row: the option's own display name/description.
    // Value row: the selectable value's own display name/description.
    name: string,
    description: string,
    // Value row only: the literal value string sent back to
    // `session/set_config_option`'s own `value` field.
    value: string,
    is-current: bool,
}

// Settings-sheet addition: one centrally-registered MCP server row, as
// returned by `AgentBridge::list_mcp_servers` (`mcp_servers/list`, see
// `models::to_mcp_server_options`). `command` is shown as a small
// secondary label so the settings list is legible without opening an
// edit dialog -- full entry payloads (env, args, etc.) are opaque JSON
// on the Rust side (`acpx-core::McpServerStore` never interprets more
// than `"name"`), this struct only surfaces what the list view needs.
//
// One tool advertised by an MCP server, individually toggleable. Mirrors
// opencode's per-tool control (its global `tools` glob config, e.g.
// `"my-mcp*": false`) plus its experimental `mcp_lazy`/`mcp_search`
// deferred loading and Claude Code's ToolSearch deferred-tool pattern.
// Backed by a real `tools/list` round trip (`mcp_servers/tools_fetch`,
// `acpx_core::mcp_client`) reconciled with persisted per-tool
// `enabled`/`deferred` preferences -- see `McpServerOption.tools`'s doc
// comment.
export struct McpToolOption {
    name: string,
    // Real description from the tool's `tools/list` advertisement, when
    // the server provided one -- "" otherwise. View-only.
    description: string,
    // `enabled`/`deferred` are carried through from the persisted
    // per-tool preference (`extra["tools"]`) but **deliberately not
    // rendered as interactive controls** in `mcp_servers_view.slint`:
    // checked against the real ACP schema (`agent-client-protocol-
    // schema` 1.4.0, both v1 and v2 -- `McpServerStdio`/`McpServerHttp`/
    // `McpServerSse` have no field for this) and the real MCP spec
    // (tool `annotations` describe *behavior* hints, not an enable/
    // disable switch, and no client-side filtering convention exists
    // either), neither protocol gives acpx a way to actually make a
    // "disabled" tool disappear from what a session's backend agent
    // sees -- toggling this would silently do nothing. Kept as plain
    // data (not removed) so the persisted-preference read/write
    // plumbing survives if this is revisited with a real enforcement
    // mechanism (e.g. acpx becoming a live MCP-traffic intermediary),
    // rather than being ripped out and rebuilt from scratch.
    enabled: bool,
    deferred: bool,
    // Approximate token cost of this tool's schema being included in the
    // model's context (0 when unknown/not yet measured). UI-only estimate
    // -- there is no real per-tool token accounting anywhere in this
    // codebase yet; `mcp_servers_view.slint` shows it purely as a
    // reference figure next to each tool.
    token-usage: int,
}

// Full round-trip data model as of the MCP-server-settings data/
// persistence/OAuth rebuild -- `transport`/`url`/`enabled`/`needs-auth`/
// `auth-status`/`args`/`env`/`headers`/`timeout`/`oauth-client-id` are all
// backed by real typed fields on `acpx_client::mcp::McpServerEntry`
// (`panel-rust::models::to_mcp_server_option_rows` populates them from
// there, not by guessing at an opaque JSON blob's inconsistently-named
// keys the way this struct's fields used to be filled). `status`/`tools`
// remain best-effort passthrough from the entry's opaque `extra` map --
// acpx has no live per-connection health probe or `tools/list` round trip
// yet, so those two are still commonly empty. `env`/`headers` are
// rendered/edited as `KEY=VALUE`/`Header: value` newline-separated text
// rather than a dynamic add/remove row list: this Slint version has no
// array push/slice/concat available in `.slint` code (confirmed
// elsewhere, see `chat_area.slint`'s `full-view` doc comment), so a real
// per-row editor would need new Rust-side `VecModel` plumbing for what is
// otherwise small, rarely-edited transient form state -- the multi-line
// text convention (the same one many `.env`-style editors use) covers the
// same need without it.
export struct McpServerOption {
    name: string,
    command: string,
    // Pre-formatted subtitle from Rust (audit-fixes mcp_status_line_from_rust).
    // Empty hides the status line in mcp_servers_view.
    status-line: string,
    // "stdio" (local command child process) | "http" (remote URL, may
    // need OAuth) -- opencode's `type: "local"` vs `"remote"` split, Zed's
    // command-vs-url, Codex's stdio-vs-streamable_http. Empty string
    // renders no transport tag (pre-transport-field cached rows / backend
    // not yet supplying it).
    transport: string,
    // Remote endpoint (opencode remote `url`) -- only meaningful when
    // `transport == "http"`; "" for a stdio server. Kept distinct from
    // `command` so the view stops overloading one field for two honestly
    // different things (a shell command line vs. an HTTP endpoint).
    url: string,
    // Enable/disable without removing the entry -- opencode/Codex per-server
    // `enabled = false`, Zed's context_servers_disabled.
    enabled: bool,
    // Live connection status, already-lowercased display text (e.g.
    // "connected" | "disconnected" | "error" | "auth required") or "" when
    // unknown -- rendered as plain monochrome text, not a colored dot,
    // matching this project's no-status-color language (see
    // `AgentCatalogEntry.status`'s doc comment).
    status: string,
    // Remote server that advertises an OAuth flow and is not yet
    // authenticated -- surfaces a "Connect" action (opencode remote
    // `oauth` / Codex's `codex mcp login <server>`). Only meaningful when
    // `transport == "http"`.
    needs-auth: bool,
    // OAuth/auth outcome as already-lowercased monochrome display text
    // (e.g. "authenticated" | "not authenticated" | "auth failed") or ""
    // when auth doesn't apply (stdio server) -- distinct from `needs-auth`
    // (which only gates whether "Connect" shows): this reports the actual
    // authenticated-vs-not state, never as a colored badge.
    auth-status: string,
    // Tools this server advertises, reconciled from a real MCP `tools/
    // list` fetch (once one has run -- see `tool-fetch-status`) with any
    // already-persisted per-tool enable/deferred preference. Empty list
    // renders no tool section (never fetched yet, and no preference was
    // ever recorded for any tool on this server).
    tools: [McpToolOption],
    // Status of the real background `tools/list` probe kicked off by the
    // "Fetch tools"/"Refresh tools" button (`mcp_servers/tools_fetch`,
    // see `panel-rust::models::to_mcp_server_option_rows`'s doc comment):
    // "" (never fetched), "fetching", "ready", or "error". Drives that
    // button's label/enabled state.
    tool-fetch-status: string,
    // Real error text from a failed fetch (empty unless `tool-fetch-
    // status == "error"`).
    tool-fetch-error: string,
    // Pre-joined `name`/`description` of every tool in `tools`
    // (newline-separated, Rust-computed) -- lets the page-level search
    // bar match a server by one of its real discovered tool names
    // without Slint needing an array-reduce it doesn't have.
    tools-search-blob: string,
    // False for built-in, session-injected servers the user cannot delete
    // (PUI-015: the `snapshotd` daemon MCP, always injected into every
    // session while the daemon is reachable -- it is not a user registry
    // entry, so the Settings view hides its "Remove" action). True (the
    // default for every acpx-registry row) means the user added it and may
    // remove it.
    removable: bool,
    // Stdio-transport fields, "" / empty for an http server.
    args: string,
    env: string,
    // Http-transport fields, "" / empty for a stdio server.
    headers: string,
    // Shared: "" means unset for either transport.
    timeout: string,
    // Set only for an http server with `oauth.client_id` configured --
    // gates whether the OAuth "Connect"/"Logout" actions in
    // `mcp_servers_view.slint` are even reachable, independent of
    // `needs-auth` (which additionally requires not-yet-authenticated).
    oauth-client-id: string,
}

// One `KEY=VALUE`/`Header: value` line, parsed/formatted entirely on the
// Rust side (`models.rs`'s `format_env_lines`/`parse_env_lines` and their
// header equivalents) -- kept as a struct here only so a future real
// per-row editor (if this Slint version ever gains array mutation
// support) has a ready-made element type; today's
// `KeyValueListEditor` renders/edits the newline-joined `string` form
// directly, no `[KeyValueEntry]` model involved yet.
export struct KeyValueEntry {
    key: string,
    value: string,
}

// Add/edit-server form submission (`mcp_servers_view.slint`'s single
// combined callback, `mcp-server-submit`) -- carries every field either
// transport needs so `PanelSingleton::dispatch_mcp_server_submit` (Rust)
// can build a full typed `McpServerEntry` and call `mcp_servers/create`
// or `mcp_servers/update` in one shot, instead of the old two-string
// `mcp-server-create(name, command)` shortcut that silently dropped
// everything else.
export struct McpServerFormData {
    name: string,
    // "stdio" | "http".
    transport: string,
    command: string,
    // Whitespace-separated (parsed with Rust's `str::split_whitespace`,
    // so quoting/escaping is not supported -- matches the level of a
    // single plain-text field, not a real shell parser).
    args: string,
    // `KEY=VALUE` per line.
    env: string,
    url: string,
    // `Header-Name: value` per line.
    headers: string,
    // Decimal seconds; "" means unset.
    timeout: string,
    oauth-client-id: string,
    // True when this submission should `mcp_servers/update` the
    // already-existing entry named `name` instead of `mcp_servers/create`
    // a new one -- set by `mcp_servers_view.slint` when the form was
    // opened via a row's "Edit" action.
    is-edit: bool,
}

// Skill-manager sidebar/settings row -- `skill_discovery_backend` phase of
// `memory/designa/gen/plans/skill-manager-workspace/`. Filesystem-derived
// (no backend RPC), built from `skills_state::SkillEntry` via
// `models::to_skill_options`.
export struct SkillOption {
    name: string,
    description: string,
    // "global" | "project" -- which skills directory this was discovered
    // in (memory/designa/gen/plans/skill-manager-workspace/
    // 01-architecture.md's resolved storage split).
    scope: string,
    // Absolute path to the skill's directory, for the editor-view /
    // "open in <editor>" flow (active_pane_and_editor_view phase).
    path: string,
    // Global skill id this project-local skill was instantiated from, or
    // "" when not applicable (global skills, or a project skill created
    // from scratch) -- `skills-management`'s "show project_start skills
    // include global `started_from`".
    started-from: string,
}

// Recovery/import sheet addition (Coverage Matrix `session/list` row):
// one entry from `AgentBridge::recoverable_sessions` -- a real remote
// gateway session not currently bound to any local thread row.
// `title`/`updated_at` are backend-reported ACP metadata (may be
// empty -- not every backend sets them).
export struct RemoteSessionOption {
    session_id: string,
    provider: string,
    title: string,
    updated_at: string,
}

// Settings-sheet addition: one agent-catalog entry, as returned by
// `AgentBridge::list_agents` (`agents/list`, see `models::
// to_agent_catalog_entries`). `status` is the registry's own live
// detection string (`acpx_proto::AgentStatus`'s serde tag, e.g.
// "installed" / "not_installed" / "installed_no_session" /
// "runtime_missing") -- rendered as plain monochrome text, not a
// colored badge, matching this project's established no-status-color
// design language (see `component-style-system.md`).
export struct AgentCatalogEntry {
    id: string,
    name: string,
    version: string,
    status: string,
    // setup-followups plan, agent_settings_ordering_and_install_enable_
    // flow: current admin-plane enablement, merged in client-side (see
    // AgentBridge::agent_enablement_map's doc comment) since agents/list
    // itself carries no enablement concept. Defaults true.
    enabled: bool,
}

// Client-local PTY terminal addition: a snapshot of the currently
// selected thread's own client-spawned shell process (`AgentBridge::
// local_terminal_snapshot`, see `local_terminal::LocalTerminal`'s doc
// comment). Distinct from `TerminalItem` (agent-created, read-only,
// relayed from the gateway) -- this one is interactive: the card that
// renders it also captures keyboard input and forwards it back via
// `local-terminal-input(string)`. `open` mirrors `PendingRequestItem`'s
// "all-empty/default struct means nothing is open" convention (Slint
// has no `Option<T>`).
export struct LocalTerminalItem {
    open: bool,
    screen-text: string,
    cols: int,
    rows: int,
    cursor-row: int,
    cursor-col: int,
    has-exited: bool,
}

// Domain-neutral option row for `base/searchable_dropdown.slint` -- kept
// out of the chat-specific structs above so the base primitive depends on
// no domain type. Callers (the compose bar's mode/model selectors, later
// the slash-command popup) build these from their own source data (Rust
// `models::to_*_dropdown_entries`). A row with `is-header: true` renders
// as a non-selectable section label; `value` is the opaque payload handed
// back to the selection callback alongside `id` (e.g. a config option's
// `session/set_config_option` value; empty for a plain mode row).
export struct DropdownEntry {
