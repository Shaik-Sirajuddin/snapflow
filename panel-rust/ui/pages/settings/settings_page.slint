// Settings page root -- the settings-pane-redesign plan's `SettingsPage`
// (see "Component layout"). Replaces the former flat, single-scroll
// `components/settings_sheet.slint` with a two-level tab shell: top tabs
// `[Project | Global]`, a left-tab section rail (`MCP Servers` / `Agents`
// / `Harness`), and a search bar above the active section's content. This
// phase is shell-only -- `scope`/`active-section`/`search-query` are new
// page-local UI state, but every view still binds the exact same
// ACP-RPC-driven models (`available-profiles`, `available-mcp-servers`,
// `agent-catalog`, `recoverable-sessions`) `settings_sheet.slint` did, via
// the same round-trip callbacks (`lib.rs` still owns re-populating those
// lists after any create/update/delete/install call -- nothing here
// optimistically mutates them).
//
// settings_scope_visibility_gate: `scope` now DOES have a real behavioral
// effect -- it gates visibility of every settings category that is
// unconditionally global (no per-project dimension exists on the backend
// at all, regardless of which tab is showing it): the MCP Servers section
// (whole `McpServerStore` registry, gated by hiding its left-tab nav item
// entirely -- see left_tabs.slint), agent enable/disable and the
// install action (`AgentCard`'s own `scope` prop, gated inside
// agent_card.slint), the profile registry browse/create/delete row
// (agents_view.slint), and the Dev mode toggle (skills_view.slint).
// Everything genuinely dual-tier -- default profile, permission profile,
// default agent id, background-session-default -- has a real Project-file
// value that overrides/falls back to Global (`settings_file.rs`'s
// `SettingsDocument` merge) and stays visible/editable under both tabs
// unchanged.
import { Theme } from "../../tokens/theme.slint";
import { Metrics } from "../../tokens/metrics.slint";
import { Button } from "../../base/buttons/button.slint";
import { Icon } from "../../base/icon.slint";
import { IconButton } from "../../base/buttons/icon_button.slint";
import { SettingsTopTabs } from "components/top_tabs.slint";
import { SettingsLeftTabs } from "components/left_tabs.slint";
import { SettingsSearchBar } from "components/search_bar.slint";
import { ThinScrollbar } from "../../base/layout/thin_scrollbar.slint";
import { Text } from "../../base/text/base_text.slint";
import { McpServersView } from "views/mcp_servers_view.slint";
import { AgentsView } from "views/agents_view.slint";
import { HarnessView } from "views/harness_view.slint";
import { SkillsView } from "views/skills_view.slint";
import { ProfileOption, McpServerOption, McpServerFormData, AgentCatalogEntry, RemoteSessionOption, SkillOption } from "../../types.slint";

export component SettingsPage inherits Rectangle {
    // New shell-only state (settings-pane-redesign plan, phase 1).
    // "project" | "global". MUST stay identical to app.slint's own
    // `settings-scope` default: the two are joined by a `<=>` two-way
    // alias (`scope <=> root.settings-scope`), and Slint resolves that
    // alias to the OUTER property's default with no diagnostic at all, so
    // a mismatch here is silently dead code that only shows up when this
    // component is rendered standalone (ui-dev-viewer, component tests).
    // The live app never observes either literal -- lib.rs computes the
    // real scope from SettingsPaths and pushes it synchronously during
    // panel construction, before the window is shown.
    in-out property <string> scope: "global";
    // Default must be a section valid under BOTH scopes -- "mcp_servers"
    // is Global-only (see settings_scope_visibility_gate below), and the
    // `changed scope` redirect that guards against landing on it doesn't
    // fire on initial mount (Rust's model.settings_scope sync is also
    // "project" by default, so no actual change event occurs), which used
    // to leave the page opening to a blank pane. "agents" renders under
    // both scopes.
    in-out property <string> active-section: "agents"; // "mcp_servers" | "agents" | "harness" | "skills"
    in-out property <string> search-query: "";
    in-out property <bool> sections-expanded: true;
    // See FilterSearchBar.input-has-focus's doc comment. The AgentsView
    // section only exists while active-section == "agents" (a conditional
    // element that must stay conditional -- see its own comment below), so
    // it can't be referenced directly; agents-search-focus-mirror is kept
    // in sync with it via a changed handler instead, and reset whenever
    // that section isn't the active one (the element -- and its changed
    // handler -- gets torn down on tab switch, so nothing else would ever
    // clear a stale `true` left over from switching away mid-focus).
    property <bool> agents-search-focus-mirror: false;
    // Same mirror pattern as agents-search-focus-mirror, for
    // McpServersView's own add-server name/command TextField fields (see
    // TextField.has-focus's doc comment) -- McpServersView is likewise a
    // conditional element (`if root.active-section == "mcp_servers"`)
    // that can't be referenced directly outside its own scope.
    property <bool> mcp-servers-focus-mirror: false;
    property <bool> skills-search-focus-mirror: false;
    changed active-section => {
        if (self.active-section != "agents") {
            self.agents-search-focus-mirror = false;
        }
        if (self.active-section != "mcp_servers") {
            self.mcp-servers-focus-mirror = false;
        }
        if (self.active-section != "skills") {
            self.skills-search-focus-mirror = false;
        }
    }
    // settings_scope_visibility_gate: MCP Servers' left-tab nav item only
    // exists under Global scope (see left_tabs.slint) -- if the user was
    // sitting on that section and flips to Project, redirect off it so
    // the content pane isn't left mounted on a now-nonexistent tab.
    changed scope => {
        if (self.scope == "project" && self.active-section == "mcp_servers") {
            self.active-section = "agents";
        }
    }
    // Same redirect precedent as the scope handler above -- if the user was
    // sitting on the Harness tab and BETA_MODE flips off, redirect off it
    // so the content pane isn't left mounted on a now-hidden tab.
    changed beta-mode-enabled => {
        if (!self.beta-mode-enabled && self.active-section == "harness") {
            self.active-section = "agents";
        }
    }
    out property <bool> search-has-focus:
        top-search-bar.input-has-focus || agents-search-focus-mirror
        || mcp-servers-focus-mirror || skills-search-focus-mirror;

    // Same public API `SettingsSheet` exposed -- unchanged so `app.slint`'s
    // call site only needs its component name + import swapped.
    in-out property <string> default-profile: "";
    in-out property <string> permission-profile: "";
    // Env-var feature-flag gate (PANEL_PROFILE_WIRING_ENABLED) for the
    // default-profile/permission-profile controls above -- see
    // app.slint's own doc comment for this same property.
    in property <bool> profile-wiring-enabled: false;
    // Env-var feature-flag gate (BETA_MODE) -- see app.slint's own doc
    // comment for this same property. Additive on top of
    // profile-wiring-enabled for the Profile field (agents_view.slint);
    // independently gates the whole Harness tab (left-tabs nav item +
    // HarnessView mount below).
    in property <bool> beta-mode-enabled: false;
    in-out property <bool> background-default: false;
    in-out property <string> default-agent-id: "";
    // Genuinely dual-tier like `background-default` -- see
    // `settings_file::SettingsDocument::show_global_skills`'s doc comment.
    // Forwarded to `SkillsView` below via `<=>` the same way.
    in-out property <bool> show-global-skills: true;
    in-out property <bool> background-override-set: false;
    in-out property <bool> background-override: false;
    in property <[ProfileOption]> available-profiles: [];
    in property <[McpServerOption]> available-mcp-servers: [];
    in property <int> mcp-tools-total-count: 0;
    in property <bool> mcp-server-submit-busy: false;
    in property <[AgentCatalogEntry]> agent-catalog: [];
    in property <[RemoteSessionOption]> recoverable-sessions: [];
    in property <[SkillOption]> available-skills: [];
    in property <bool> dev-mode: false;

    callback save();
    callback close();
    callback scope-changed(string);
    callback mcp-server-submit(McpServerFormData);
    callback mcp-server-delete(string);
    callback mcp-server-enabled-changed(string, bool);
    callback mcp-server-authenticate(string);
    callback mcp-server-logout(string);
    callback mcp-server-tool-enabled-changed(string, string, bool);
    callback mcp-server-tool-deferred-changed(string, string, bool);
    callback mcp-server-tools-fetch-requested(string);
    callback profile-create(string, string, bool, bool);
    callback profile-delete(string);
    callback agent-install-requested(string);
    callback agent-set-enabled(string, bool);
    callback agent-website-clicked(string);
    callback recover-session-attach(string, string, string);
    callback skill-promote-to-global(string);
    callback dev-mode-toggled(bool);

    background: Theme.bg-card;
    border-color: Theme.border-strong;
    border-width: 1px;
    border-radius: Theme.radius-md;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: Metrics.space-7;
        spacing: Metrics.space-6;

        header-row := HorizontalLayout {
            height: 36px;
            spacing: Metrics.space-3;

            VerticalLayout {
                horizontal-stretch: 0;
                height: parent.height;
                alignment: center;
                IconButton {
                    button-accessible-label: root.sections-expanded
                        ? "Collapse settings navigation"
                        : "Expand settings navigation";
                    clicked => { root.sections-expanded = !root.sections-expanded; }
                    Icon {
                        source: @image-url("../../assets/icons/panel-left.svg");
                        size: 16px;
                        color: Theme.text-secondary;
                    }
                }
            }

            Text {
                text: "Settings";
                color: Theme.text-primary;
                weight: "bold";
                vertical-alignment: center;
            }
        }

        // Phase 31 (settings_search_responsive_layout): scope switcher and
        // the settings search share ONE line -- the search field takes all
        // remaining width instead of sitting cramped on its own row.
        scope-search-row := HorizontalLayout {
            // Concrete width, same padding-subtraction rationale as the
            // content row below (an explicit width bypasses the padded
            // parent's automatic stretch inset).
            width: parent.width - 2 * Metrics.space-7;
            height: 28px;
            spacing: Metrics.space-4;

            top-tabs := SettingsTopTabs {
                width: 148px;
                horizontal-stretch: 0;
                scope: root.scope;
                scope-selected(new-scope) => {
                    root.scope = new-scope;
                    root.scope-changed(new-scope);
                }
            }

            top-search-bar := SettingsSearchBar {
                // Temporarily hidden while the settings information
                // architecture settles. Keep the binding/wiring intact so
                // the page-level filter can be restored without reworking
                // the section views.
                visible: false;
                width: 0px;
                placeholder: "Search settings...";
                bar-accessible-label: "Search settings";
                query <=> root.search-query;
            }
        }

        HorizontalLayout {
            // Deterministic height AND width, not `vertical-stretch` /
            // `horizontal-stretch` -- in this three-level Vertical >
            // Horizontal > Vertical > Flickable nesting, stretch factors
            // never actually propagated real space down from an ancestor
            // (confirmed for height by giving this row a hardcoded height,
            // which *did* expand correctly; the same turned out to be true
            // for width once the "agents tab still doesn't take full
            // width" symptom was traced the same way). This row's own
            // width IS safe to bind to a concrete expression here (unlike
            // lower down the tree) because the outer `VerticalLayout`
            // above has an explicit, concrete `width: parent.width` of
            // its own (ultimately anchored to the page's real width, not
            // another stretch factor) -- binding to a concrete ancestor
            // is fine, binding to a still-unresolved stretch-based one is
            // what caused binding-loop compile errors earlier.
            //
            // MUST subtract padding here -- this row is a *direct* child
            // of that padded outer VerticalLayout (`padding:
            // Metrics.space-7`). `width: parent.width` (this row's
            // previous binding) reads the padded layout's *raw* box
            // width, not its padding-inset content width -- the padding
            // property only gets applied automatically by the layout's
            // own default `alignment: stretch` sizing, which an explicit
            // width override replaces entirely. The `height` binding
            // right below already (correctly) subtracts `2 *
            // Metrics.space-7`; `width` never did, which is the actual
            // root cause behind "the search bar doesn't respect the
            // window edge" and every other padding complaint on this
            // page -- literally everything (search bar, MCP/Agents/
            // Harness views) nests inside this one row, so its own
            // padding-bypass cascaded into all of them at once.
            width: parent.width - 2 * Metrics.space-7;
            height: parent.height - 2 * Metrics.space-7
                - header-row.height - scope-search-row.height - save-row.height
                - 3 * Metrics.space-6;
            spacing: Metrics.space-6;

            left-tabs := SettingsLeftTabs {
                active-section: root.active-section;
                expanded: root.sections-expanded;
                scope: root.scope;
                beta-mode-enabled: root.beta-mode-enabled;
                section-selected(new-section) => { root.active-section = new-section; }
                collapse-requested => { root.sections-expanded = false; }
            }

            VerticalLayout {
                // Computed from the now-concrete parent width, same
                // reasoning as above -- `horizontal-stretch: 1` alone
                // wasn't propagating real width down this chain either.
                width: parent.width - left-tabs.width - Metrics.space-6;
                vertical-stretch: 1;
                spacing: Metrics.space-4;

                // settings_agents_search_sticky: the Agents section owns
                // its own bounded scroll region (see agents_view.slint's
                // own internal Flickable/ThinScrollbar) so its
                // "search agents" bar can stay pinned above the scrolling
                // agent grid/recoverable-sessions body -- pinning it would
                // not be possible if AgentsView shared the single generic
                // Flickable below with the other sections, since that
                // Flickable scrolls its whole mounted child (search bar
                // included) as one unit. Same `vertical-stretch: 1` +
                // `preferred-height: 0px` + `min-height: 0px` convention
                // used everywhere else in this file to hand a Flickable
                // (or, here, a self-scrolling component) real bounded
                // height inside a VerticalLayout.
                if root.active-section == "agents" : AgentsView {
                    width: parent.width;
                    vertical-stretch: 1;
                    preferred-height: 0px;
                    min-height: 0px;
                    scope: root.scope;
                    default-profile <=> root.default-profile;
                    permission-profile <=> root.permission-profile;
                    profile-wiring-enabled: root.profile-wiring-enabled;
                    beta-mode-enabled: root.beta-mode-enabled;
                    default-agent-id <=> root.default-agent-id;
                    available-profiles: root.available-profiles;
                    agent-catalog: root.agent-catalog;
                    page-search-query: root.search-query;
                    recoverable-sessions: root.recoverable-sessions;
                    profile-create(name, agent-id, terminal-enabled, fs-enabled) => {
                        root.profile-create(name, agent-id, terminal-enabled, fs-enabled);
                    }
                    profile-delete(name) => { root.profile-delete(name); }
                    agent-install-requested(id) => { root.agent-install-requested(id); }
                    agent-set-enabled(id, enabled) => { root.agent-set-enabled(id, enabled); }
                    agent-website-clicked(website) => { root.agent-website-clicked(website); }
                    recover-session-attach(session-id, provider, title) => {
                        root.recover-session-attach(session-id, provider, title);
                    }
                    changed search-has-focus => {
                        root.agents-search-focus-mirror = self.search-has-focus;
                    }
                }

                // The other three sections have no pinned-header need, so
                // they keep sharing one generic scrolling viewport.
                if root.active-section != "agents" : Rectangle {
                    // The one elastic region in this column -- same
                    // `vertical-stretch: 1` + `preferred-height: 0px` +
                    // `min-height: 0px` convention `chat_area.slint`'s own
                    // message-scroll Flickable uses, rather than binding
                    // `height: parent.height` (that only resolves once the
                    // layout has already assigned this Flickable a height,
                    // which a plain binding can't rely on inside a
                    // `VerticalLayout`). Wrapped in a plain (non-layout)
                    // Rectangle, same as chat_area.slint's `message-area`,
                    // so the ThinScrollbar sibling below can be positioned
                    // as a free-floating overlay instead of being packed
                    // into the vertical flow by a layout parent.
                    vertical-stretch: 1;
                    preferred-height: 0px;
                    min-height: 0px;

                    // settings_scrollbar_discoverability: the ThinScrollbar
                    // below has no `active` binding, so -- same as every
                    // other bare-hover ThinScrollbar in this codebase before
                    // it got one (see chat_input_layout.slint's row2 strip
                    // and searchable_dropdown.slint) -- it only fades in
                    // while the pointer sits exactly over its ~10px hit
                    // zone at the far edge, not while the user is actually
                    // scrolling the content by wheel or drag. Flickable has
                    // no `pressed` property to mirror the `row2-scroll.
                    // pressed` pattern those two use (only a TouchArea
                    // exposes that), so this tracks "recently scrolled" via
                    // `changed viewport-y` + a short idle timer instead --
                    // the scrollbar lights up the instant a real scroll
                    // happens (wheel included) and fades a beat after it
                    // stops, rather than requiring a pixel-perfect hover.
                    property <bool> scroll-recently-active: false;
                    scroll-idle-timer := Timer {
                        interval: 900ms;
                        running: false;
                        triggered => {
                            scroll-recently-active = false;
                            self.running = false;
                        }
                    }

                    other-sections-scroll := Flickable {
                        width: parent.width;
                        height: parent.height;
                        // Was missing entirely (the actual reported "scroll
                        // issues" bug) -- a bare Flickable doesn't reliably
                        // report its own preferred-height from arbitrary child
                        // content (it's a scroll viewport, not a layout), so
                        // without this the Flickable had no real idea how tall
                        // its content actually was and couldn't scroll far
                        // enough (or at all) to reach content past the visible
                        // area. Every other Flickable in this codebase already
                        // binds this explicitly (confirmed by grepping every
                        // Flickable site); this was the one exception. Same
                        // fix `base/expandable_panel.slint`'s own Flickable
                        // documents for the identical symptom.
                        viewport-height: content.preferred-height;
                        changed viewport-y => {
                            scroll-recently-active = true;
                            scroll-idle-timer.running = false;
                            scroll-idle-timer.running = true;
                        }
                        content := VerticalLayout {
                            width: parent.width;
                            if root.active-section == "mcp_servers" && root.scope == "global" : McpServersView {
                                width: parent.width;
                                servers: root.available-mcp-servers;
                                total-tools-count: root.mcp-tools-total-count;
                                submit-busy: root.mcp-server-submit-busy;
                                page-search-query: root.search-query;
                                mcp-server-submit(data) => { root.mcp-server-submit(data); }
                                mcp-server-delete(name) => { root.mcp-server-delete(name); }
                                mcp-server-enabled-changed(name, enabled) => {
                                    root.mcp-server-enabled-changed(name, enabled);
                                }
                                mcp-server-authenticate(name) => {
                                    root.mcp-server-authenticate(name);
                                }
                                mcp-server-logout(name) => {
                                    root.mcp-server-logout(name);
                                }
                                mcp-server-tool-enabled-changed(server-name, tool-name, enabled) => {
                                    root.mcp-server-tool-enabled-changed(server-name, tool-name, enabled);
                                }
                                mcp-server-tool-deferred-changed(server-name, tool-name, deferred) => {
                                    root.mcp-server-tool-deferred-changed(server-name, tool-name, deferred);
                                }
                                mcp-server-tools-fetch-requested(server-name) => {
                                    root.mcp-server-tools-fetch-requested(server-name);
                                }
                                changed search-has-focus => {
                                    root.mcp-servers-focus-mirror = self.search-has-focus;
                                }
                            }
                            if root.active-section == "harness" && root.beta-mode-enabled : HarnessView {
                                width: parent.width;
                                background-default <=> root.background-default;
                                background-override-set <=> root.background-override-set;
                                background-override <=> root.background-override;
                            }
                            if root.active-section == "skills" : SkillsView {
                                width: parent.width;
                                scope: root.scope;
                                skills: root.available-skills;
                                dev-mode: root.dev-mode;
                                show-global-skills <=> root.show-global-skills;
                                // page-search-query/search-has-focus wiring:
                                // was previously missing entirely on this
                                // branch, leaving `skills-search-focus-mirror`
                                // (declared above) dead and the Skills tab's
                                // search bar non-functional -- SkillsView's
                                // own `matches-search` filtering already
                                // depends on `page-search-query` being fed a
                                // real value (see skills_view.slint).
                                page-search-query <=> root.search-query;
                                skill-promote-to-global(path) => { root.skill-promote-to-global(path); }
                                dev-mode-toggled(enabled) => { root.dev-mode-toggled(enabled); }
                                changed search-has-focus => {
                                    root.skills-search-focus-mirror = self.search-has-focus;
                                }
                            }
                        }
                    }

                    // settings_page_scrollbar: was previously a bare
                    // Flickable with scroll mechanics but no visible
                    // scrollbar -- same class of gap the compose-bar
                    // horizontal-scroll row had (chat_input_layout.slint)
                    // before it got its own ThinScrollbar. Reuses that same
                    // component/pattern chat_area.slint's message list uses.
                    ThinScrollbar {
                        x: parent.width - self.width - 2px;
                        y: 4px;
                        visible-height: parent.height - 8px;
                        viewport-height: content.preferred-height;
                        viewport-y <=> other-sections-scroll.viewport-y;
                        thumb-width: 4px;
                        active: scroll-recently-active;
                    }
                }
            }
        }

        save-row := HorizontalLayout {
            height: 30px;
            spacing: Metrics.space-4;
            alignment: end;
            Button {
                label: "Save";
                button-accessible-label: "Save chat settings";
                primary: true;
                btn-width: 72px;
                btn-height: 30px;
                font-size: 13px;
                font-weight: 400;
                clicked => { root.save(); }
            }
            Button {
                label: "Close";
                button-accessible-label: "Close chat settings";
                btn-width: 72px;
                btn-height: 30px;
                font-size: 13px;
                font-weight: 400;
                border-w: 0px;
                clicked => { root.close(); }
            }
        }
    }
}
