import { Theme } from "../../../tokens/theme.slint";
import { Metrics } from "../../../tokens/metrics.slint";
import { Strings } from "../../../tokens/strings.slint";
import { Button } from "../../../base/button.slint";
import { TextField } from "../../../base/text_field.slint";
import { SettingsRow } from "../../../base/settings_row.slint";
import { SettingsSection, SettingsSectionHeader, SettingsField, SettingsDivider } from "../../../base/settings_section.slint";
import { ThinScrollbar } from "../../../base/thin_scrollbar.slint";
import { SettingsSearchBar } from "../components/search_bar.slint";
import { AgentCard } from "../components/agent_card.slint";
import { ProfileOption, AgentCatalogEntry, RemoteSessionOption } from "../../../types.slint";
import { TextUtil } from "../../../base/text_util.slint";
import { SelectableChip } from "../../../base/selectable_chip.slint";

// Agents left-tab view -- phase 1 shell. Re-hosts every slice of the
// former `components/settings_sheet.slint` that is agent/profile/session
// shaped and doesn't cleanly belong under MCP Servers or Harness: the
// profile picker + profile management (`profiles/*`, default agent
// behavior per chat), the agent catalog itself (`agents/list`,
// install-only per the current Rust-side reality -- see the
// settings-pane-redesign plan's "Rust-side reality check"), and
// Recoverable Sessions (real gateway sessions re-attached onto a thread
// for a given agent/provider). All three are agent-catalog/profile-
// adjacent, unlike the MCP-server registry or the (currently
// thread-background-only) Harness section, so they land here rather than
// being split into a fourth left tab that the plan's "Component layout"
// section doesn't call for. No new fields, no new data wiring -- same
// models/callbacks `settings_sheet.slint` already used.
export component AgentsView inherits Rectangle {
    // settings_scope_visibility_gate: "project" | "global", mirrored from
    // SettingsPage.scope. This view mixes genuinely dual-tier fields
    // (default-profile/permission-profile TextFields below, and
    // default-agent-id via AgentCard's make-default toggle) with
    // global-only registry browsing (the profile chip picker/delete row --
    // profile.rs's ProfileStore has no per-project dimension -- and each
    // AgentCard's install/enable controls, gated inside AgentCard itself
    // via its own `scope` prop). The dual-tier fields stay unconditional;
    // only the global-only pieces are gated here.
    in property <string> scope: "project";
    in-out property <string> default-profile: "";
    in-out property <string> permission-profile: "";
    // Env-var feature-flag gate (PANEL_PROFILE_WIRING_ENABLED, read in
    // lib.rs's profile_wiring_enabled() and threaded down through
    // settings_page.slint / app.slint). Off by default: the default-
    // profile/permission-profile SettingsFields below are hidden
    // entirely (not just disabled) in both Project and Global scope
    // until this is turned on. Orthogonal to `scope` -- unlike the
    // profile-registry chip picker below (gated Global-only in
    // 6745aa0e), these two fields stay dual-tier once the flag is on.
    in property <bool> profile-wiring-enabled: false;
    in property <[ProfileOption]> available-profiles: [];
    in property <[AgentCatalogEntry]> agent-catalog: [];
    in property <[RemoteSessionOption]> recoverable-sessions: [];
    // Mirror pattern (see settings_page.slint's agents-search-focus-mirror
    // doc comment): now that the default-profile/permission-profile
    // TextFields live inside `if root.profile-wiring-enabled` blocks below,
    // they're conditional elements and can't be referenced directly from
    // search-has-focus outside their own scope. These mirrors are updated
    // from inside each block's own `changed has-focus` handler instead, and
    // reset to false when the flag flips off (the block tears down, so
    // nothing else would ever clear a stale `true` left over from
    // switching away mid-focus).
    property <bool> default-profile-focus-mirror: false;
    property <bool> permission-profile-focus-mirror: false;
    changed profile-wiring-enabled => {
        if (!self.profile-wiring-enabled) {
            self.default-profile-focus-mirror = false;
            self.permission-profile-focus-mirror = false;
        }
    }
    // See FilterSearchBar.input-has-focus's doc comment. Also covers the
    // plain TextField instances below (default-profile/permission-profile)
    // -- those never had any focus state to aggregate here at all until
    // TextField.has-focus was added (see its own doc comment), which had
    // silently dropped every keystroke typed into either field.
    out property <bool> search-has-focus:
        agent-search-bar.input-has-focus
        || default-profile-focus-mirror
        || permission-profile-focus-mirror;
    callback profile-create(string, string, bool, bool);
    callback profile-delete(string);
    callback agent-install-requested(string);
    callback recover-session-attach(string, string, string);
    // Connect/disconnect a single agent's live session. UI-only
    // placeholders -- there is no per-agent connect/disconnect RPC in
    // `src/agent_bridge.rs` today (only `agents/install`), so these are
    // terminated here (empty handlers on the cards) exactly like
    // `mcp_servers_view.slint`'s "Connect" button. Declared so the seam
    // exists when a real `agents/connect` round trip lands.
    callback agent-connect-requested(string);
    callback agent-disconnect-requested(string);
    // setup-followups plan, agent_settings_ordering_and_install_enable_
    // flow: the real "install > enable" second step, distinct from
    // connect/disconnect above -- routes through the admin plane
    // (AgentBridge::set_agent_enabled), not agents/connect.
    callback agent-set-enabled(string, bool);

    property <string> new-profile-name: "";
    property <string> new-profile-agent-id: "";
    property <bool> new-profile-terminal-enabled: false;
    property <bool> new-profile-fs-enabled: false;
    // Armed-delete confirmation state -- see settings_sheet.slint's
    // original doc comment on `profile-pending-delete` for why this is a
    // two-step confirm rather than an immediate delete.
    property <string> profile-pending-delete: "";

    // Agents-grid-local search -- scoped to this grid (not the page-level
    // SettingsSearchBar). Uses TextUtil.matches-filter (Rust contains-ci)
    // against each card's name + id, same helper as sidebar thread/skill
    // search. Empty query shows the full catalog.
    property <string> agent-search-query: "";
    // Page-level SettingsSearchBar (settings_page_search_filter).
    in property <string> page-search-query: "";
    in-out property <string> default-agent-id: "";

    pure function agent-matches(index: int) -> bool {
        if (index < 0 || index >= root.agent-catalog.length) {
            return false;
        }
        if (root.agent-search-query == "" && root.page-search-query == "") {
            return true;
        }
        // Match name or id (name may be empty for some catalog rows).
        // Inline hay twice — SharedString is moved into matches-filter.
        if (root.agent-search-query != ""
            && !TextUtil.matches-filter(
                root.agent-catalog[index].name + "\n" + root.agent-catalog[index].id,
                root.agent-search-query,
            )) {
            return false;
        }
        if (root.page-search-query != ""
            && !TextUtil.matches-filter(
                root.agent-catalog[index].name + "\n" + root.agent-catalog[index].id,
                root.page-search-query,
            )) {
            return false;
        }
        return true;
    }

    background: transparent;

    // settings_agents_search_sticky: split into a fixed, non-scrolling
    // header (chat-defaults/profile fields + the "Agents" sub-header +
    // agent-search-bar) and a separately-scrolled body (the agent grid +
    // recoverable sessions). Previously this whole view was one long
    // `SettingsSection` mounted inside SettingsPage's single page-level
    // Flickable, so scrolling through the agent grid also scrolled the
    // search bar itself out of view. AgentsView now owns its own bounded
    // Flickable/ThinScrollbar for just the body (settings_page.slint gives
    // this component real bounded height via vertical-stretch: 1 +
    // preferred-height: 0px + min-height: 0px at its call site, same
    // convention as every other elastic Flickable region in this
    // codebase), so the header -- and the search bar inside it -- stays
    // pinned above that scroll region instead of scrolling away with it.
    VerticalLayout {
        width: parent.width;
        height: parent.height;
        spacing: Metrics.space-6;

        SettingsSection {
        width: parent.width;

        SettingsSectionHeader { text: Strings.chat-defaults; }

        if root.profile-wiring-enabled : SettingsField {
            width: parent.width;
            label: Strings.profile;
            default-profile-field := TextField {
                text <=> root.default-profile;
                field-accessible-label: "Default profile";
                field-font-size: 12px;
                changed has-focus => {
                    root.default-profile-focus-mirror = self.has-focus;
                }
            }
        }

        // Global-only (see root.scope's doc comment above) -- this browses/
        // manages the shared ProfileStore registry itself, not the
        // dual-tier default-profile *selection*, which the always-visible
        // TextField above already covers under both scopes.
        if root.scope == "global" : Flickable {
            width: parent.width;
            height: root.available-profiles.length > 0 ? 30px : 0px;
            viewport-width: profile-chip-row.preferred-width;
            profile-chip-row := HorizontalLayout {
                spacing: Metrics.space-3;
                for profile in root.available-profiles : Rectangle {
                    height: 24px;
                    // Width computed purely from the leaf `Text.preferred-width`
                    // below -- never bind a repeated item's own width to a
                    // child layout's `preferred-width` when that child
                    // layout has no explicit width of its own (it would
                    // otherwise size to fill this same Rectangle): that is
                    // a real binding cycle. Slint doesn't error on it, it
                    // silently corrupts this whole window's later
                    // accessible-element geometry (see the original of
                    // this row, `components/settings_sheet.slint`, for the
                    // bisection that found this).
                    width: profile-chip.content-width + Metrics.pad-lg
                        + Metrics.space-1
                        + (root.profile-pending-delete == profile.name ? 114px : 20px);
                    HorizontalLayout {
                        spacing: Metrics.space-1;
                        profile-chip := SelectableChip {
                            label: profile.name
                                + (profile.terminal-enabled ? " T" : "")
                                + (profile.fs-enabled ? " F" : "");
                            selected: profile.name == root.default-profile;
                            button-accessible-label: "Select profile " + profile.name;
                            clicked => { root.default-profile = profile.name; }
                        }
                        if root.profile-pending-delete != profile.name : Button {
                            label: "\u{2715}";
                            button-accessible-label: "Remove profile " + profile.name;
                            btn-width: 20px;
                            btn-height: 24px;
                            font-size: 10px;
                            font-weight: 400;
                            clicked => { root.profile-pending-delete = profile.name; }
                        }
                        if root.profile-pending-delete == profile.name : HorizontalLayout {
                            spacing: Metrics.space-1;
                            Button {
                                label: "Confirm";
                                button-accessible-label: "Confirm delete profile " + profile.name;
                                primary: true;
                                btn-width: 64px;
                                btn-height: 24px;
                                font-size: 9px;
                                font-weight: 400;
                                clicked => {
                                    root.profile-pending-delete = "";
                                    root.profile-delete(profile.name);
                                }
                            }
                            Button {
                                label: "Cancel";
                                button-accessible-label: "Cancel delete profile " + profile.name;
                                btn-width: 48px;
                                btn-height: 24px;
                                font-size: 9px;
                                font-weight: 400;
                                clicked => { root.profile-pending-delete = ""; }
                            }
                        }
                    }
                }
            }
        }

        SettingsDivider { width: parent.width; }

        // Add Profile -- commented out of view for now (kept in source, not
        // deleted, per request while the Agents view is being reworked into
        // a grid layout). Re-enable once the redesign settles on where
        // profile creation belongs in the new layout.
        /*
        Text { text: "Add Profile"; color: Theme.text-primary; font-size: 13px * Theme.font-scale; font-weight: 700; }
        HorizontalLayout {
            spacing: Metrics.space-3;
            Rectangle {
                horizontal-stretch: 1;
                height: 26px;
                background: Theme.bg-sidebar;
                border-width: 1px;
                border-color: Theme.border-default;
                border-radius: Theme.radius-sm;
                TextInput {
                    accessible-label: "New profile name";
                    accessible-action-default => { self.focus(); }
                    text <=> root.new-profile-name;
                    color: Theme.text-primary;
                    font-size: 11px * Theme.font-scale;
                    x: 6px;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                height: 26px;
                background: Theme.bg-sidebar;
                border-width: 1px;
                border-color: Theme.border-default;
                border-radius: Theme.radius-sm;
                TextInput {
                    accessible-label: "New profile agent id";
                    accessible-action-default => { self.focus(); }
                    text <=> root.new-profile-agent-id;
                    color: Theme.text-primary;
                    font-size: 11px * Theme.font-scale;
                    x: 6px;
                    vertical-alignment: center;
                }
            }
            Button {
                label: "T";
                button-accessible-label: "Toggle new profile terminal access";
                btn-width: 28px;
                btn-height: 26px;
                font-size: 10px;
                font-weight: 400;
                bg: root.new-profile-terminal-enabled ? Theme.bg-primary : Theme.bg-sidebar;
                fg: root.new-profile-terminal-enabled ? Theme.text-on-primary : Theme.text-secondary;
                clicked => { root.new-profile-terminal-enabled = !root.new-profile-terminal-enabled; }
            }
            Button {
                label: "F";
                button-accessible-label: "Toggle new profile filesystem access";
                btn-width: 28px;
                btn-height: 26px;
                font-size: 10px;
                font-weight: 400;
                bg: root.new-profile-fs-enabled ? Theme.bg-primary : Theme.bg-sidebar;
                fg: root.new-profile-fs-enabled ? Theme.text-on-primary : Theme.text-secondary;
                clicked => { root.new-profile-fs-enabled = !root.new-profile-fs-enabled; }
            }
            Button {
                label: "Add";
                button-accessible-label: "Add profile";
                primary: true;
                btn-width: 56px;
                btn-height: 26px;
                font-size: 11px;
                font-weight: 400;
                clicked => {
                    if (root.new-profile-name != "") {
                        root.profile-create(
                            root.new-profile-name,
                            root.new-profile-agent-id,
                            root.new-profile-terminal-enabled,
                            root.new-profile-fs-enabled);
                        root.new-profile-name = "";
                        root.new-profile-agent-id = "";
                        root.new-profile-terminal-enabled = false;
                        root.new-profile-fs-enabled = false;
                    }
                }
            }
        }
        */

        if root.profile-wiring-enabled : SettingsField {
            width: parent.width;
            label: Strings.permission-profile;
            permission-profile-field := TextField {
                text <=> root.permission-profile;
                field-accessible-label: "Permission profile";
                field-font-size: 12px;
                changed has-focus => {
                    root.permission-profile-focus-mirror = self.has-focus;
                }
            }
        }

        SettingsDivider { width: parent.width; }

        SettingsSectionHeader { text: Strings.agents; subsection: true; }

        agent-search-bar := SettingsSearchBar {
            width: parent.width;
            placeholder: Strings.search-agents-ellipsis;
            bar-accessible-label: Strings.search-agents;
            query <=> root.agent-search-query;
        }
        }

        // Scrollable body: the agent grid + recoverable sessions. Owns its
        // own bounded Flickable + visible ThinScrollbar (mirrors
        // settings_page.slint's page-level scroll region) so it can scroll
        // independently underneath the fixed header above, keeping
        // agent-search-bar pinned in view.
        agents-body-area := Rectangle {
            vertical-stretch: 1;
            preferred-height: 0px;
            min-height: 0px;

            // settings_scrollbar_discoverability: same "recently scrolled"
            // tracking settings_page.slint's other-sections ThinScrollbar
            // now uses -- without an `active` binding this scrollbar only
            // fades in on a pixel-perfect hover over its own thin hit zone,
            // not while the user is actually wheel/drag-scrolling the
            // agent grid. Flickable has no `pressed` property to mirror the
            // `row2-scroll.pressed` pattern (chat_input_layout.slint /
            // searchable_dropdown.slint use a TouchArea for that), so this
            // flashes on real `viewport-y` movement instead and fades a
            // beat after it stops.
            property <bool> scroll-recently-active: false;
            scroll-idle-timer := Timer {
                interval: 900ms;
                running: false;
                triggered => {
                    scroll-recently-active = false;
                    self.running = false;
                }
            }

            agents-body-scroll := Flickable {
                width: 100%;
                height: 100%;
                viewport-height: agents-body.preferred-height;
                changed viewport-y => {
                    scroll-recently-active = true;
                    scroll-idle-timer.running = false;
                    scroll-idle-timer.running = true;
                }

                agents-body := SettingsSection {
                    width: parent.width;

        // Wrapping grid of `AgentCard` tiles, per the settings-pane-redesign
        // plan's "Agents view is a grid, not a row list" section. Slint's
        // layout primitives have no flex-wrap (confirmed against the
        // "Slint layout defaults" reference), so a real `GridLayout` can't
        // do this (it's compile-time-fixed, no `for`/`if` inside it) --
        // but a manually-built `VerticalLayout` of `HorizontalLayout`s
        // (via `for row-idx in row-count`) is the idiomatic dynamic-grid
        // pattern, and lets the layout engine own the actual x/y
        // placement instead of hand-computed pixel math. An earlier
        // version of this grid used raw `x`/`y` arithmetic (`Math.mod(i,
        // 2) * 270px`, `(i / 2) * 240px`) and shipped a real bug from it:
        // Slint's `/` on two `int`s is float division, not truncating
        // (`1 / 2 == 0.5`, confirmed via a standalone debug grid after
        // "row 0.5" showed up), so row 1 rendered at half a row's height
        // instead of a full one. The layout-engine version below has no
        // such division at all in the positioning path -- only in slicing
        // the catalog into pairs of two, which is far lower-stakes than
        // getting it wrong in a pixel coordinate.
        //
        // CONNECTED-FIRST + SEPARATOR (`changes.yaml` task 3): connected
        // ("installed") agents render first, then a full-width separator
        // line, then the rest. True in-Slint reordering isn't possible --
        // Slint 1.17.1 has no array sort/filter, so the connected-first
        // *grouping* relies on the catalog already arriving connected-first
        // from the backend (`agents/list`) -- the dev preview data is
        // ordered that way to match. The separator is now a `SettingsDivider`
        // inserted as its own row, right before the first row whose
        // *first* (even-index) agent is not connected -- a row-granularity
        // adaptation of the old per-card boundary check (which could land
        // mid-row); if the actual transition falls on an odd index (col 1
        // of an otherwise-connected row), the divider now appears one row
        // later than it strictly would per-card, which reads better than a
        // divider slicing through a row anyway. Making the default agent
        // *physically jump* to the top on toggle (vs. the connected-status
        // grouping here) would need a real reorder primitive Slint doesn't
        // have, and is deferred to a Rust-side ordering pass -- the default
        // card still reads as default via its own tint wherever it sits.
        //
        // SEARCH FILTER: rows/cards that fail `agent-matches` are omitted
        // via `if` (not merely zero-height), so a filtered grid collapses
        // cleanly instead of leaving empty slots. The installed/uninstalled
        // divider is suppressed while a query is active -- partial rows
        // make the status boundary ambiguous.
        //
        VerticalLayout {
            width: parent.width;
            spacing: Metrics.space-6;

            property <int> agent-count: root.agent-catalog.length;
            // Two cards need 532px including their grid gap. Below that,
            // use one fluid-width card per row so the tile never overflows
            // a narrow settings pane.
            property <int> cards-per-row: root.width >= 532px ? 2 : 1;
            // Ceiling division for the active column count -- exact by
            // construction, since Slint's `/` does not truncate ints.
            property <int> row-count:
                ((agent-count + cards-per-row - 1)
                    - Math.mod(agent-count + cards-per-row - 1, cards-per-row))
                    / cards-per-row;

            for row-idx in row-count : VerticalLayout {
                spacing: Metrics.space-6;
                property <int> first-agent-index: row-idx * cards-per-row;
                property <bool> first-visible: root.agent-matches(first-agent-index);
                property <bool> second-visible:
                    cards-per-row == 2
                    && first-agent-index + 1 < root.agent-catalog.length
                    && root.agent-matches(first-agent-index + 1);
                property <bool> row-visible: first-visible || second-visible;

                if row-visible
                    && root.agent-search-query == ""
                    && root.agent-catalog[first-agent-index].status != "installed"
                    && (first-agent-index == 0 || root.agent-catalog[first-agent-index - 1].status == "installed")
                    : SettingsDivider { width: parent.width; }

                if row-visible : HorizontalLayout {
                    spacing: Metrics.space-6;
                    alignment: start;

                    if first-visible : AgentCard {
                        scope: root.scope;
                        agent-id: root.agent-catalog[first-agent-index].id;
                        agent-name: root.agent-catalog[first-agent-index].name != ""
                            ? root.agent-catalog[first-agent-index].name : root.agent-catalog[first-agent-index].id;
                        status: root.agent-catalog[first-agent-index].status;
                        card-width: cards-per-row == 1 ? root.width : 260px;
                        is-default: root.agent-catalog[first-agent-index].id == root.default-agent-id;
                        enabled: root.agent-catalog[first-agent-index].enabled;
                        loading: root.agent-catalog[first-agent-index].loading;
                        set-default(new-default) => {
                            root.default-agent-id = new-default ? root.agent-catalog[first-agent-index].id : "";
                        }
                        install-requested => { root.agent-install-requested(root.agent-catalog[first-agent-index].id); }
                        connect-requested => { root.agent-connect-requested(root.agent-catalog[first-agent-index].id); }
                        disconnect-requested => { root.agent-disconnect-requested(root.agent-catalog[first-agent-index].id); }
                        set-enabled(new-enabled) => { root.agent-set-enabled(root.agent-catalog[first-agent-index].id, new-enabled); }
                    }

                    if second-visible : AgentCard {
                        scope: root.scope;
                        agent-id: root.agent-catalog[first-agent-index + 1].id;
                        agent-name: root.agent-catalog[first-agent-index + 1].name != ""
                            ? root.agent-catalog[first-agent-index + 1].name : root.agent-catalog[first-agent-index + 1].id;
                        status: root.agent-catalog[first-agent-index + 1].status;
                        card-width: 260px;
                        is-default: root.agent-catalog[first-agent-index + 1].id == root.default-agent-id;
                        enabled: root.agent-catalog[first-agent-index + 1].enabled;
                        loading: root.agent-catalog[first-agent-index + 1].loading;
                        set-default(new-default) => {
                            root.default-agent-id = new-default ? root.agent-catalog[first-agent-index + 1].id : "";
                        }
                        install-requested => { root.agent-install-requested(root.agent-catalog[first-agent-index + 1].id); }
                        connect-requested => { root.agent-connect-requested(root.agent-catalog[first-agent-index + 1].id); }
                        disconnect-requested => { root.agent-disconnect-requested(root.agent-catalog[first-agent-index + 1].id); }
                        set-enabled(new-enabled) => { root.agent-set-enabled(root.agent-catalog[first-agent-index + 1].id, new-enabled); }
                    }
                }
            }
        }

        SettingsDivider { width: parent.width; }

        // Recovery/import section (Coverage Matrix `session/list` row):
        // real remote gateway sessions not currently bound to any local
        // thread row, for the active thread's own provider. Ported from
        // the dead components/settings_sheet.slint -- the
        // recoverable-sessions property and recover-session-attach
        // callback were already fully plumbed through this view (and
        // down into lib.rs/dispatch.rs) but never actually rendered here
        // after the settings-pane-redesign migration, so this whole
        // feature was silently unreachable from the live UI despite
        // looking fully wired at the Msg/Effect level (found via a real
        // e2e test's "Attach recovered session" assertion never matching
        // anything). Attaching binds via `session/load`, never
        // `session/new` (`AgentBridge::add_thread_recovering_session`).
        SettingsSectionHeader { text: Strings.recoverable-sessions; subsection: true; }
        if root.recoverable-sessions.length == 0 : Text {
            text: Strings.no-orphaned-sessions;
            color: Theme.text-muted;
            font-size: 10px * Theme.font-scale;
        }
        for session in root.recoverable-sessions : SettingsRow {
            label: (session.title != "" ? session.title : session.session-id) + " (" + session.provider + ")";
            row-height: 26px;
            Button {
                label: Strings.attach;
                button-accessible-label: Strings.attach + " recovered session " + session.session-id;
                btn-width: 52px;
                btn-height: 20px;
                font-size: 9px;
                font-weight: 400;
                bg: Theme.bg-card;
                fg: Theme.text-secondary;
                clicked => { root.recover-session-attach(session.session-id, session.provider, session.title); }
            }
        }
                }
            }

            ThinScrollbar {
                x: parent.width - self.width - 2px;
                y: 4px;
                visible-height: parent.height - 8px;
                viewport-height: agents-body.preferred-height;
                viewport-y <=> agents-body-scroll.viewport-y;
                thumb-width: 4px;
                active: scroll-recently-active;
            }
        }
    }
}
