import { Theme } from "../../../tokens/theme.slint";
import { Metrics } from "../../../tokens/metrics.slint";
import { Button } from "../../../base/buttons/button.slint";
import { Toggle } from "../../../base/form/toggle.slint";
import { SettingsSearchBar } from "../components/search_bar.slint";
import { TextUtil } from "../../../base/text/text_util.slint";
import { SettingsRow } from "../../../base/layout/settings_row.slint";
import { SettingsSection, SettingsSectionHeader, SettingsRowGroup } from "../../../base/layout/settings_section.slint";
import { SkillOption } from "../../../types.slint";
import { Text } from "../../../base/text/base_text.slint";

// Skills settings left-tab view -- `skills_management_settings` phase.
// Same layout convention as `mcp_servers_view.slint`: a `SettingsRow`
// per entry, a page-level toggle, and one promotion action. Global
// skills always list; project-local ones additionally show their
// `started_from` provenance and a "Make Global" action
// (`skills-management`'s "make global button", "show project_start
// skills include global started_from").
export component SkillsView inherits Rectangle {
    // settings_scope_visibility_gate: "project" | "global", mirrored from
    // SettingsPage.scope. Only `dev-mode` below is gated by it -- it's
    // deliberately Global-tier only (see
    // `settings_file::SettingsDocument::dev_mode`'s doc comment,
    // bypassing the generic Project-overrides-Global merge entirely), so
    // editing it under Project today silently wrote/read the same single
    // global value with no project-scoped effect. The skill list itself
    // is unrelated to this gate and stays as-is.
    in property <string> scope: "project";
    in property <[SkillOption]> skills: [];
    in-out property <string> page-search-query: "";
    out property <bool> search-has-focus: skill-search-bar.input-has-focus;
    // Page-level toggle: hide the global-scope rows so a long list of
    // shared global skills doesn't drown out a project's own few local
    // ones (`skills-management`'s "a toggle to show Global Skills or
    // not"). Genuinely dual-tier (settings-scoping bug report fix): was
    // previously component-local Slint state only -- no round trip at
    // all, in either scope -- which is why toggling it looked identical
    // regardless of the Project/Global scope tab. Now forwarded
    // two-way (`<=>`) from `SettingsPage`/`app.slint` down to here, and
    // persisted per-scope exactly like `background-default`, via
    // `settings_file::SettingsDocument::show_global_skills`.
    in-out property <bool> show-global-skills: true;
    callback skill-promote-to-global(string /* path */);
    // `dev-mode` task's "Dev mode option for the system" -- Global-tier
    // only (see `settings_file::SettingsDocument::dev_mode`'s doc
    // comment). Enabling it copies in one bundled placeholder global
    // skill (`skills_state::ensure_bundled_global_skill`), idempotently.
    in property <bool> dev-mode: false;
    callback dev-mode-toggled(bool);

    background: transparent;
    vertical-stretch: 0;
    preferred-height: content.preferred-height;

    content := SettingsSection {
        width: parent.width;

        SettingsSectionHeader { text: "Config"; }

        skill-search-bar := SettingsSearchBar {
            width: parent.width;
            placeholder: "Search skills...";
            bar-accessible-label: "Search skills";
            query <=> root.page-search-query;
        }

        SettingsRow {
            label: "Show global skills";
            Toggle {
                checked: root.show-global-skills;
                toggle-accessible-label: "Toggle global skills visibility";
                toggled(new-checked) => { root.show-global-skills = new-checked; }
            }
        }

        if root.scope == "global" : SettingsRow {
            label: "Dev mode";
            Toggle {
                checked: root.dev-mode;
                toggle-accessible-label: "Toggle dev mode";
                toggled(new-checked) => { root.dev-mode-toggled(new-checked); }
            }
        }

        SettingsRowGroup {
            width: parent.width;

            for skill in root.skills : SettingsRow {
                // `dev-mode` filter (dev-mode-off-resync fix): a
                // dev-mode-only skill (the bundled placeholder
                // `ensure_bundled_global_skill` installs) stays on disk
                // after dev-mode is turned off, but must drop out of the
                // visible list immediately -- this binding re-evaluates
                // on every `root.dev-mode` change same as the existing
                // `show-global-skills` gate below, so toggling dev-mode
                // reactively re-filters without needing a reload.
                property <bool> row-visible: (skill.scope != "global" || root.show-global-skills) && (!skill.is-dev-only || root.dev-mode);
                property <bool> matches-search: TextUtil.matches-filter(
                    skill.name + "\n" + skill.description + "\n" + skill.scope,
                    root.page-search-query,
                );
                width: parent.width;
                // No conditional-instantiation of a `for` template item in
                // Slint (`if` can't follow `:` after a `for` binding) --
                // collapse to zero height + invisible instead of a nested
                // `if`, same effect as not rendering the row at all.
                height: row-visible && matches-search
                    ? self.row-height + (self.hint == "" ? 0px : 12px) : 0px;
                visible: row-visible && matches-search;
                clip: true;
                label: skill.name;
                label-font-family: Theme.font-mono;
                hint: skill.description;

                // Provenance -- only meaningful for a project-local skill
                // instantiated from a global one.
                if skill.scope == "project" && skill.started-from != "" : Text {
                    text: "from " + skill.started-from;
                    color: Theme.text-muted;
                    size: "xs";
                    max-width: 120px;
                    overflow: elide;
                }

                Text {
                    text: skill.scope;
                    color: Theme.text-muted;
                    size: "xs";
                    font-family: Theme.font-mono;
                }

                // Promote a project-local skill to global -- moves its
                // directory into the global skills folder. Global skills
                // have no promotion target of their own.
                if skill.scope == "project" : Button {
                    label: "Make Global";
                    button-accessible-label: "Make skill " + skill.name + " global";
                    btn-width: self.content-width;
                    btn-height: 22px;
                    font-size: 9px;
                    font-weight: 400;
                    clicked => { root.skill-promote-to-global(skill.path); }
                }
            }
        }
    }
}
