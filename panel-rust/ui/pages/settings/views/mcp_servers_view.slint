import { Theme } from "../../../tokens/theme.slint";
import { Metrics } from "../../../tokens/metrics.slint";
import { CursorHost } from "../../../tokens/cursor_host.slint";
import { Button } from "../../../base/button.slint";
import { Toggle } from "../../../base/toggle.slint";
import { TextField } from "../../../base/text_field.slint";
import { SettingsRow } from "../../../base/settings_row.slint";
import { SettingsSection, SettingsSectionHeader, SettingsRowGroup } from "../../../base/settings_section.slint";
import { McpServerOption, McpToolOption, McpServerFormData } from "../../../types.slint";
import { TextUtil } from "../../../base/text_util.slint";
import { StatusDot } from "../../../base/status_dot.slint";

// Multi-line text box for the env-var/header editors below (`KEY=VALUE`/
// `Header: value` one per line, parsed Rust-side -- see
// `McpServerOption`'s doc comment in types.slint for why this is a plain
// multi-line text convention rather than a dynamic per-row add/remove
// list: this Slint version has no array push/slice/concat available in
// `.slint` code). Not exported -- local to this file only. Same visual
// shape as `TextField` (can't just override its fixed 26px `height`/
// single-line `TextInput`, so this is a small hand-rolled sibling rather
// than a `TextField` variant), `single-line: false` + `wrap: word-wrap`
// is the same multi-line idiom `chat_input_layout.slint`'s compose box
// already uses.
component MultilineField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> field-accessible-label: "";
    out property <bool> has-focus: input.has-focus;

    height: 64px;
    background: Theme.bg-sidebar;
    border-width: 1px;
    border-color: Theme.border-default;
    border-radius: Theme.radius-sm;
    clip: true;

    input := TextInput {
        accessible-label: root.field-accessible-label;
        color: Theme.text-primary;
        font-family: Theme.font-mono;
        font-size: 10px * Theme.font-scale;
        x: Metrics.pad-md;
        y: Metrics.pad-xs;
        width: parent.width - 2 * Metrics.pad-md;
        height: parent.height - 2 * Metrics.pad-xs;
        single-line: false;
        wrap: word-wrap;
        changed has-focus => { CursorHost.kind = self.has-focus ? "text" : "default"; }
    }
}

// MCP Servers left-tab view. Rebuilt (MCP-servers-settings-data-
// persistence-oauth plan) into a Zed-style structured form: a Stdio/HTTP
// transport picker plus the fields each transport actually needs
// (args/env/timeout for stdio; headers/timeout/oauth-client-id for
// http), replacing the earlier "shell phase" 2-field name+command-or-url
// form that silently dropped everything else. List rows keep the
// existing `SettingsRow` shape but gain a real per-row "Edit" action
// (there was previously no edit path at all, only create/delete) and a
// "Disconnect" action for an OAuth-authenticated server, alongside the
// existing "Connect"/enable-toggle/Remove/Tools controls.
//
// Backend reality: `acpx_client::mcp::McpServerEntry` (re-exported as
// `crate::protocol_types::McpServerEntry`) is now a fully typed round
// trip through `mcp_servers/{create,update,delete,list}`, and
// `mcp_servers/authenticate`/`mcp_servers/logout` are real RPCs backing
// a genuine MCP OAuth 2.1 flow (`acpx_core::router::Router::
// authenticate_mcp_server`) -- Connect opens a real browser authorization
// page via `opener`, not a client-side JSON patch. Per-tool toggles still
// persist into the entry's opaque `tools` JSON array (MCP has no static
// per-tool config in its own schema -- tools are a runtime-discovered
// capability of a connected server) and live connection health/tool
// discovery remain out of band (acpx has no `tools/list` round trip or
// per-connection health probe yet).
export component McpServersView inherits Rectangle {
    in property <[McpServerOption]> servers: [];
    // Rust-computed sum of every server's real reconciled tool list --
    // shown next to the section header. See `sync.rs`'s own comment.
    in property <int> total-tools-count: 0;
    // settings_page_search_filter: page-level query filters this list.
    in property <string> page-search-query: "";
    callback mcp-server-submit(McpServerFormData);
    callback mcp-server-delete(string);
    callback mcp-server-enabled-changed(string, bool);
    callback mcp-server-authenticate(string);
    callback mcp-server-logout(string);
    callback mcp-server-tool-enabled-changed(string, string, bool);
    callback mcp-server-tool-deferred-changed(string, string, bool);
    callback mcp-server-tools-fetch-requested(string);
    // See FilterSearchBar.input-has-focus's doc comment / TextField.has-focus's
    // own doc comment: this view's form fields never had any focus state
    // aggregated up into settings_page.slint's OR-chain, so every
    // keystroke typed into any of them was silently dropped.
    //
    // The stdio-only/http-only fields live inside a conditional (`if
    // root.form-transport == ...`) branch, so their element ids aren't
    // reachable from this outer binding (a Slint element declared inside
    // an `if` only exists -- and is only nameable -- within that block).
    // `stdio-fields-focused`/`http-fields-focused` are the two branches'
    // own local aggregates, kept updated by each field's own `changed
    // has-focus` handler below, and folded in here instead.
    out property <bool> search-has-focus:
        name-field.has-focus
        || timeout-field.has-focus
        || root.stdio-fields-focused
        || root.http-fields-focused;

    property <bool> stdio-fields-focused: false;
    property <bool> http-fields-focused: false;

    property <string> form-name: "";
    // "stdio" | "http".
    property <string> form-transport: "stdio";
    property <string> form-command: "";
    property <string> form-args: "";
    property <string> form-env: "";
    property <string> form-url: "";
    property <string> form-headers: "";
    property <string> form-timeout: "";
    property <string> form-oauth-client-id: "";
    // "" means "add new server"; non-empty means "editing this existing
    // server" (the Add button becomes Save, and submission sets
    // `McpServerFormData.is-edit`).
    property <string> editing-name: "";

    function reset-form() {
        root.form-name = "";
        root.form-transport = "stdio";
        root.form-command = "";
        root.form-args = "";
        root.form-env = "";
        root.form-url = "";
        root.form-headers = "";
        root.form-timeout = "";
        root.form-oauth-client-id = "";
        root.editing-name = "";
    }

    background: transparent;

    SettingsSection {
        width: parent.width;

        SettingsSectionHeader {
            text: root.total-tools-count > 0
                ? "MCP Servers · " + root.total-tools-count + " tools discovered"
                : "MCP Servers";
        }

        SettingsRowGroup {
            width: parent.width;

            for server in root.servers : server-block := VerticalLayout {
                width: parent.width;
                // Hide non-matching servers when page search is active.
                // Matches across every real field a server carries now
                // (not just name/command/url) -- e.g. finding a server by
                // an env var name, a header, its OAuth client id, or one
                // of its real discovered tool names/descriptions
                // (`tools-search-blob`, Rust-computed since Slint has no
                // array-reduce to join `server.tools` itself here).
                visible: root.page-search-query == ""
                    || TextUtil.matches-filter(
                        server.name + "\n" + server.command + "\n" + server.url + "\n"
                            + server.args + "\n" + server.env + "\n" + server.headers + "\n"
                            + server.oauth-client-id + "\n" + server.tools-search-blob,
                        root.page-search-query,
                    );
                // `pad-xs` (4px) -- the compact pre-reveal gap between a
                // server's header row and its (conditionally shown)
                // expanded tool panel.
                spacing: Metrics.pad-xs;

                // Per-instance expand state for this server's tool list -- UI-only
                // and local (Slint has no round-trip need here: nothing persists
                // it, unlike the chat-view's Rust-side `expanded` vec).
                property <bool> tools-expanded: false;

                // Pre-formatted in Rust (`McpServerOption.status-line`).
                property <string> status-line: server.status-line;

                SettingsRow {
                    width: parent.width;
                    label: server.name;
                    label-font-family: Theme.font-mono;
                    hint: server.transport == "http" ? server.url : server.command;
                    hint-font-family: Theme.font-mono;

                    // Live connection dot -- green connected, red error/
                    // disconnected, yellow otherwise (auth required...).
                    // Explicit user direction; supersedes the earlier
                    // no-status-color convention for MCP surfaces.
                    if server.status != "" : StatusDot {
                        status: server.status;
                        size: 8px;
                    }
                    // Transport + auth + connection status, combined into one
                    // muted subtitle (dot above carries the color).
                    if server-block.status-line != "" : Text {
                        text: server-block.status-line;
                        color: Theme.text-muted;
                        font-size: 9px * Theme.font-scale;
                        vertical-alignment: center;
                        max-width: 120px;
                        overflow: elide;
                    }

                    // Edit -- pre-fills the form below with this server's
                    // full current config (only for user-added rows; the
                    // built-in snapshotd row is not editable).
                    if server.removable : Button {
                        label: "Edit";
                        button-accessible-label: "Edit MCP server " + server.name;
                        btn-width: 48px;
                        btn-height: 24px;
                        font-size: 9px;
                        font-weight: 400;
                        clicked => {
                            root.form-name = server.name;
                            root.form-transport = server.transport == "http" ? "http" : "stdio";
                            root.form-command = server.command;
                            root.form-args = server.args;
                            root.form-env = server.env;
                            root.form-url = server.url;
                            root.form-headers = server.headers;
                            root.form-timeout = server.timeout;
                            root.form-oauth-client-id = server.oauth-client-id;
                            root.editing-name = server.name;
                        }
                    }

                    // OAuth "Connect" -- opens a real authorization URL in
                    // the user's browser (mcp_servers/authenticate).
                    if server.transport == "http" && server.needs-auth : Button {
                        label: "Connect";
                        button-accessible-label: "Connect (authenticate) MCP server " + server.name;
                        btn-width: 56px;
                        btn-height: 24px;
                        font-size: 9px;
                        font-weight: 400;
                        clicked => { root.mcp-server-authenticate(server.name); }
                    }

                    // Forget this server's OAuth token (mcp_servers/logout
                    // RPC/callback name kept as-is -- only the user-facing
                    // label changed to "Disconnect").
                    if server.auth-status == "authenticated" : Button {
                        label: "Disconnect";
                        button-accessible-label: "Disconnect MCP server " + server.name;
                        btn-width: 56px;
                        btn-height: 24px;
                        font-size: 9px;
                        font-weight: 400;
                        clicked => { root.mcp-server-logout(server.name); }
                    }

                    // Expand/collapse the per-tool list (when tools are present).
                    if server.tools.length > 0 : Button {
                        label: (server-block.tools-expanded ? "Hide tools" : "Tools")
                            + " (" + server.tools.length + ")";
                        button-accessible-label: (server-block.tools-expanded ? "Hide" : "Show")
                            + " " + server.tools.length + " tools for MCP server " + server.name;
                        btn-width: 88px;
                        btn-height: 24px;
                        font-size: 9px;
                        font-weight: 400;
                        clicked => { server-block.tools-expanded = !server-block.tools-expanded; }
                    }

                    // Kicks off a real MCP `tools/list` probe
                    // (`mcp_servers/tools_fetch`) -- "Fetch tools" before
                    // the first attempt, "Refresh tools" once a catalog
                    // (or a failed attempt) exists, "Fetching..." while
                    // the background probe is in flight.
                    Button {
                        label: server.tool-fetch-status == "fetching"
                            ? "Fetching..."
                            : (server.tool-fetch-status == "" ? "Fetch tools" : "Refresh tools");
                        button-accessible-label: "Fetch real tools list for MCP server " + server.name;
                        btn-width: 88px;
                        btn-height: 24px;
                        font-size: 9px;
                        font-weight: 400;
                        // No `enabled`/disabled state on `Button` -- a
                        // click while already fetching is a safe no-op
                        // server-side (`Router::spawn_mcp_tools_fetch`
                        // skips spawning a duplicate probe when one is
                        // already in flight for this server).
                        clicked => { root.mcp-server-tools-fetch-requested(server.name); }
                    }

                    // Enable/disable without removing the entry -- registry-
                    // backed and immediately re-listed by the Rust host after
                    // update.
                    Toggle {
                        checked: server.enabled;
                        toggle-accessible-label: "Toggle MCP server " + server.name;
                        toggled(enabled) => { root.mcp-server-enabled-changed(server.name, enabled); }
                    }

                    if server.removable : Button {
                        label: "Remove";
                        button-accessible-label: "Remove MCP server " + server.name;
                        btn-width: 56px;
                        btn-height: 24px;
                        font-size: 9px;
                        font-weight: 400;
                        clicked => {
                            if (root.editing-name == server.name) {
                                root.reset-form();
                            }
                            root.mcp-server-delete(server.name);
                        }
                    }
                }

                // Nested per-tool list -- **view-only**. Real names/
                // descriptions from the actual `tools/list` fetch, no
                // enable/disable or deferred controls: checked against
                // the real ACP schema (`agent-client-protocol-schema`
                // 1.4.0) and the MCP spec, neither gives a client any way
                // to actually make a "disabled" tool disappear from what
                // a session's backend agent sees, so an interactive
                // toggle here would silently do nothing -- see
                // `McpToolOption.enabled`'s doc comment in types.slint
                // for the full investigation. Height-capped with its own
                // `Flickable` (not just relying on the page's outer
                // scroll) so one server with many tools can't push every
                // server below it off-screen.
                if server-block.tools-expanded && server.tools.length > 0 : Rectangle {
                    width: parent.width;
                    height: min(tools-list-content.preferred-height + 2 * Metrics.pad-md, 220px);
                    background: Theme.bg-sidebar;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.border-default;
                    clip: true;

                    Flickable {
                        width: parent.width;
                        height: parent.height;
                        viewport-height: tools-list-content.preferred-height + 2 * Metrics.pad-md;

                        tools-list-content := VerticalLayout {
                            width: parent.width;
                            padding: Metrics.pad-md;
                            padding-left: Metrics.pad-lg;
                            spacing: Metrics.gap-sm;

                            for tool in server.tools : VerticalLayout {
                                spacing: 2px;

                                HorizontalLayout {
                                    spacing: Metrics.gap-md;

                                    Text {
                                        text: tool.name;
                                        color: Theme.text-primary;
                                        font-family: Theme.font-mono;
                                        font-size: 10px * Theme.font-scale;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }

                                    if tool.token-usage > 0 : Text {
                                        text: tool.token-usage + " tok";
                                        color: Theme.text-muted;
                                        font-family: Theme.font-mono;
                                        font-size: 9px * Theme.font-scale;
                                        vertical-alignment: center;
                                        horizontal-stretch: 0;
                                    }
                                }

                                if tool.description != "" : Text {
                                    text: tool.description;
                                    color: Theme.text-muted;
                                    font-size: 9px * Theme.font-scale;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }

                // Real error text from a failed background fetch (see
                // `McpServerOption.tool-fetch-error`'s doc comment) --
                // surfaced inline rather than only through the shared
                // settings-page toast, since the toast is transient and
                // this failure state persists until the next fetch.
                if server.tool-fetch-status == "error" : Text {
                    text: "Failed to fetch tools: " + server.tool-fetch-error;
                    // Same error red `app.slint`'s shared toast border
                    // uses for `toast-kind == "error"` -- no dedicated
                    // `Theme.text-danger` token exists yet.
                    color: #ef4444;
                    font-size: 9px * Theme.font-scale;
                    wrap: word-wrap;
                }
            }
        }

        VerticalLayout {
            spacing: Metrics.gap-sm;
            padding-top: Metrics.pad-sm;

            if root.editing-name != "" : Text {
                text: "Editing \"" + root.editing-name + "\"";
                color: Theme.text-muted;
                font-size: 9px * Theme.font-scale;
            }

            HorizontalLayout {
                spacing: Metrics.gap-sm;
                name-field := TextField {
                    horizontal-stretch: 1;
                    text <=> root.form-name;
                    field-accessible-label: "MCP server name";
                }
                Button {
                    label: "Stdio";
                    button-accessible-label: "Stdio transport";
                    primary: root.form-transport == "stdio";
                    btn-width: 52px;
                    btn-height: 26px;
                    font-size: 9px;
                    font-weight: 400;
                    clicked => { root.form-transport = "stdio"; }
                }
                Button {
                    label: "HTTP";
                    button-accessible-label: "HTTP transport";
                    primary: root.form-transport == "http";
                    btn-width: 52px;
                    btn-height: 26px;
                    font-size: 9px;
                    font-weight: 400;
                    clicked => { root.form-transport = "http"; }
                }
            }

            if root.form-transport == "stdio" : VerticalLayout {
                spacing: Metrics.gap-sm;
                command-field := TextField {
                    text <=> root.form-command;
                    field-accessible-label: "Command";
                    changed has-focus => {
                        root.stdio-fields-focused = self.has-focus
                            || args-field.has-focus || env-field.has-focus;
                    }
                }
                args-field := TextField {
                    text <=> root.form-args;
                    field-accessible-label: "Arguments, space-separated";
                    changed has-focus => {
                        root.stdio-fields-focused = self.has-focus
                            || command-field.has-focus || env-field.has-focus;
                    }
                }
                Text {
                    text: "Environment variables (KEY=VALUE per line)";
                    color: Theme.text-muted;
                    font-size: 9px * Theme.font-scale;
                }
                env-field := MultilineField {
                    text <=> root.form-env;
                    field-accessible-label: "Environment variables, one KEY=VALUE per line";
                    changed has-focus => {
                        root.stdio-fields-focused = self.has-focus
                            || command-field.has-focus || args-field.has-focus;
                    }
                }
            }

            if root.form-transport == "http" : VerticalLayout {
                spacing: Metrics.gap-sm;
                url-field := TextField {
                    text <=> root.form-url;
                    field-accessible-label: "URL";
                    changed has-focus => {
                        root.http-fields-focused = self.has-focus
                            || headers-field.has-focus || oauth-field.has-focus;
                    }
                }
                Text {
                    text: "Headers (Header-Name: value per line)";
                    color: Theme.text-muted;
                    font-size: 9px * Theme.font-scale;
                }
                headers-field := MultilineField {
                    text <=> root.form-headers;
                    field-accessible-label: "Headers, one Header-Name: value per line";
                    changed has-focus => {
                        root.http-fields-focused = self.has-focus
                            || url-field.has-focus || oauth-field.has-focus;
                    }
                }
                oauth-field := TextField {
                    text <=> root.form-oauth-client-id;
                    field-accessible-label: "OAuth client id (optional -- leave blank to use dynamic client registration)";
                    changed has-focus => {
                        root.http-fields-focused = self.has-focus
                            || url-field.has-focus || headers-field.has-focus;
                    }
                }
            }

            HorizontalLayout {
                spacing: Metrics.gap-sm;
                timeout-field := TextField {
                    horizontal-stretch: 1;
                    text <=> root.form-timeout;
                    field-accessible-label: "Timeout in seconds (optional)";
                }
                Button {
                    label: root.editing-name == "" ? "Add" : "Save";
                    button-accessible-label: root.editing-name == "" ? "Add MCP server" : "Save MCP server";
                    primary: true;
                    btn-width: 56px;
                    btn-height: 26px;
                    font-size: 11px;
                    font-weight: 400;
                    clicked => {
                        if (root.form-name != "") {
                            root.mcp-server-submit({
                                name: root.form-name,
                                transport: root.form-transport,
                                command: root.form-command,
                                args: root.form-args,
                                env: root.form-env,
                                url: root.form-url,
                                headers: root.form-headers,
                                timeout: root.form-timeout,
                                oauth-client-id: root.form-oauth-client-id,
                                is-edit: root.editing-name != "",
                            });
                            root.reset-form();
                        }
                    }
                }
                if root.editing-name != "" : Button {
                    label: "Cancel";
                    button-accessible-label: "Cancel editing MCP server";
                    btn-width: 56px;
                    btn-height: 26px;
                    font-size: 11px;
                    font-weight: 400;
                    clicked => { root.reset-form(); }
                }
            }
        }
    }
}
