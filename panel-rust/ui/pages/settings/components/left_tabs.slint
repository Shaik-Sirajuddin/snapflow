import { Theme } from "../../../tokens/theme.slint";
import { Strings } from "../../../tokens/strings.slint";
import { Metrics } from "../../../tokens/metrics.slint";
import { NavItem } from "../../../base/nav_item.slint";

// Settings page chrome -- the left-side section rail from the
// settings-pane-redesign plan's "Component layout" section: `MCP Servers`
// / `Agents` / `Harness`, same set for both Project and Global scope (the
// plan notes Project mirrors Global's section list). Controlled by
// `SettingsPage` via `active-section`/`section-selected`, same "dumb
// strip" pattern as `SettingsTopTabs`.
//
// settings_scope_visibility_gate: `MCP Servers` is the one section that is
// *entirely* global-only (the whole McpServerStore registry has no
// per-project dimension at all -- see settings_page.slint's own doc
// comment), so its nav item is conditionally instantiated on `scope`
// instead of just hiding its content pane -- a visible-but-empty "MCP
// Servers" tab under Project would be more confusing than not offering
// the tab at all. Agents/Harness/Skills stay unconditional: each mixes at
// least one genuinely dual-tier field (default profile, permission
// profile, default agent id, background-session-default) with global-only
// pieces, so those three views gate their own global-only rows
// internally instead (see agents_view.slint / skills_view.slint).
export component SettingsLeftTabs inherits Rectangle {
    in property <string> active-section: "mcp_servers"; // "mcp_servers" | "agents" | "harness" | "skills"
    in property <bool> expanded: true;
    in property <string> scope: "project"; // "project" | "global"
    // Env-var feature-flag gate (BETA_MODE, see lib.rs's
    // beta_mode_enabled()) -- the Harness nav item below is hidden
    // entirely, in both scopes, until this is turned on, same
    // conditional-nav-item precedent as MCP Servers' scope gate above.
    in property <bool> beta-mode-enabled: false;
    // Installed app version (e.g. "0.1.0"), read from Cargo.toml's
    // `package.version` via `env!("CARGO_PKG_VERSION")` and set once at
    // startup (lib.rs, right after the panel/window is constructed) -- it
    // never changes at runtime, so this is a plain one-shot property, not
    // part of the reactive Model/sync.rs push loop. Empty string (the
    // default) renders nothing, so a standalone/preview render of this
    // component with no wiring doesn't show a misleading blank "v".
    in property <string> app-version: "";
    callback section-selected(string);
    callback collapse-requested();

    width: root.expanded ? 128px : 48px;
    animate width { duration: 180ms; easing: ease-in-out; }
    background: Theme.bg-sidebar;

    VerticalLayout {
        spacing: Metrics.space-2;

        if root.scope == "global" : NavItem {
            height: 34px;
            label: Strings.mcp-servers;
            button-accessible-label: Strings.mcp-servers-section;
            active: root.active-section == "mcp_servers";
            show-icon: true;
            show-label: root.expanded;
            centered: !root.expanded;
            icon-source: @image-url("../../../assets/icons/plug-zap.svg");
            // Keep the icon's box stable while the label appears/disappears;
            // changing it between states makes the tab contents jump by a px.
            icon-size: 14px;
            clicked => { root.section-selected("mcp_servers"); }
            double-clicked => { root.collapse-requested(); }
        }
        NavItem {
            height: 34px;
            label: Strings.agents;
            button-accessible-label: Strings.agents-section;
            active: root.active-section == "agents";
            show-icon: true;
            show-label: root.expanded;
            centered: !root.expanded;
            icon-source: @image-url("../../../assets/icons/sparkles.svg");
            icon-size: 14px;
            clicked => { root.section-selected("agents"); }
            double-clicked => { root.collapse-requested(); }
        }
        if root.beta-mode-enabled : NavItem {
            height: 34px;
            label: Strings.harness;
            button-accessible-label: Strings.harness-section;
            active: root.active-section == "harness";
            show-icon: true;
            show-label: root.expanded;
            centered: !root.expanded;
            icon-source: @image-url("../../../assets/icons/terminal.svg");
            icon-size: 14px;
            clicked => { root.section-selected("harness"); }
            double-clicked => { root.collapse-requested(); }
        }
        NavItem {
            height: 34px;
            label: Strings.skills;
            button-accessible-label: Strings.skills-section;
            active: root.active-section == "skills";
            show-icon: true;
            show-label: root.expanded;
            centered: !root.expanded;
            icon-source: @image-url("../../../assets/icons/book-open.svg");
            icon-size: 14px;
            clicked => { root.section-selected("skills"); }
            double-clicked => { root.collapse-requested(); }
        }

        // Version footer -- lowest-friction home for the installed app
        // version (no existing About/general settings section to attach
        // it to, and this whole rail already fills the section's full
        // available height with nothing below the nav items, so a spacer
        // + one small meta-text row pushes it to the bottom without
        // disturbing the nav items' own top-packed layout above). Hidden
        // while collapsed (48px is too narrow for "v0.1.0" plus the
        // icon-only rail's centered nav items) and while empty (so a
        // standalone/preview render with no `app-version` wiring stays
        // silent instead of showing a bare "v").
        if root.expanded && root.app-version != "" : Rectangle { vertical-stretch: 1; }
        if root.expanded && root.app-version != "" : Text {
            text: "v" + root.app-version;
            color: Theme.text-muted;
            font-size: 9px * Theme.font-scale;
            horizontal-alignment: center;
            height: 20px;
        }
    }
}
